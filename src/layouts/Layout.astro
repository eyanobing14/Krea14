---
import '../styles/global.css';
import LiquidCursor from '../components/LiquidCursor.astro';
import GSAPSetup from '../components/GSAPSetup.astro';

interface Props {
  title?: string;
  description?: string;
}

const BASE_URL = Astro.url.origin;
const canonicalURL = `${BASE_URL}${Astro.url.pathname}`.replace(/\?.$/, '');

const {
  title = 'ExauEyano — Graphic Designer · UI/UX · Fullstack Dev',
  description = 'Designer graphique, UI/UX et développeur fullstack basé au Burundi. Nous créons des expériences numériques qui marquent.'
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#000000" />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="ExauEyano" />
    <meta property="og:image" content={`${BASE_URL}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:locale:alternate" content="en_US" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${BASE_URL}/og-image.png`} />
    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />
    <!-- i18n: hreflang for SEO -->
    <link rel="alternate" hreflang="fr" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={`${canonicalURL}?lang=en`} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon-browser.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <!-- Schema.org Person structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'ExauEyano',
      jobTitle: 'Graphic Designer · UI/UX · Fullstack Developer',
      url: BASE_URL,
      sameAs: [
        'https://github.com/eyanobing14',
        'https://www.instagram.com/krea14/'
      ],
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'BI',
        addressLocality: 'Gitega'
      },
      knowsAbout: ['UI/UX Design', 'Graphic Design', 'Web Development', 'Frontend Development']
    })} />
    <!-- Prevent FOUC: apply theme before paint -->
    <script is:inline>
      (function() {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        // Default to dark. Only switch to light if explicitly saved or prefers-light.
        if (saved === 'light' || (!saved && !prefersDark)) {
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.removeAttribute('data-theme');
        }
      })();
    </script>
    <style>
      /* Hide default cursor globally — custom cursor handles interaction */
      @media (pointer: fine) {
        *, *::before, *::after {
          cursor: none !important;
        }
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Aller au contenu principal</a>
    <LiquidCursor />
    <slot />
    <GSAPSetup />
  </body>
</html>
