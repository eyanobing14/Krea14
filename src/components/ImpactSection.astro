---
// ImpactSection — Collapsible dropdown cards with animated illustrations
import Container from "./Container.astro";
---

<section class="section">
  <Container>
    <div class="impact-layout">
      <div class="impact-header">
        <h2
          class="text-2xl sm:text-3xl md:text-4xl font-bold animate-in"
          style="color: var(--fg);"
        >
          L'impact que nous créons.
        </h2>
        <p
          class="mt-4 text-base sm:text-lg max-w-xl animate-in"
          style="color: var(--fg-secondary); --delay: 0.1s;"
        >
          Les technologies changent selon les projets. Ce qui ne change pas,
          c'est la rigueur, la qualité et les résultats livrés.
        </p>
      </div>

      <div class="impact-list animate-in" style="--delay: 0.15s;">
        <!-- Orientation résultats — Target animation -->
        <details class="impact-item" open>
          <summary class="impact-summary">
            <div class="impact-summary-left">
              <div class="impact-icon">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  ><circle cx="12" cy="12" r="10"></circle><circle
                    cx="12"
                    cy="12"
                    r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg
                >
              </div>
              <span class="impact-title">Orientation résultats</span>
            </div>
            <svg
              class="impact-chevron"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg
            >
          </summary>
          <div class="impact-body">
            <div class="impact-illustration">
              <svg viewBox="0 0 140 90" fill="none" class="illust">
                <circle
                  cx="70"
                  cy="45"
                  r="35"
                  stroke="var(--border-hover)"
                  stroke-width="1"
                  stroke-dasharray="4 3"
                  class="target-ring target-ring-outer"></circle>
                <circle
                  cx="70"
                  cy="45"
                  r="23"
                  stroke="var(--fg-muted)"
                  stroke-width="1"
                  stroke-dasharray="3 2"
                  class="target-ring target-ring-middle"></circle>
                <circle
                  cx="70"
                  cy="45"
                  r="12"
                  stroke="var(--fg)"
                  stroke-width="1.5"
                  class="target-ring target-ring-inner"></circle>
                <circle cx="70" cy="45" r="3" fill="var(--fg)" class="bullseye"
                ></circle>
                <line
                  x1="18"
                  y1="78"
                  x2="68"
                  y2="46.3"
                  stroke="var(--fg-muted)"
                  stroke-width="1"
                  stroke-dasharray="3 2"
                  class="arrow-line"></line>
                <polygon
                  points="68,46.3 59.6,48.2 62.9,53.2"
                  fill="var(--fg-muted)"
                  class="arrow-head"></polygon>
                <circle
                  cx="70"
                  cy="45"
                  r="35"
                  stroke="var(--fg)"
                  stroke-width="0.5"
                  opacity="0"
                  class="pulse p1"></circle>
                <circle
                  cx="70"
                  cy="45"
                  r="35"
                  stroke="var(--fg)"
                  stroke-width="0.5"
                  opacity="0"
                  class="pulse p2"></circle>
              </svg>
            </div>
            <p>
              Chaque projet commence par une écoute active. Nous comprenons
              votre marché, vos utilisateurs et vos contraintes avant de
              concevoir.
            </p>
            <div class="impact-keywords">
              <span>Empathie</span><span>Wireframe</span><span>Test</span>
            </div>
          </div>
        </details>

        <!-- Qualité sans compromis — Diamond/sparkle animation -->
        <details class="impact-item">
          <summary class="impact-summary">
            <div class="impact-summary-left">
              <div class="impact-icon">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  ><path
                    d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                  ></path></svg
                >
              </div>
              <span class="impact-title">Qualité sans compromis</span>
            </div>
            <svg
              class="impact-chevron"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg
            >
          </summary>
          <div class="impact-body">
            <div class="impact-illustration">
              <svg viewBox="0 0 140 90" fill="none" class="illust">
                <polygon
                  points="70,10 105,45 70,80 35,45"
                  stroke="var(--fg)"
                  stroke-width="1.5"
                  fill="none"
                  class="diamond"></polygon>
                <line
                  x1="35"
                  y1="45"
                  x2="105"
                  y2="45"
                  stroke="var(--fg-muted)"
                  stroke-width="0.75"
                  class="diamond-mid"></line>
                <line
                  x1="70"
                  y1="10"
                  x2="52"
                  y2="45"
                  stroke="var(--fg-muted)"
                  stroke-width="0.5"
                  opacity="0.5"></line>
                <line
                  x1="70"
                  y1="10"
                  x2="88"
                  y2="45"
                  stroke="var(--fg-muted)"
                  stroke-width="0.5"
                  opacity="0.5"></line>
                <line
                  x1="52"
                  y1="45"
                  x2="70"
                  y2="80"
                  stroke="var(--fg-muted)"
                  stroke-width="0.5"
                  opacity="0.5"></line>
                <line
                  x1="88"
                  y1="45"
                  x2="70"
                  y2="80"
                  stroke="var(--fg-muted)"
                  stroke-width="0.5"
                  opacity="0.5"></line>
                <g class="sparkle s1"
                  ><line
                    x1="118"
                    y1="15"
                    x2="124"
                    y2="15"
                    stroke="var(--fg)"
                    stroke-width="1"></line><line
                    x1="121"
                    y1="12"
                    x2="121"
                    y2="18"
                    stroke="var(--fg)"
                    stroke-width="1"></line></g
                >
                <g class="sparkle s2"
                  ><line
                    x1="12"
                    y1="65"
                    x2="18"
                    y2="65"
                    stroke="var(--fg-muted)"
                    stroke-width="0.75"></line><line
                    x1="15"
                    y1="62"
                    x2="15"
                    y2="68"
                    stroke="var(--fg-muted)"
                    stroke-width="0.75"></line></g
                >
                <g class="sparkle s3"
                  ><line
                    x1="125"
                    y1="60"
                    x2="130"
                    y2="60"
                    stroke="var(--fg-muted)"
                    stroke-width="0.75"></line><line
                    x1="127.5"
                    y1="57"
                    x2="127.5"
                    y2="63"
                    stroke="var(--fg-muted)"
                    stroke-width="0.75"></line></g
                >
              </svg>
            </div>
            <p>
              Code lisible, design pixel-perfect, performance optimale. Nous ne
              livrons jamais un travail que nous n'aurions pas fierté de
              montrer.
            </p>
            <div class="impact-keywords">
              <span>Pixels</span><span>Performance</span><span>Fiabilité</span>
            </div>
          </div>
        </details>

        <!-- De A à Z — Path animation -->
        <details class="impact-item">
          <summary class="impact-summary">
            <div class="impact-summary-left">
              <div class="impact-icon">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  ><path d="M4 4h4l3 8-3 8H4M20 4h-4l-3 8 3 8h4"></path></svg
                >
              </div>
              <span class="impact-title">De A à Z</span>
            </div>
            <svg
              class="impact-chevron"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg
            >
          </summary>
          <div class="impact-body">
            <div class="impact-illustration">
              <svg viewBox="0 0 140 90" fill="none" class="illust">
                <circle
                  cx="20"
                  cy="45"
                  r="10"
                  stroke="var(--fg)"
                  stroke-width="1.5"
                  fill="none"
                  class="node node-a"></circle>
                <text
                  x="20"
                  y="49"
                  text-anchor="middle"
                  fill="var(--fg)"
                  font-size="10"
                  font-family="var(--font-mono)">A</text
                >
                <circle
                  cx="120"
                  cy="45"
                  r="10"
                  stroke="var(--fg)"
                  stroke-width="1.5"
                  fill="none"
                  class="node node-z"></circle>
                <text
                  x="120"
                  y="49"
                  text-anchor="middle"
                  fill="var(--fg)"
                  font-size="10"
                  font-family="var(--font-mono)">Z</text
                >
                <path
                  d="M30 45 C45 25, 55 65, 70 45 S95 25, 110 45"
                  stroke="var(--fg-muted)"
                  stroke-width="1"
                  stroke-dasharray="4 3"
                  fill="none"
                  class="path-line"></path>
                <circle
                  cx="70"
                  cy="45"
                  r="3"
                  fill="var(--fg)"
                  class="moving-dot"></circle>
                <circle
                  cx="48"
                  cy="35"
                  r="2"
                  fill="var(--fg-muted)"
                  opacity="0.5"></circle>
                <circle
                  cx="92"
                  cy="55"
                  r="2"
                  fill="var(--fg-muted)"
                  opacity="0.5"></circle>
              </svg>
            </div>
            <p>
              Du premier croquis au déploiement en production. Une seule vision,
              un seul interlocuteur, une cohérence totale du début à la fin.
            </p>
            <div class="impact-keywords">
              <span>Croquis</span><span>Développement</span><span
                >Déploiement</span
              >
            </div>
          </div>
        </details>

        <!-- Intégration fluide — Puzzle/connect animation -->
        <details class="impact-item">
          <summary class="impact-summary">
            <div class="impact-summary-left">
              <div class="impact-icon">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  ><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"
                  ></path><circle cx="9" cy="7" r="4"></circle><path
                    d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"
                  ></path></svg
                >
              </div>
              <span class="impact-title">Intégration fluide</span>
            </div>
            <svg
              class="impact-chevron"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg
            >
          </summary>
          <div class="impact-body">
            <div class="impact-illustration">
              <svg viewBox="0 0 140 90" fill="none" class="illust">
                <g class="puzzle-left">
                  <rect
                    x="12"
                    y="15"
                    width="40"
                    height="50"
                    rx="4"
                    stroke="var(--fg)"
                    stroke-width="1.5"
                    fill="none"></rect>
                  <path
                    d="M52 30 C60 30, 60 50, 52 50"
                    stroke="var(--fg)"
                    stroke-width="1.5"
                    fill="none"></path>
                  <text
                    x="32"
                    y="44"
                    text-anchor="middle"
                    fill="var(--fg-muted)"
                    font-size="8"
                    font-family="var(--font-mono)">NOUS</text
                  >
                </g>
                <g class="puzzle-right">
                  <rect
                    x="75"
                    y="15"
                    width="40"
                    height="50"
                    rx="4"
                    stroke="var(--fg-muted)"
                    stroke-width="1.5"
                    fill="none"></rect>
                  <path
                    d="M75 30 C67 30, 67 50, 75 50"
                    stroke="var(--fg-muted)"
                    stroke-width="1.5"
                    fill="none"></path>
                  <text
                    x="95"
                    y="44"
                    text-anchor="middle"
                    fill="var(--fg-muted)"
                    font-size="8"
                    font-family="var(--font-mono)">VOUS</text
                  >
                </g>
                <circle
                  cx="63"
                  cy="40"
                  r="2"
                  fill="var(--fg)"
                  opacity="0"
                  class="conn-sparkle"></circle>
              </svg>
            </div>
            <p>
              Nous nous adaptons à votre workflow. Git, sprints, revues de code
              — nous devenons un membre à part entière de votre équipe.
            </p>
            <div class="impact-keywords">
              <span>Git</span><span>Sprints</span><span>Co-création</span>
            </div>
          </div>
        </details>
      </div>
    </div>
  </Container>
</section>

<style>
  /* Section-level Z-pattern: header left, list right */
  .impact-layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    .impact-layout {
      flex-direction: row;
      align-items: flex-start;
      gap: 4rem;
    }
    .impact-header {
      width: 35%;
      flex-shrink: 0;
      position: sticky;
      top: 120px;
    }
    .impact-list {
      flex: 1;
      min-width: 0;
    }
  }

  .impact-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 700px;
    width: 100%;
  }
  @media (max-width: 1023px) {
    .impact-list {
      margin-left: auto;
      margin-right: auto;
      max-width: 100%;
    }
  }

  .impact-item {
    border: 1px solid var(--border);
    border-bottom: none;
    background: var(--bg);
    transition: border-color 0.3s;
  }
  .impact-item:last-child {
    border-bottom: 1px solid var(--border);
  }
  .impact-item[open] {
    border-color: var(--border-hover);
  }
  .impact-item[open] + .impact-item {
    border-top-color: var(--border-hover);
  }

  .impact-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background 0.2s;
  }
  .impact-summary::-webkit-details-marker {
    display: none;
  }
  .impact-summary::marker {
    display: none;
    content: "";
  }
  .impact-summary:hover {
    background: var(--bg-raised);
  }

  .impact-summary-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .impact-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    color: var(--fg-secondary);
    flex-shrink: 0;
    transition:
      color 0.3s,
      border-color 0.3s;
  }
  .impact-item[open] .impact-icon {
    color: var(--fg);
    border-color: var(--border-hover);
  }

  .impact-title {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--fg);
  }

  .impact-chevron {
    color: var(--fg-muted);
    transition: transform 0.3s var(--ease-out-expo);
    flex-shrink: 0;
  }
  .impact-item[open] .impact-chevron {
    transform: rotate(180deg);
  }

  .impact-body {
    padding: 0 1.25rem 1.25rem 3.5rem;
    display: none;
  }
  .impact-item[open] > .impact-body {
    display: block;
    animation: dropdown-in 0.9s var(--ease-out-expo);
  }
  .impact-body p {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--fg-secondary);
  }

  /* Illustrated area — centered above text */
  .impact-illustration {
    margin-bottom: 0.75rem;
    display: flex;
    justify-content: center;
    overflow: visible;
  }
  .illust {
    width: 100%;
    max-width: 280px;
    height: auto;
    overflow: visible;
  }

  .impact-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }
  .impact-keywords span {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border);
    color: var(--fg-muted);
  }

  @keyframes dropdown-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Illustration animations ── */

  /* Target pulse */
  .pulse {
    animation: target-pulse 2s ease-out infinite;
  }
  .p2 {
    animation-delay: 1s;
  }
  @keyframes target-pulse {
    0% {
      r: 10;
      opacity: 0.6;
    }
    100% {
      r: 35;
      opacity: 0;
    }
  }
  .target-ring {
    stroke-dashoffset: 0;
  }
  .target-ring-outer {
    animation: ring-rotate 12s linear infinite;
  }
  .target-ring-middle {
    animation: ring-rotate 8s linear infinite reverse;
  }
  @keyframes ring-rotate {
    from {
      stroke-dashoffset: 0;
    }
    to {
      stroke-dashoffset: 40;
    }
  }

  /* Diamond sparkle */
  .sparkle {
    animation: sparkle-blink 2s ease-in-out infinite;
  }
  .s2 {
    animation-delay: 0.7s;
  }
  .s3 {
    animation-delay: 1.4s;
  }
  @keyframes sparkle-blink {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.5);
    }
    50% {
      opacity: 1;
      transform: scale(1.2);
    }
  }
  .diamond {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    animation: draw-diamond 1.5s ease forwards;
  }
  @keyframes draw-diamond {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Path A→Z */
  .path-line {
    stroke-dasharray: 4 3;
    stroke-dashoffset: 0;
    animation: path-flow 3s linear infinite;
  }
  @keyframes path-flow {
    to {
      stroke-dashoffset: -28;
    }
  }
  .moving-dot {
    animation: move-along-path 3s ease-in-out infinite;
  }
  @keyframes move-along-path {
    0% {
      cx: 20;
      cy: 45;
    }
    25% {
      cx: 48;
      cy: 35;
    }
    50% {
      cx: 70;
      cy: 45;
    }
    75% {
      cx: 92;
      cy: 55;
    }
    100% {
      cx: 120;
      cy: 45;
    }
  }
  .node {
    animation: node-pulse 2s ease-in-out infinite alternate;
  }
  @keyframes node-pulse {
    from {
      stroke-width: 1.5;
    }
    to {
      stroke-width: 2.5;
    }
  }

  /* Puzzle connect */
  .puzzle-left {
    animation: puzzle-slide-right 2.5s ease-in-out infinite alternate;
  }
  .puzzle-right {
    animation: puzzle-slide-left 2.5s ease-in-out infinite alternate;
  }
  @keyframes puzzle-slide-right {
    from {
      transform: translateX(-5px);
    }
    to {
      transform: translateX(3px);
    }
  }
  @keyframes puzzle-slide-left {
    from {
      transform: translateX(5px);
    }
    to {
      transform: translateX(-3px);
    }
  }
  .conn-sparkle {
    animation: conn-flash 2.5s ease-in-out infinite alternate;
  }
  @keyframes conn-flash {
    0%,
    60% {
      opacity: 0;
      r: 1;
    }
    80%,
    100% {
      opacity: 0.8;
      r: 4;
    }
  }

  @media (max-width: 480px) {
    .impact-summary {
      padding: 0.75rem 1rem;
    }
    .impact-body {
      padding: 0 1rem 1rem 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .impact-body {
      animation: none;
    }
    .impact-chevron {
      transition: none;
    }
    .pulse,
    .target-ring,
    .sparkle,
    .diamond,
    .path-line,
    .moving-dot,
    .node,
    .puzzle-left,
    .puzzle-right,
    .conn-sparkle {
      animation: none !important;
    }
  }
</style>

<script>
  import gsap from "gsap";

  function initAccordion() {
    const items = document.querySelectorAll(".impact-item");

    function centerOpenItem(details: HTMLDetailsElement) {
      requestAnimationFrame(() => {
        details.scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
            .matches
            ? "auto"
            : "smooth",
          block: "center",
          inline: "nearest",
        });
      });
    }

    items.forEach((details) => {
      details.addEventListener("toggle", () => {
        if ((details as HTMLDetailsElement).open) {
          items.forEach((other) => {
            if (other !== details) (other as HTMLDetailsElement).open = false;
          });
          const body = details.querySelector<HTMLElement>(".impact-body");
          if (
            body &&
            !window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ) {
            gsap.fromTo(
              body,
              { opacity: 0.65, y: -6 },
              {
                opacity: 1,
                y: 0,
                duration: 0.24,
                ease: "power2.out",
                clearProps: "transform,opacity",
              },
            );
          }
          centerOpenItem(details as HTMLDetailsElement);
        }
      });
    });
  }
  document.readyState === "loading"
    ? document.addEventListener("DOMContentLoaded", initAccordion)
    : initAccordion();
</script>
