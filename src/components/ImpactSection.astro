---
// ImpactSection — Show what gets delivered and the value created, not the tools used
import Container from "./Container.astro";
---

<section class="section">
  <Container>
    <h2
      class="text-2xl sm:text-3xl md:text-4xl font-bold text-center animate-in"
      style="color: var(--fg);"
    >
      L'impact que nous créons.
    </h2>
    <p
      class="mt-4 text-center text-base sm:text-lg max-w-2xl mx-auto animate-in"
      style="color: var(--fg-secondary); --delay: 0.1s;"
    >
      Les technologies changent selon les projets. Ce qui ne change pas, c'est
      la rigueur, la qualité et les résultats livrés.
    </p>

    <div class="impact-grid mt-12">
      <!-- Orientation client -->
      <div class="impact-card animate-in" style="--delay: 0.15s;">
        <div class="impact-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        </div>
        <h3 class="impact-title">Orientation résultats</h3>
        <p class="impact-desc">
          Chaque projet commence par une écoute active. Nous comprenons votre
          marché, vos utilisateurs et vos contraintes avant de concevoir.
        </p>
      </div>

      <!-- Qualité -->
      <div class="impact-card animate-in" style="--delay: 0.25s;">
        <div class="impact-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <h3 class="impact-title">Qualité sans compromis</h3>
        <p class="impact-desc">
          Code lisible, design pixel-perfect, performance optimale. Nous ne
          livrons jamais un travail que nous n'aurions pas fierté de montrer.
        </p>
      </div>
      <!-- A to Z -->
      <div class="impact-card animate-in" style="--delay: 0.35s;">
        <div class="impact-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M2 12h20"/></svg>
        </div>
        <h3 class="impact-title">De A à Z</h3>
        <p class="impact-desc">
          Du premier croquis au déploiement en production. Une seule vision,
          un seul interlocuteur, une cohérence totale du début à la fin.
        </p>
      </div>

      <!-- Équipe -->
      <div class="impact-card animate-in" style="--delay: 0.45s;">
        <div class="impact-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3 class="impact-title">Intégration fluide</h3>
        <p class="impact-desc">
          Nous nous adaptons à votre workflow. Git, sprints, revues de code —
          nous devenons un membre à part entière de votre équipe.
        </p>
      </div>
    </div>

    <!-- Marquee de résultats -->
    <div class="impact-marquee animate-in" style="--delay: 0.55s;">
      <div class="impact-marquee-track">
        <span>Brandings mémorables</span>
        <span class="impact-dot" aria-hidden="true">·</span>
        <span>Interfaces intuitives</span>
        <span class="impact-dot" aria-hidden="true">·</span>
        <span>Sites performants</span>
        <span class="impact-dot" aria-hidden="true">·</span>
        <span>Applications mobiles</span>
        <span class="impact-dot" aria-hidden="true">·</span>
        <span>Systèmes de design</span>
        <span class="impact-dot" aria-hidden="true">·</span>
        <span>APIs robustes</span>
        <span class="impact-dot" aria-hidden="true">·</span>
        <!-- Duplicate for seamless loop -->
        <span>Brandings mémorables</span>
        <span class="impact-dot" aria-hidden="true">·</span>
        <span>Interfaces intuitives</span>
        <span class="impact-dot" aria-hidden="true">·</span>
        <span>Sites performants</span>
        <span class="impact-dot" aria-hidden="true">·</span>
        <span>Applications mobiles</span>
        <span class="impact-dot" aria-hidden="true">·</span>
        <span>Systèmes de design</span>
        <span class="impact-dot" aria-hidden="true">·</span>
        <span>APIs robustes</span>
        <span class="impact-dot" aria-hidden="true">·</span>
      </div>
    </div>
  </Container>
</section>

<style>
  .impact-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .impact-card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    background: var(--bg);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: border-color 0.3s ease, transform 0.3s var(--ease-out-expo);
  }
  .impact-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-3px);
  }

  .impact-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    color: var(--fg-secondary);
    transition: color 0.3s, border-color 0.3s;
  }
  .impact-card:hover .impact-icon {
    color: var(--fg);
    border-color: var(--border-hover);
  }

  .impact-title {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--fg);
  }

  .impact-desc {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--fg-secondary);
    margin-top: 0.25rem;
  }

  /* ── Marquee ── */
  .impact-marquee {
    margin-top: 3rem;
    overflow: hidden;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
  }

  .impact-marquee-track {
    display: flex;
    gap: 0;
    white-space: nowrap;
    animation: marquee-scroll 25s linear infinite;
    width: max-content;
  }

  .impact-marquee-track span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding: 0 0.75rem;
    flex-shrink: 0;
  }

  .impact-dot {
    color: var(--border-hover) !important;
  }

  @keyframes marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .impact-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .impact-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .impact-card {
      padding: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .impact-marquee-track {
      animation: none;
    }
  }
</style>
