---
// DevArchitecture — Animated architecture diagram
// Frontend → Backend → Database with data flow animation
// Explains full-stack capability: delivery A to Z + team integration
import Container from "./Container.astro";
---

<section class="section">
  <Container>
    <h2
      class="text-2xl sm:text-3xl md:text-4xl font-bold text-center animate-in"
      style="color: var(--fg);"
    >
      Ingénierie logicielle.
    </h2>
    <p
      class="mt-4 text-center text-base sm:text-lg max-w-2xl mx-auto animate-in"
      style="color: var(--fg-secondary); --delay: 0.1s;"
    >
      De l'interface utilisateur au déploiement, nous maîtrisons l'ensemble de
      la chaîne technique — ou nous nous intégrons dans votre équipe existante.
    </p>

    <!-- Architecture Diagram -->
    <div class="arch-diagram animate-in" style="--delay: 0.25s;">
      <div class="arch-wrapper">
        <!-- Frontend Node -->
        <div class="arch-node arch-node--frontend">
          <div class="arch-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="3" width="20" height="14" rx="2"/>
              <path d="M8 21h8M12 17v4"/>
            </svg>
          </div>
          <span class="arch-label">Frontend</span>
          <span class="arch-tech">Interfaces & expériences</span>
        </div>

        <!-- Data flow 1: Frontend → Backend -->
        <div class="arch-flow">
          <div class="arch-line arch-line--1"></div>
          <div class="arch-packet arch-packet--1"></div>
          <div class="arch-packet arch-packet--1b"></div>
          <div class="arch-arrow">
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M2 5L8 5M5 2L8 5L5 8" stroke="currentColor" stroke-width="1.2"/></svg>
          </div>
          <span class="arch-flow-label">API</span>
        </div>

        <!-- Backend Node -->
        <div class="arch-node arch-node--backend">
          <div class="arch-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="2" width="20" height="8" rx="2"/>
              <rect x="2" y="14" width="20" height="8" rx="2"/>
              <circle cx="6" cy="6" r="1" fill="currentColor"/>
              <circle cx="6" cy="18" r="1" fill="currentColor"/>
              <path d="M10 6h6M10 18h6"/>
            </svg>
          </div>
          <span class="arch-label">Backend</span>
          <span class="arch-tech">Logique métier & APIs</span>
        </div>

        <!-- Data flow 2: Backend → Database -->
        <div class="arch-flow">
          <div class="arch-line arch-line--2"></div>
          <div class="arch-packet arch-packet--2"></div>
          <div class="arch-packet arch-packet--2b"></div>
          <div class="arch-arrow">
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M2 5L8 5M5 2L8 5L5 8" stroke="currentColor" stroke-width="1.2"/></svg>
          </div>
          <span class="arch-flow-label">SQL</span>
        </div>

        <!-- Database Node -->
        <div class="arch-node arch-node--database">
          <div class="arch-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <ellipse cx="12" cy="5" rx="9" ry="3"/>
              <path d="M21 12c0 1.66-4.03 3-9 3s-9-1.34-9-3"/>
              <path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/>
            </svg>
          </div>
          <span class="arch-label">Base de données</span>
          <span class="arch-tech">Persistance & données</span>
        </div>
      </div>

      <!-- Capability badges -->
      <div class="arch-capabilities">
        <div class="arch-badge animate-in" style="--delay: 0.4s;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M2 12h20"/></svg>
          <span>Livraison de A à Z</span>
        </div>
        <div class="arch-badge animate-in" style="--delay: 0.5s;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span>Intégration en équipe</span>
        </div>
        <div class="arch-badge animate-in" style="--delay: 0.6s;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          <span>Déploiement & maintenance</span>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .arch-diagram {
    margin-top: 3rem;
  }

  .arch-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 2rem 0;
  }

  /* ── Nodes ── */
  .arch-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    background: var(--bg);
    min-width: 130px;
    transition: border-color 0.3s ease, transform 0.3s var(--ease-out-expo);
  }
  .arch-node:hover {
    border-color: var(--border-hover);
    transform: translateY(-3px);
  }

  .arch-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    color: var(--fg-secondary);
    transition: color 0.3s, border-color 0.3s;
  }
  .arch-node:hover .arch-icon {
    color: var(--fg);
    border-color: var(--border-hover);
  }

  .arch-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg);
  }

  .arch-tech {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: var(--fg-muted);
    letter-spacing: 0.03em;
    text-align: center;
  }

  /* ── Data Flow Lines ── */
  .arch-flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    width: 80px;
    gap: 0.25rem;
  }

  .arch-line {
    width: 60px;
    height: 1px;
    background: var(--border);
    position: relative;
  }

  .arch-packet {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fg-secondary);
    top: -2.5px;
    opacity: 0;
  }
  .arch-packet--1 {
    animation: flow-right 2s ease-in-out infinite;
    animation-delay: 0s;
  }
  .arch-packet--1b {
    animation: flow-right 2s ease-in-out infinite;
    animation-delay: 1s;
  }
  .arch-packet--2 {
    animation: flow-right 2s ease-in-out infinite;
    animation-delay: 0.3s;
  }
  .arch-packet--2b {
    animation: flow-right 2s ease-in-out infinite;
    animation-delay: 1.3s;
  }

  @keyframes flow-right {
    0% { left: 0; opacity: 0; }
    10% { opacity: 0.8; }
    90% { opacity: 0.8; }
    100% { left: calc(100% - 6px); opacity: 0; }
  }

  .arch-arrow {
    color: var(--fg-muted);
    display: flex;
  }

  .arch-flow-label {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    color: var(--fg-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ── Capability Badges ── */
  .arch-capabilities {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .arch-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-secondary);
    letter-spacing: 0.02em;
    transition: border-color 0.3s, color 0.3s;
  }
  .arch-badge:hover {
    border-color: var(--border-hover);
    color: var(--fg);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .arch-wrapper {
      flex-direction: column;
      gap: 0;
    }
    .arch-flow {
      width: auto;
      height: 50px;
      flex-direction: row;
    }
    .arch-line {
      width: 1px;
      height: 40px;
    }
    .arch-packet {
      top: auto;
      left: -2.5px;
      animation: flow-down 2s ease-in-out infinite !important;
    }
    .arch-packet--1b, .arch-packet--2b {
      animation-delay: 1s !important;
    }
    @keyframes flow-down {
      0% { top: 0; opacity: 0; }
      10% { opacity: 0.8; }
      90% { opacity: 0.8; }
      100% { top: calc(100% - 6px); opacity: 0; }
    }
    .arch-arrow {
      transform: rotate(90deg);
    }
    .arch-node {
      min-width: 200px;
      width: 100%;
      max-width: 280px;
    }
    .arch-capabilities {
      flex-direction: column;
      align-items: center;
    }
  }

  @media (max-width: 480px) {
    .arch-node {
      min-width: 0;
      padding: 1rem;
    }
    .arch-badge {
      font-size: 0.625rem;
      padding: 0.375rem 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arch-packet {
      animation: none !important;
      opacity: 0.5;
    }
  }
</style>
