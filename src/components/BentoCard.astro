---
import StepIcon from './StepIcon.astro';
import PortfolioImage from './PortfolioImage.astro';

interface Props {
  index: number;
  text: string;
  image?: string;
  total: number;
}

const { index, text, image = '', total } = Astro.props;

// Layout 6 étapes : 2 cols × 2 rows — col 1 = 30%, col 2-3 = 70% (50/50)
// Étape 1 → haut gauche, étapes 2-5 → bloc 70%, étape 6 → bas gauche.
let posClass = '';
let compact = false;
let spanClass = '';

if (total === 6) {
  posClass = ['bento-p1', 'bento-p2', 'bento-p3', 'bento-p4', 'bento-p5', 'bento-p6'][index] || '';
  compact = index === 2 || index === 3;
} else {
  let variant: 'tall' | 'wide' | 'feature' | 'normal' = 'normal';
  if (total === 5) {
    if (index === 0) variant = 'tall';
    else if (index === 1 || index === 2) variant = 'wide';
  } else if (total === 4) {
    if (index === 0) variant = 'tall';
    else if (index === 1) variant = 'wide';
  }
  spanClass =
    variant === 'tall' ? 'bento-tall' :
    variant === 'wide' ? 'bento-wide' :
    variant === 'feature' ? 'bento-feature' : '';
}
---

<div class={`bento-card ${posClass} ${spanClass} ${compact ? 'bento-compact' : ''} gsap-reveal`}>
  <span class="bento-watermark" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  <div class="bento-card-head">
    <StepIcon text={text} index={index} showNum={false} />
    <p class="bento-text">{text}</p>
  </div>
  {image && (
    <div class="bento-image">
      <PortfolioImage
        src={image}
        alt={`Étape ${index + 1} : ${text}`}
        class="w-full h-full object-cover"
        loading="lazy"
        sizes="(min-width: 1024px) 33vw, 100vw"
      />
      <span class="bento-image-tag">Étape {String(index + 1).padStart(2, '0')}</span>
    </div>
  )}
</div>

<style>
  .bento-card {
    position: relative;
    min-width: 0;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
    overflow: hidden;
  }
  .bento-card:hover {
    border-color: var(--border-hover);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }

  /* ── Positions 2×2 — 30% / 70% (50/50) ── */
  .bento-p1 { grid-column: 1; grid-row: 1; }
  .bento-p2 { grid-column: 2; grid-row: 1; }
  .bento-p3 { grid-column: 3; grid-row: 1; }
  .bento-p4 { grid-column: 2; grid-row: 2; }
  .bento-p5 { grid-column: 3; grid-row: 2; }
  .bento-p6 { grid-column: 1; grid-row: 2; }

  /* ── Étapes 3 & 4 (compact) ── */
  .bento-compact .bento-card-head {
    gap: 0.75rem;
  }

  /* ── Fallback spans (pour totals ≠ 6) ── */
  .bento-tall { grid-row: span 2; }
  .bento-wide { grid-column: span 2; }
  .bento-feature { grid-column: span 2; grid-row: span 2; }

  /* ── Ghost step number ── */
  .bento-watermark {
    position: absolute;
    top: 0.5rem;
    right: 1.5rem;
    font-family: var(--font-mono);
    font-size: clamp(2.5rem, 5.5vw, 3.75rem);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--fg);
    opacity: 0.05;
    pointer-events: none;
    user-select: none;
  }

  .bento-card-head {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .bento-text {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--fg-secondary);
  }

  .bento-image {
    position: relative;
    margin-top: auto;
    width: 100%;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .bento-tall .bento-image,
  .bento-feature .bento-image {
    flex: 1;
    min-height: 0;
  }

  .bento-image-tag {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.5rem;
    background: var(--bg);
    color: var(--fg-muted);
    border: 1px solid var(--border);
  }

  /* ── Mobile: 1 colonne, ordre DOM ── */
  @media (max-width: 767px) {
    .bento-p1, .bento-p2, .bento-p3, .bento-p4, .bento-p5, .bento-p6,
    .bento-tall, .bento-wide, .bento-feature {
      grid-column: auto;
      grid-row: auto;
    }
    .bento-tall,
    .bento-wide,
    .bento-feature {
      margin-top: 0;
    }
    .bento-tall .bento-watermark,
    .bento-feature .bento-watermark {
      font-size: clamp(2.75rem, 10vw, 4.25rem);
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .bento-card {
      transition: none;
    }
  }
</style>