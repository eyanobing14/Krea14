---
// OrbitalSkills — Solar system animation showing tools/skills orbiting a center
// Pure CSS animations, no GSAP, no overflow issues
import Container from "./Container.astro";
---

<section class="section" style="background: var(--bg-raised);">
  <Container>
    <h2
      class="text-2xl sm:text-3xl md:text-4xl font-bold text-center animate-in"
      style="color: var(--fg);"
    >
      Nos outils.
    </h2>
    <p
      class="mt-4 text-center text-base sm:text-lg max-w-xl mx-auto animate-in"
      style="color: var(--fg-secondary); --delay: 0.1s;"
    >
      Un écosystème d'outils maîtrisés, combinés pour chaque projet.
    </p>

    <div class="orbital-container animate-in" style="--delay: 0.2s;">
      <div class="orbital-system">
        <!-- Center -->
        <div class="orbital-center">
          <span class="orbital-center-text">Stack</span>
        </div>

        <!-- Orbit rings -->
        <div class="orbital-ring orbital-ring--1">
          <div class="orbital-item orbital-item--1" style="--orbit-speed: 18s;">
            <span class="orbital-label">Figma</span>
          </div>
          <div class="orbital-item orbital-item--2" style="--orbit-speed: 18s; --orbit-delay: -6s;">
            <span class="orbital-label">React</span>
          </div>
        </div>

        <div class="orbital-ring orbital-ring--2">
          <div class="orbital-item orbital-item--3" style="--orbit-speed: 25s;">
            <span class="orbital-label">Astro</span>
          </div>
          <div class="orbital-item orbital-item--4" style="--orbit-speed: 25s; --orbit-delay: -8.3s;">
            <span class="orbital-label">GSAP</span>
          </div>
          <div class="orbital-item orbital-item--5" style="--orbit-speed: 25s; --orbit-delay: -16.6s;">
            <span class="orbital-label">Tailwind</span>
          </div>
        </div>

        <div class="orbital-ring orbital-ring--3">
          <div class="orbital-item orbital-item--6" style="--orbit-speed: 35s;">
            <span class="orbital-label">Photoshop</span>
          </div>
          <div class="orbital-item orbital-item--7" style="--orbit-speed: 35s; --orbit-delay: -11.6s;">
            <span class="orbital-label">After Effects</span>
          </div>
          <div class="orbital-item orbital-item--8" style="--orbit-speed: 35s; --orbit-delay: -23.3s;">
            <span class="orbital-label">Illustrator</span>
          </div>
          <div class="orbital-item orbital-item--9" style="--orbit-speed: 35s; --orbit-delay: -5.8s;">
            <span class="orbital-label">Premiere</span>
          </div>
        </div>

        <!-- Ambient particles -->
        <div class="orbital-particle orbital-particle--1"></div>
        <div class="orbital-particle orbital-particle--2"></div>
        <div class="orbital-particle orbital-particle--3"></div>
        <div class="orbital-particle orbital-particle--4"></div>
        <div class="orbital-particle orbital-particle--5"></div>
      </div>
    </div>
  </Container>
</section>

<style>
  .orbital-container {
    display: flex;
    justify-content: center;
    padding: 2rem 0;
  }

  .orbital-system {
    position: relative;
    width: 400px;
    height: 400px;
  }

  /* Center node */
  .orbital-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    border: 1px solid var(--border-hover);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    z-index: 3;
  }
  .orbital-center-text {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
  }

  /* Orbit rings */
  .orbital-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px dashed var(--border);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .orbital-ring--1 {
    width: 180px;
    height: 180px;
  }
  .orbital-ring--2 {
    width: 280px;
    height: 280px;
  }
  .orbital-ring--3 {
    width: 380px;
    height: 380px;
  }

  /* Orbit items */
  .orbital-item {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    animation: orbital-spin var(--orbit-speed, 20s) linear infinite;
    animation-delay: var(--orbit-delay, 0s);
  }
  .orbital-label {
    position: absolute;
    transform: translate(-50%, -50%);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--fg-secondary);
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    white-space: nowrap;
    transition: color 0.3s, border-color 0.3s;
  }
  .orbital-label:hover {
    color: var(--fg);
    border-color: var(--border-hover);
  }

  /* Position items on orbit circles using translate from center */
  .orbital-item--1 { animation-name: orbital-pos-1a; }
  .orbital-item--2 { animation-name: orbital-pos-1b; }

  .orbital-item--3 { animation-name: orbital-pos-2a; }
  .orbital-item--4 { animation-name: orbital-pos-2b; }
  .orbital-item--5 { animation-name: orbital-pos-2c; }

  .orbital-item--6 { animation-name: orbital-pos-3a; }
  .orbital-item--7 { animation-name: orbital-pos-3b; }
  .orbital-item--8 { animation-name: orbital-pos-3c; }
  .orbital-item--9 { animation-name: orbital-pos-3d; }

  /* Ring 1: radius 90px */
  @keyframes orbital-pos-1a {
    0%   { transform: translate(calc(-50% + 90px), -50%); }
    25%  { transform: translate(-50%, calc(-50% - 90px)); }
    50%  { transform: translate(calc(-50% - 90px), -50%); }
    75%  { transform: translate(-50%, calc(-50% + 90px)); }
    100% { transform: translate(calc(-50% + 90px), -50%); }
  }
  @keyframes orbital-pos-1b {
    0%   { transform: translate(-50%, calc(-50% + 90px)); }
    25%  { transform: translate(calc(-50% + 90px), -50%); }
    50%  { transform: translate(-50%, calc(-50% - 90px)); }
    75%  { transform: translate(calc(-50% - 90px), -50%); }
    100% { transform: translate(-50%, calc(-50% + 90px)); }
  }

  /* Ring 2: radius 140px */
  @keyframes orbital-pos-2a {
    0%   { transform: translate(calc(-50% + 140px), -50%); }
    33%  { transform: translate(calc(-50% - 70px), calc(-50% - 121px)); }
    66%  { transform: translate(calc(-50% - 70px), calc(-50% + 121px)); }
    100% { transform: translate(calc(-50% + 140px), -50%); }
  }
  @keyframes orbital-pos-2b {
    0%   { transform: translate(calc(-50% - 70px), calc(-50% - 121px)); }
    33%  { transform: translate(calc(-50% - 70px), calc(-50% + 121px)); }
    66%  { transform: translate(calc(-50% + 140px), -50%); }
    100% { transform: translate(calc(-50% - 70px), calc(-50% - 121px)); }
  }
  @keyframes orbital-pos-2c {
    0%   { transform: translate(calc(-50% - 70px), calc(-50% + 121px)); }
    33%  { transform: translate(calc(-50% + 140px), -50%); }
    66%  { transform: translate(calc(-50% - 70px), calc(-50% - 121px)); }
    100% { transform: translate(calc(-50% - 70px), calc(-50% + 121px)); }
  }

  /* Ring 3: radius 190px */
  @keyframes orbital-pos-3a {
    0%   { transform: translate(calc(-50% + 190px), -50%); }
    25%  { transform: translate(-50%, calc(-50% - 190px)); }
    50%  { transform: translate(calc(-50% - 190px), -50%); }
    75%  { transform: translate(-50%, calc(-50% + 190px)); }
    100% { transform: translate(calc(-50% + 190px), -50%); }
  }
  @keyframes orbital-pos-3b {
    0%   { transform: translate(-50%, calc(-50% - 190px)); }
    25%  { transform: translate(calc(-50% - 190px), -50%); }
    50%  { transform: translate(-50%, calc(-50% + 190px)); }
    75%  { transform: translate(calc(-50% + 190px), -50%); }
    100% { transform: translate(-50%, calc(-50% - 190px)); }
  }
  @keyframes orbital-pos-3c {
    0%   { transform: translate(calc(-50% - 190px), -50%); }
    25%  { transform: translate(-50%, calc(-50% + 190px)); }
    50%  { transform: translate(calc(-50% + 190px), -50%); }
    75%  { transform: translate(-50%, calc(-50% - 190px)); }
    100% { transform: translate(calc(-50% - 190px), -50%); }
  }
  @keyframes orbital-pos-3d {
    0%   { transform: translate(-50%, calc(-50% + 190px)); }
    25%  { transform: translate(calc(-50% + 190px), -50%); }
    50%  { transform: translate(-50%, calc(-50% - 190px)); }
    75%  { transform: translate(calc(-50% - 190px), -50%); }
    100% { transform: translate(-50%, calc(-50% + 190px)); }
  }

  /* Ambient floating particles */
  .orbital-particle {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--fg-muted);
    opacity: 0.3;
  }
  .orbital-particle--1 {
    top: 15%;
    left: 20%;
    animation: particle-float 6s ease-in-out infinite;
  }
  .orbital-particle--2 {
    top: 75%;
    left: 80%;
    animation: particle-float 8s ease-in-out infinite 1s;
  }
  .orbital-particle--3 {
    top: 30%;
    left: 85%;
    animation: particle-float 7s ease-in-out infinite 2s;
  }
  .orbital-particle--4 {
    top: 80%;
    left: 15%;
    animation: particle-float 9s ease-in-out infinite 0.5s;
  }
  .orbital-particle--5 {
    top: 50%;
    left: 90%;
    animation: particle-float 5s ease-in-out infinite 3s;
  }

  @keyframes particle-float {
    0%, 100% { transform: translateY(0) translateX(0); opacity: 0.2; }
    50% { transform: translateY(-8px) translateX(4px); opacity: 0.5; }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .orbital-system {
      width: 300px;
      height: 300px;
      transform: scale(0.85);
    }
  }

  @media (max-width: 480px) {
    .orbital-system {
      width: 260px;
      height: 260px;
      transform: scale(0.75);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbital-item,
    .orbital-particle {
      animation: none !important;
    }
    /* Position items statically on desktop */
    .orbital-item--1 { transform: translate(calc(-50% + 90px), -50%); }
    .orbital-item--2 { transform: translate(calc(-50% - 90px), -50%); }
    .orbital-item--3 { transform: translate(calc(-50% + 140px), -50%); }
    .orbital-item--4 { transform: translate(-50%, calc(-50% - 140px)); }
    .orbital-item--5 { transform: translate(calc(-50% - 140px), -50%); }
    .orbital-item--6 { transform: translate(calc(-50% + 190px), -50%); }
    .orbital-item--7 { transform: translate(-50%, calc(-50% - 190px)); }
    .orbital-item--8 { transform: translate(calc(-50% - 190px), -50%); }
    .orbital-item--9 { transform: translate(-50%, calc(-50% + 190px)); }
  }
</style>
