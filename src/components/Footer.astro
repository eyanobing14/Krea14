---
import data from "../../public/data/portfolio.json";

const profile = data.profile as typeof data.profile & { socials?: Record<string, string> };
const socials = profile.socials || {};
const profileName = "Portfolio";
const year = new Date().getFullYear();
---

<footer>
  <!-- Links Grid -->
  <div
    class="container-page py-12 md:py-16"
    style="border-top: 1px solid var(--border);"
  >
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 sm:gap-10 md:gap-8">
      <!-- Nav -->
      <div>
        <h3
          class="text-[10px] font-mono uppercase tracking-[0.15em] mb-5"
          style="color: var(--fg-muted);"
        >
          <span data-fr="Navigation" data-en="Navigation">Navigation</span>
        </h3>
        <ul class="space-y-3">
          {
            [
              { label: "Accueil", labelEn: "Home", href: "/" },
              { label: "Work", labelEn: "Work", href: "/work" },
              { label: "À propos", labelEn: "About", href: "/about" },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm no-underline transition-colors duration-200 hover-link"
                  style="color: var(--fg-secondary);"
                >
                  <span data-fr={link.label} data-en={link.labelEn}>
                    {link.label}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3
          class="text-[10px] font-mono uppercase tracking-[0.15em] mb-5"
          style="color: var(--fg-muted);"
        >
          Services
        </h3>
        <ul class="space-y-3">
          {
            [
              "Design Graphique",
              "UI/UX Design",
              "Fullstack Dev",
              "Logo Design",
            ].map((s) => (
              <li>
                <a
                  href="/about"
                  class="text-sm no-underline transition-colors duration-200 hover-link"
                  style="color: var(--fg-secondary);"
                >
                  {s}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Socials -->
      <div>
        <h3
          class="text-[10px] font-mono uppercase tracking-[0.15em] mb-5"
          style="color: var(--fg-muted);"
        >
          <span data-fr="Réseaux" data-en="Socials">Réseaux</span>
        </h3>
        <div class="flex flex-wrap gap-2">
          {
            Object.entries(socials).map(([name, url]) => (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-9 h-9 flex items-center justify-center transition-colors duration-200 no-underline"
                style="color: var(--fg); background: var(--fg); border: 1px solid var(--border);"
                onmouseover="this.style.opacity='0.8'"
                onmouseout="this.style.opacity='1'"
                aria-label={name}
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--bg)"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  {name === "github" && (
                    <>
                      <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                    </>
                  )}
                  {name === "instagram" && (
                    <>
                      <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                    </>
                  )}
                  {name === "x" && (
                    <>
                      <path
                        d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.451-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644Z"
                        fill="var(--bg)"
                        stroke="none"
                      />
                    </>
                  )}
                  {name === "whatsapp" && (
                    <>
                      <path
                        d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.2-.7.1-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-1.5-.7-2.4-1.3-3.4-2.9-.2-.4.2-.4.7-1.3.1-.2 0-.4 0-.5 0-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-1.1 1.2-1 2.8.2 4.7 1.2 1.9 2.6 3.1 4.9 4.1 2.3 1 2.9.8 3.7.7.8-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4ZM12 2.2a9.8 9.8 0 0 0-8.4 14.7L2.2 22l5.3-1.4A9.8 9.8 0 1 0 12 2.2Zm0 1.8a8 8 0 1 1-4.2 14.8l-.3-.2-3.1.8.8-3-.2-.3A8 8 0 0 1 12 4Z"
                        fill="var(--bg)"
                        stroke="none"
                      />
                    </>
                  )}
                </svg>
              </a>
            ))
          }
          <a
            href={`mailto:${profile.email}`}
            class="w-9 h-9 flex items-center justify-center transition-colors duration-200 no-underline"
            style="color: var(--fg); background: var(--fg); border: 1px solid var(--border);"
            onmouseover="this.style.opacity='0.8'"
            onmouseout="this.style.opacity='1'"
            aria-label="Email"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--bg)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Legal -->
      <div>
        <h3
          class="text-[10px] font-mono uppercase tracking-[0.15em] mb-5"
          style="color: var(--fg-muted);"
        >
          <span data-fr="Légal" data-en="Legal">Légal</span>
        </h3>
        <ul class="space-y-3">
          {
            [
              {
                label: "Confidentialité",
                labelEn: "Privacy",
                href: "/legal/privacy",
              },
              {
                label: "Conditions générales",
                labelEn: "Terms",
                href: "/legal/terms",
              },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm no-underline transition-colors duration-200 hover-link"
                  style="color: var(--fg-secondary);"
                >
                  <span data-fr={link.label} data-en={link.labelEn}>
                    {link.label}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div
    class="container-page py-6 flex flex-col sm:flex-row items-center justify-between gap-4"
    style="border-top: 1px solid var(--border);"
  >
    <div class="flex items-center gap-2">
      <img
        src="/favicon.svg"
        alt=""
        class="h-4 w-4"
        style="filter: invert(var(--logo-invert, 0));"
      />
      <img
        src="/Logo.svg"
        alt="Logo"
        class="h-2.5 w-auto"
        style="filter: invert(var(--logo-invert, 0));"
      />
      <span class="text-xs" style="color: var(--fg-muted);"
        ><span
          data-fr={`© ${year} ${profileName}. Tous droits réservés.`}
          data-en={`© ${year} ${profileName}. All rights reserved.`}
          >© {year} {profileName}. Tous droits réservés.</span
        ></span
      >
    </div>
    <span
      class="text-[10px] font-mono uppercase tracking-widest"
      style="color: var(--fg-muted);"
      ><span data-fr="Fait avec soin" data-en="Made with care">
        Fait avec soin
      </span></span
    >
  </div>
</footer>
