---
// ThinkingProcess — animated visualization of the creative thinking process
// Shows: Brief → Multiple Approaches → Converged Solution
// Uses pure CSS animations, no GSAP, no overflow issues
---

<div class="tp" aria-label="Processus créatif">
  <!-- The Brief -->
  <div class="tp-brief animate-in">
    <div class="tp-node">
      <span class="tp-num">01</span>
      <span class="tp-title">Le Brief</span>
    </div>
  </div>

  <!-- Branching lines (desktop only) -->
  <div class="tp-branches">
    <svg class="tp-svg" viewBox="0 0 800 100" fill="none" aria-hidden="true">
      <line x1="400" y1="0" x2="100" y2="100" class="tp-line tp-line--1" />
      <line x1="400" y1="0" x2="300" y2="100" class="tp-line tp-line--2" />
      <line x1="400" y1="0" x2="500" y2="100" class="tp-line tp-line--3" />
      <line x1="400" y1="0" x2="700" y2="100" class="tp-line tp-line--4" />
    </svg>
  </div>

  <!-- 4 Approaches -->
  <div class="tp-approaches">
    <div class="tp-card animate-in" style="--delay: 0.2s">
      <div class="tp-card-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </div>
      <span class="tp-card-title">Recherche</span>
      <span class="tp-card-desc">Références, tendances, contexte du marché</span>
    </div>
    <div class="tp-card animate-in" style="--delay: 0.35s">
      <div class="tp-card-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48 2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48 2.83-2.83"/></svg>
      </div>
      <span class="tp-card-title">Idéation</span>
      <span class="tp-card-desc">Sketches, brainstorming, premières pistes</span>
    </div>
    <div class="tp-card animate-in" style="--delay: 0.5s">
      <div class="tp-card-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
      </div>
      <span class="tp-card-title">Prototypage</span>
      <span class="tp-card-desc">Maquettes, wireframes, tests rapides</span>
    </div>
    <div class="tp-card animate-in" style="--delay: 0.65s">
      <div class="tp-card-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 12a9 9 0 0 1-9 9m9-9a9 9 0 0 0-9-9m9 9H3m9 9a9 9 0 0 1-9-9m9 9c1.66 0 3-4.03 3-9s-1.34-9-3-9m0 18c-1.66 0-3-4.03-3-9s1.34-9 3-9"/></svg>
      </div>
      <span class="tp-card-title">Itération</span>
      <span class="tp-card-desc">Tests utilisateurs, retours, ajustements</span>
    </div>
  </div>

  <!-- Converging lines (desktop only) -->
  <div class="tp-branches tp-branches--down">
    <svg class="tp-svg" viewBox="0 0 800 100" fill="none" aria-hidden="true">
      <line x1="100" y1="0" x2="400" y2="100" class="tp-line tp-line--c1" />
      <line x1="300" y1="0" x2="400" y2="100" class="tp-line tp-line--c2" />
      <line x1="500" y1="0" x2="400" y2="100" class="tp-line tp-line--c3" />
      <line x1="700" y1="0" x2="400" y2="100" class="tp-line tp-line--c4" />
    </svg>
  </div>

  <!-- The Solution -->
  <div class="tp-solution animate-in" style="--delay: 0.8s">
    <div class="tp-node tp-node--solution">
      <span class="tp-num">02</span>
      <span class="tp-title">La Solution</span>
      <span class="tp-subtitle">Direction créative validée</span>
    </div>
  </div>
</div>

<style>
  .tp {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding: 1rem 0 0;
  }

  /* ── Nodes ── */
  .tp-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.75rem 2.5rem;
    border: 1px solid var(--border);
    background: var(--bg);
    position: relative;
  }
  .tp-node--solution {
    border-color: var(--fg);
  }
  .tp-num {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    color: var(--fg-muted);
  }
  .tp-title {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--fg);
  }
  .tp-subtitle {
    font-size: 0.6875rem;
    color: var(--fg-muted);
  }

  /* ── Branch SVG ── */
  .tp-branches {
    width: 100%;
    max-width: 700px;
    height: 60px;
  }
  .tp-branches--down {
    height: 60px;
  }
  .tp-svg {
    width: 100%;
    height: 100%;
  }
  .tp-line {
    stroke: var(--border);
    stroke-width: 1;
    stroke-dasharray: 6 4;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .tp.is-active .tp-line {
    opacity: 1;
    animation: tp-dash 1.2s linear infinite;
  }
  @keyframes tp-dash {
    0% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -20; }
  }

  /* ── Approach Cards ── */
  .tp-approaches {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    width: 100%;
    max-width: 700px;
  }
  .tp-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    padding: 1rem 0.5rem;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    transition: border-color 0.3s ease, background 0.3s ease, transform 0.3s var(--ease-out-expo);
  }
  .tp-card:hover {
    border-color: var(--border-hover);
    background: var(--bg-overlay);
    transform: translateY(-2px);
  }
  .tp-card-icon {
    color: var(--fg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    background: var(--bg);
  }
  .tp-card:hover .tp-card-icon {
    color: var(--fg);
    border-color: var(--border-hover);
  }
  .tp-card-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg);
  }
  .tp-card-desc {
    font-size: 0.625rem;
    line-height: 1.5;
    color: var(--fg-muted);
    max-width: 160px;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .tp-branches,
    .tp-branches--down {
      display: none;
    }
    .tp-approaches {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
    .tp {
      gap: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .tp-approaches {
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }
    .tp-node {
      padding: 0.5rem 1.5rem;
    }
    .tp-card {
      padding: 0.75rem 0.375rem;
    }
    .tp-card-desc {
      font-size: 0.5625rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tp-line {
      animation: none !important;
      opacity: 1;
    }
  }
</style>

<script>
  function initTP() {
    document.querySelectorAll('.tp').forEach((el) => {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              el.classList.add('is-active');
              obs.unobserve(el);
            }
          });
        },
        { threshold: 0.15 }
      );
      obs.observe(el);
    });
  }
  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initTP)
    : initTP();
</script>
