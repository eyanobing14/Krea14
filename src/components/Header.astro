---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { label: 'Accueil', labelEn: 'Home', href: '/' },
  { label: 'Work', labelEn: 'Work', href: '/work' },
  { label: 'À propos', labelEn: 'About', href: '/about' },
  { label: 'Contact', labelEn: 'Contact', href: '/contact' },
  { label: 'Admin', labelEn: 'Admin', href: '/admin' },
];

const currentPath = Astro.url.pathname;
---

<!-- Mobile backdrop -->
<div
  id="mobile-backdrop"
  class="md:hidden"
  aria-hidden="true"
></div>

<header id="site-header" class="site-header fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <div class="container-page flex items-center justify-between h-14 md:h-16">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 no-underline group">
      <div class="w-7 h-7 flex items-center justify-center transition-colors duration-300" style="background: var(--fg);">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 12L6.5 4L10 8L13 2" stroke="var(--bg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>          <span class="text-sm font-semibold tracking-tight hidden sm:block" style="color: var(--fg);" data-fr="Portfolio" data-en="Portfolio">Portfolio</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Navigation principale">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'px-3 py-1.5 text-sm no-underline transition-colors duration-200',
            currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) ? 'font-medium' : ''
          ]}
          style={currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
            ? 'color: var(--fg);'
            : 'color: var(--fg-secondary);'}
        >
          <span data-fr={link.label} data-en={link.labelEn}>{link.label}</span>
        </a>
      ))}
    </nav>

    <!-- Desktop CTA -->
    <div class="hidden md:flex items-center gap-4">
      <button id="lang-toggle" class="lang-toggle" aria-label="Changer de langue">
        <span class="lang-active">FR</span>
      </button>
      <ThemeToggle />
      <a href="/contact" class="text-sm font-medium px-5 py-2 no-underline transition-all duration-200" style="background: var(--fg); color: var(--bg);" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
        <span data-fr="Contact" data-en="Contact">Contact</span>
      </a>
    </div>

    <!-- Mobile toggle -->
    <div class="md:hidden flex items-center gap-1">
      <button id="lang-toggle-mobile" class="lang-toggle" aria-label="Changer de langue">
        <span class="lang-active">FR</span>
      </button>
      <ThemeToggle />
      <button
        id="mobile-menu-toggle"
        class="mobile-burger"
        aria-label="Menu"
        aria-expanded="false"
      >
        <span id="line-1"></span>
        <span id="line-2"></span>
        <span id="line-3"></span>
      </button>
    </div>
  </div>

  <!-- Scroll progress bar -->
  <div id="scroll-progress" class="scroll-progress"></div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="md:hidden">
    <nav
      class="container-page py-5 flex flex-col gap-0.5"
      aria-label="Navigation mobile"
    >
      {navLinks.map((link, i) => (
        <a
          href={link.href}
          class="mobile-menu-item text-base no-underline transition-colors duration-200 py-2.5"
          style={`color: var(--fg-secondary); --delay: ${i * 45}ms;`}
          onmouseover="this.style.color='var(--fg)'"
          onmouseout="this.style.color='var(--fg-secondary)'"
        >
          <span data-fr={link.label} data-en={link.labelEn}>{link.label}</span>
        </a>
      ))}
      <div
        class="mobile-menu-item flex flex-col gap-3 pt-4 mt-3"
        style={`border-top: 1px solid var(--border); --delay: ${navLinks.length * 45}ms;`}
      >
        <a href="/contact" class="text-sm font-medium px-5 py-3 text-center no-underline transition-all" style="background: var(--fg); color: var(--bg);"><span data-fr="Nous contacter" data-en="Get in touch">Nous contacter</span></a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Backdrop derrière le menu mobile */
  #mobile-backdrop {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgba(0, 0, 0, 0.5);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  #mobile-backdrop.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── Navbar glassmorphism ── */
  .site-header {
    background: transparent;
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled {
    background: rgba(0, 0, 0, 0.6);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    backdrop-filter: blur(20px) saturate(1.6);
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }
  [data-theme="light"] .site-header.is-scrolled {
    background: rgba(255, 255, 255, 0.65);
    border-bottom-color: rgba(0, 0, 0, 0.08);
  }

  .scroll-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 1px;
    background: var(--fg);
    transition: none;
    pointer-events: none;
  }

  /* Déroulé animé du menu mobile */
  #mobile-menu {
    position: fixed;
    top: 4rem;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--bg) !important;
    border-top: 1px solid transparent;
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-12px);
    z-index: 45;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      border-top-color 0.3s ease,
      visibility 0s linear 0.45s;
  }
  #mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    border-top-color: var(--border);
    background: var(--bg) !important;
    transition:
      opacity 0.3s ease,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      border-top-color 0.3s ease;
  }

  /* Cascade des liens quand le menu s'ouvre */
  #mobile-menu .mobile-menu-item {
    opacity: 0;
    transform: translateY(-10px);
    transition:
      opacity 0.35s ease,
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0ms;
  }
  #mobile-menu.is-open .mobile-menu-item {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(--delay, 0ms);
  }

  .mobile-burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 36px;
    height: 36px;
    gap: 5px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .mobile-burger span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--fg);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s;
    transform-origin: center;
  }
  .mobile-burger.is-open #line-1 {
    transform: translateY(6.5px) rotate(45deg);
  }
  .mobile-burger.is-open #line-2 {
    opacity: 0;
  }
  .mobile-burger.is-open #line-3 {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* Language toggle */
  .lang-toggle {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--fg-secondary);
    background: transparent;
    border: 1px solid var(--border);
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
    line-height: 1;
  }
  .lang-toggle:hover {
    color: var(--fg);
    border-color: var(--border-hover);
  }
</style>

<script>
  import { T } from '../translations';
  function init() {
    const header = document.getElementById('site-header');
    if (!header) return;

    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('mobile-backdrop');

    let menuOpen = false;

    const progressBar = document.getElementById('scroll-progress');

    function updateHeader() {
      if (menuOpen) {
        header.classList.remove('is-scrolled');
      } else if (window.scrollY > 60) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
      // Progress bar: fill width based on scroll %
      if (progressBar) {
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const pct = docHeight > 0 ? Math.min((window.scrollY / docHeight) * 100, 100) : 0;
        progressBar.style.width = pct + '%';
      }
    }

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(() => { updateHeader(); ticking = false; }); ticking = true; }
    });

    window.addEventListener('themechange', () => {
      requestAnimationFrame(updateHeader);
    });

    function setMenu(next: boolean) {
      menuOpen = next;
      toggle?.setAttribute('aria-expanded', String(menuOpen));
      toggle?.classList.toggle('is-open', menuOpen);
      menu?.classList.toggle('is-open', menuOpen);
      backdrop?.classList.toggle('is-visible', menuOpen);
      // Bloquer le scroll du body quand le menu est ouvert
      document.body.style.overflow = menuOpen ? 'hidden' : '';
      updateHeader();
    }

    toggle?.addEventListener('click', () => setMenu(!menuOpen));

    backdrop?.addEventListener('click', () => setMenu(false));

    menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuOpen) setMenu(false);
    });

    // Fermer le menu si on repasse en desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && menuOpen) setMenu(false);
    });

    updateHeader();

    // Language toggle — full page translation
    const langBtn = document.getElementById('lang-toggle');
    const langBtnMobile = document.getElementById('lang-toggle-mobile');
    let currentLang = localStorage.getItem('lang') || 'fr';

    // Translation dictionary imported from translations.ts (bundled by Vite)
    const Trev: Record<string, string> = {};
    for (const [key, val] of Object.entries(T)) {
      Trev[val] = key;
    }

    // Normalize whitespace for matching
    function norm(s: string): string {
      return s.replace(/\s+/g, ' ').trim();
    }

    function applyLang(lang: string) {
      currentLang = lang;
      localStorage.setItem('lang', lang);
      document.documentElement.lang = lang === 'fr' ? 'fr' : 'en';
      document.querySelectorAll('.lang-active').forEach(el => {
        el.textContent = lang === 'fr' ? 'FR' : 'EN';
      });
      // data-fr/data-en attributes (reliable, exact match)
      document.querySelectorAll('[data-fr]').forEach(el => {
        const fr = (el as HTMLElement).dataset.fr;
        const en = (el as HTMLElement).dataset.en;
        if (fr && en) el.textContent = lang === 'fr' ? fr : en;
      });
      // Walk ALL text nodes in the document and translate them
      const dict = lang === 'fr' ? Trev : T;
      const sortedKeys = Object.keys(dict).sort((a, b) => b.length - a.length);
      // Only skip elements that are inside scripts, styles, or the header lang toggle area
      const skipTags = new Set(['SCRIPT', 'STYLE', 'SVG', 'SELECT']);
      const walker = document.createTreeWalker(
        document.querySelector('main') || document.body,
        NodeFilter.SHOW_TEXT,
        {
          acceptNode(node) {
            const parent = node.parentElement;
            if (!parent) return NodeFilter.FILTER_REJECT;
            if (skipTags.has(parent.tagName)) return NodeFilter.FILTER_REJECT;
            if (parent.closest('[data-fr]')) return NodeFilter.FILTER_REJECT;
            if (parent.closest('.lang-active')) return NodeFilter.FILTER_REJECT;
            if (parent.closest('.hero-scroll-text') || parent.closest('.about-marquee-track')) return NodeFilter.FILTER_REJECT;
            const raw = node.textContent || '';
            const cleaned = norm(raw);
            if (!cleaned) return NodeFilter.FILTER_REJECT;
            // Exact match
            if (dict[cleaned]) return NodeFilter.FILTER_ACCEPT;
            // Partial match: the text node contains a dictionary key
            for (const key of sortedKeys) {
              if (cleaned.includes(key)) return NodeFilter.FILTER_ACCEPT;
            }
            return NodeFilter.FILTER_REJECT;
          }
        }
      ) as TreeWalker;
      const nodes: Text[] = [];
      while (walker.nextNode()) nodes.push(walker.currentNode as Text);
      for (const textNode of nodes) {
        const raw = textNode.textContent || '';
        let result = norm(raw);
        // Skip category text that's not in the dictionary
        if (!result) continue;
        // Exact match first
        if (dict[result]) {
          textNode.textContent = dict[result];
          continue;
        }
        // Partial match: replace longest keys first
        for (const key of sortedKeys) {
          if (result.includes(key)) {
            result = result.split(key).join(dict[key]);
          }
        }
        if (result !== norm(raw)) {
          textNode.textContent = result;
        }
      }
    }

    langBtn?.addEventListener('click', () => {
      localStorage.setItem('lang', currentLang === 'fr' ? 'en' : 'fr');
      location.reload();
    });
    langBtnMobile?.addEventListener('click', () => {
      localStorage.setItem('lang', currentLang === 'fr' ? 'en' : 'fr');
      location.reload();
    });

    applyLang(currentLang);
  }
  document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', init) : init();
</script>
