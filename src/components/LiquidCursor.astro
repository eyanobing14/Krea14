---
// Cursor — Awwwards-style: dot + ring + glow blob
// Visible in both dark and light modes with proper illumination
//
// Deux règles à ne jamais casser :
// 1. Layout.astro masque le curseur natif dès que `(pointer: fine)` est vrai. Ce composant
//    doit donc tourner sur exactement la même condition (`fine`), sinon une machine se
//    retrouve sans aucun pointeur. Le test est suivi en direct (voir `sync()`), pas figé au chargement.
// 2. `prefers-reduced-motion: reduce` n'éteint plus le curseur : il passe en mode « static »,
//    point + anneau collés au pointeur, sans inertie, sans glow et sans état de survol.
//    L'identité visuelle reste, l'animation part.
---

<div id="cursor-dot" class="cursor-dot" aria-hidden="true"></div>
<div id="cursor-ring" class="cursor-ring" aria-hidden="true"></div>
<div id="cursor-glow" class="cursor-glow" aria-hidden="true"></div>

<style>
  .cursor-dot,
  .cursor-ring,
  .cursor-glow {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 2147483647;
    /* Position écrite dans `translate` (calculée par le compositeur), centrage et scale
       restent dans `transform` : les deux propriétés se composent, dans cet ordre. */
    will-change: translate, transform;
    transform: translate(-50%, -50%);
  }

  /* Révélés par le JS une fois positionnés : évite le flash en haut à gauche avant la 1re frame */
  .cursor-dot,
  .cursor-ring {
    opacity: 0;
  }
  .cursor-dot.is-on,
  .cursor-ring.is-on {
    opacity: 1;
  }

  .cursor-dot.is-off,
  .cursor-ring.is-off,
  .cursor-glow.is-off {
    display: none;
  }

  .cursor-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cursor-fg);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cursor-dot.is-hovering {
    transform: translate(-50%, -50%) scale(0.4);
  }
  .cursor-dot.is-text-hover {
    transform: translate(-50%, -50%) scale(0);
  }

  .cursor-ring {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--cursor-fg);
    transition:
      width 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      height 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s ease,
      background 0.3s ease;
  }
  .cursor-ring.is-hovering {
    width: 64px;
    height: 64px;
    background: var(--cursor-hover-bg);
  }
  .cursor-ring.is-clicking {
    width: 32px;
    height: 32px;
  }
  .cursor-ring.is-text-hover {
    width: 80px;
    height: 80px;
    border-color: transparent;
    background: var(--cursor-hover-bg);
  }

  .cursor-glow {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    opacity: 0;
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      width 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      height 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    background: radial-gradient(
      circle,
      var(--glow-inner) 0%,
      var(--glow-mid) 35%,
      transparent 70%
    );
  }
  .cursor-glow.is-active {
    opacity: 1;
  }
  .cursor-glow.is-hovering {
    width: 420px;
    height: 420px;
  }

  /* Repli avant JS (et si le JS est bloqué) : pas de pointeur custom sans souris */
  @media (pointer: coarse) {
    .cursor-dot,
    .cursor-ring,
    .cursor-glow {
      display: none;
    }
  }
</style>

<script>
  function initCursor() {
    const dot = document.getElementById("cursor-dot");
    const ring = document.getElementById("cursor-ring");
    const glow = document.getElementById("cursor-glow");
    if (!dot || !ring || !glow) return;

    // Même condition que le CSS de Layout.astro qui masque le curseur natif.
    const fine = window.matchMedia("(pointer: fine)");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

    const startX = window.innerWidth / 2;
    const startY = window.innerHeight / 2;
    let mouseX = startX;
    let mouseY = startY;
    let dotX = startX;
    let dotY = startY;
    let ringX = startX;
    let ringY = startY;
    let glowX = startX;
    let glowY = startY;

    let enabled = fine.matches; // souris disponible ?
    let smooth = !reduce.matches; // animation autorisée ?
    let firstFrame = false;

    const interactiveSelectors =
      'a, button, summary, [role="button"], input, textarea, select, label, [data-cursor-hover]';
    const textSelectors = "h1, h2, h3, h4, p, span, li, blockquote, .code-block";

    function onMediaChange(mq, handler) {
      if (mq.addEventListener) mq.addEventListener("change", handler);
      else mq.addListener(handler);
    }

    function syncVisibility() {
      dot.classList.toggle("is-on", enabled);
      ring.classList.toggle("is-on", enabled);
      dot.classList.toggle("is-off", !enabled);
      ring.classList.toggle("is-off", !enabled);
      glow.classList.toggle("is-off", !enabled);
      glow.classList.toggle("is-active", enabled && smooth);
      if (!enabled || !smooth) {
        dot.classList.remove("is-hovering", "is-text-hover");
        ring.classList.remove("is-hovering", "is-text-hover", "is-clicking");
      }
    }

    // Brancher/débrancher une souris ou changer la préférence d'animation ne doit pas
    // demander un rechargement de page.
    function sync() {
      enabled = fine.matches;
      smooth = !reduce.matches;
      if (firstFrame) syncVisibility();
    }
    onMediaChange(fine, sync);
    onMediaChange(reduce, sync);

    document.addEventListener("mousemove", (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    document.addEventListener("mousedown", () => {
      if (enabled && smooth) ring.classList.add("is-clicking");
    });
    document.addEventListener("mouseup", () => ring.classList.remove("is-clicking"));

    document.addEventListener("mouseover", (e) => {
      if (!enabled || !smooth) return;
      const target = (e.target as HTMLElement).closest(interactiveSelectors);
      if (target) {
        ring.classList.add("is-hovering");
        dot.classList.add("is-hovering");
        glow.classList.add("is-hovering");
        ring.classList.remove("is-text-hover");
        dot.classList.remove("is-text-hover");
        return;
      }
      const textTarget = (e.target as HTMLElement).closest(textSelectors);
      if (textTarget) {
        ring.classList.add("is-text-hover");
        dot.classList.add("is-text-hover");
        ring.classList.remove("is-hovering");
        dot.classList.remove("is-hovering");
        glow.classList.remove("is-hovering");
      }
    });

    document.addEventListener("mouseout", (e) => {
      if (!enabled || !smooth) return;
      const target = e.target as HTMLElement;
      const relatedTarget = e.relatedTarget as Node | null;
      const currentInteractive = target.closest(interactiveSelectors);
      const currentText = target.closest(textSelectors);
      if (
        (currentInteractive && !currentInteractive.contains(relatedTarget)) ||
        (currentText && !currentText.contains(relatedTarget))
      ) {
        ring.classList.remove("is-hovering");
        dot.classList.remove("is-hovering");
        glow.classList.remove("is-hovering");
      }
    });

    document.addEventListener("mouseleave", () => {
      if (enabled && smooth) glow.classList.remove("is-active");
    });
    document.addEventListener("mouseenter", () => {
      if (enabled && smooth) glow.classList.add("is-active");
    });

    let lastTime = 0;

    function animate(now) {
      const dt = lastTime ? Math.min((now - lastTime) / 1000, 0.1) : 1 / 60;
      lastTime = now;
      // Normalisation par le temps : même ressenti en 60, 120 ou 144 Hz.
      // (à 60 Hz le facteur vaut 1, soit exactement le comportement d'origine)
      const frames = dt * 60;
      const ease = (base) => (smooth ? 1 - Math.pow(1 - base, frames) : 1);

      dotX += (mouseX - dotX) * (smooth ? ease(0.35) : 1);
      dotY += (mouseY - dotY) * (smooth ? ease(0.35) : 1);

      ringX += (mouseX - ringX) * (smooth ? ease(0.12) : 1);
      ringY += (mouseY - ringY) * (smooth ? ease(0.12) : 1);

      if (smooth) {
        glowX += (mouseX - glowX) * ease(0.06);
        glowY += (mouseY - glowY) * ease(0.06);
      }

      dot.style.setProperty("translate", `${dotX}px ${dotY}px`);
      ring.style.setProperty("translate", `${ringX}px ${ringY}px`);
      if (smooth) glow.style.setProperty("translate", `${glowX}px ${glowY}px`);

      if (!firstFrame) {
        firstFrame = true;
        syncVisibility();
      }

      requestAnimationFrame(animate);
    }
    requestAnimationFrame(animate);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCursor);
  } else {
    initCursor();
  }
</script>
