---
// CTA — theme-aware
---

<section id="cta" class="section">
  <div class="container-page">
    <div class="relative p-8 md:p-16 text-center" style="border: 1px solid var(--border);">
      <span class="label">Commencer</span>
      <h2 class="mt-6 text-3xl md:text-4xl lg:text-5xl font-bold leading-[1.05] tracking-[-0.02em]" style="color: var(--fg);">
        Commencez à construire<br class="hidden sm:inline" /> dès aujourd'hui.
      </h2>
      <p class="mt-4 text-base max-w-xl mx-auto leading-relaxed" style="color: var(--fg-secondary);">
        L'offre gratuite comprend 10 backtests par mois, le paper trading et l'accès
        à 5 ans de données historiques. Sans carte de crédit.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="#" class="inline-flex items-center gap-2 px-6 py-3 text-sm font-medium no-underline transition-all duration-200" style="background: var(--fg); color: var(--bg);" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
          Créer un compte gratuit
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M2 7H12M8 3L12 7L8 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="#" class="inline-flex items-center gap-2 px-6 py-3 text-sm no-underline transition-all duration-200" style="color: var(--fg-secondary); border: 1px solid var(--border-strong);" onmouseover="this.style.color='var(--fg)'; this.style.borderColor='var(--fg-muted)'" onmouseout="this.style.color='var(--fg-secondary)'; this.style.borderColor='var(--border-strong)'">
          Parler aux ventes
        </a>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4 md:gap-6 text-xs" style="color: var(--fg-muted);">
        <span>Plans entreprise disponibles</span>
        <span class="hidden sm:inline">·</span>
        <span>Conforme SOC 2</span>
        <span class="hidden sm:inline">·</span>
        <span>Prêt RGPD</span>
      </div>
    </div>
  </div>
</section>
