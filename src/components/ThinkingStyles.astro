</style>

<script>
  function initTsAccordion() {
    const items = document.querySelectorAll(".ts-item");

    items.forEach((details) => {
      details.querySelector("summary")?.addEventListener("click", (event) => {
        event.preventDefault();
        const isOpen = (details as HTMLDetailsElement).open;

        items.forEach((other) => {
          (other as HTMLDetailsElement).open = false;
        });

        if (!isOpen) {
          (details as HTMLDetailsElement).open = true;
        }
      });

      details.addEventListener("toggle", () => {
        if ((details as HTMLDetailsElement).open) {
          items.forEach((other) => {
            if (other !== details) (other as HTMLDetailsElement).open = false;
          });
        }
      });
    });
  }
  document.readyState === "loading"
    ? document.addEventListener("DOMContentLoaded", initTsAccordion)
    : initTsAccordion();
</script>
