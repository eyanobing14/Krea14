---
// ThinkingStyles — Collapsible dropdown cards with animated illustrations
// Layering: low-contrast first, high-contrast last
// Animations restart on each dropdown open
import Container from "./Container.astro";
---

<section class="section">
  <Container>
    <h2
      class="text-2xl sm:text-3xl md:text-4xl font-bold text-center animate-in"
      style="color: var(--fg);"
    >
      Plusieurs façons de penser.
    </h2>
    <p
      class="mt-4 text-center text-base sm:text-lg max-w-2xl mx-auto animate-in"
      style="color: var(--fg-secondary); --delay: 0.1s;"
    >
      Nous ne sommes pas qu'un seul profil. Chaque projet mobilise différentes
      facettes de notre approche créative.
    </p>

    <div class="ts-list mt-12">
      <!-- 01 Design Thinking — Lightbulb -->
      <details class="ts-item animate-in" data-illust="bulb" style="--delay: 0.15s;">
        <summary class="ts-summary">
          <div class="ts-summary-left">
            <div class="ts-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"/></svg>
            </div>
            <div class="ts-text">
              <span class="ts-tag">01</span>
              <span class="ts-title">Design Thinking</span>
            </div>
          </div>
          <svg class="ts-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="ts-body">
          <div class="ts-illustration">
            <svg viewBox="0 0 160 100" fill="none" class="illust">
              <!-- Layer 1: Inner glow (lowest) -->
              <circle cx="80" cy="42" r="18" fill="var(--fg-muted)" opacity="0" class="anim-el glow"/>
              <!-- Layer 2: Rays (background) -->
              <line x1="80" y1="4" x2="80" y2="10" stroke="var(--fg-muted)" stroke-width="1" opacity="0" class="anim-el ray r1"/>
              <line x1="38" y1="22" x2="43" y2="27" stroke="var(--fg-muted)" stroke-width="0.75" opacity="0" class="anim-el ray r2"/>
              <line x1="122" y1="22" x2="117" y2="27" stroke="var(--fg-muted)" stroke-width="0.75" opacity="0" class="anim-el ray r3"/>
              <line x1="30" y1="46" x2="38" y2="46" stroke="var(--fg-muted)" stroke-width="0.5" opacity="0" class="anim-el ray r4"/>
              <line x1="130" y1="46" x2="122" y2="46" stroke="var(--fg-muted)" stroke-width="0.5" opacity="0" class="anim-el ray r5"/>
              <!-- Layer 3: Bulb base (low contrast) -->
              <line x1="62" y1="70" x2="98" y2="70" stroke="var(--fg-muted)" stroke-width="1" class="anim-el"/>
              <line x1="66" y1="75" x2="94" y2="75" stroke="var(--fg-muted)" stroke-width="1" class="anim-el"/>
              <path d="M72 75 L72 82 L88 82 L88 75" stroke="var(--fg-muted)" stroke-width="1" class="anim-el"/>
              <!-- Layer 4: Bulb outline (high contrast, on top) -->
              <path d="M80 12 C58 12, 46 32, 46 45 C46 56, 58 62, 62 68 L98 68 C102 62, 114 56, 114 45 C114 32, 102 12, 80 12Z" stroke="var(--fg)" stroke-width="1.5" fill="none" class="anim-el bulb"/>
            </svg>
          </div>
          <p>Placer l'humain au centre. Observer, empathiser, prototyper rapidement. Valider avant de construire.</p>
          <div class="ts-keywords">
            <span>Empathie</span><span>Wireframe</span><span>Test</span>
          </div>
        </div>
      </details>

      <!-- 02 Pensée Stratégique — Grid -->
      <details class="ts-item animate-in" data-illust="grid" style="--delay: 0.25s;">
        <summary class="ts-summary">
          <div class="ts-summary-left">
            <div class="ts-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 20h20M5 20V8l7-6 7 6v12M9 20v-6h6v6"/></svg>
            </div>
            <div class="ts-text">
              <span class="ts-tag">02</span>
              <span class="ts-title">Pensée Stratégique</span>
            </div>
          </div>
          <svg class="ts-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="ts-body">
          <div class="ts-illustration">
            <svg viewBox="0 0 160 100" fill="none" class="illust">
              <!-- Layer 1: Grid (background, lowest contrast) -->
              <rect x="28" y="6" width="104" height="82" rx="2" stroke="var(--border)" stroke-width="0.5" fill="none" class="anim-el"/>
              <line x1="54" y1="6" x2="54" y2="88" stroke="var(--border)" stroke-width="0.5" class="anim-el"/>
              <line x1="80" y1="6" x2="80" y2="88" stroke="var(--border)" stroke-width="0.5" class="anim-el"/>
              <line x1="106" y1="6" x2="106" y2="88" stroke="var(--border)" stroke-width="0.5" class="anim-el"/>
              <line x1="28" y1="28" x2="132" y2="28" stroke="var(--border)" stroke-width="0.5" class="anim-el"/>
              <line x1="28" y1="50" x2="132" y2="50" stroke="var(--border)" stroke-width="0.5" class="anim-el"/>
              <line x1="28" y1="72" x2="132" y2="72" stroke="var(--border)" stroke-width="0.5" class="anim-el"/>
              <!-- Layer 2: Arrows (low contrast) -->
              <line x1="45" y1="78" x2="63" y2="66" stroke="var(--fg-muted)" stroke-width="0.75" stroke-dasharray="2 2" class="anim-el arrow a1"/>
              <line x1="71" y1="60" x2="89" y2="46" stroke="var(--fg-muted)" stroke-width="0.75" stroke-dasharray="2 2" class="anim-el arrow a2"/>
              <line x1="97" y1="38" x2="115" y2="24" stroke="var(--fg-secondary)" stroke-width="0.75" stroke-dasharray="2 2" class="anim-el arrow a3"/>
              <!-- Layer 3: Step dots (medium contrast) -->
              <circle cx="40" cy="82" r="5" stroke="var(--fg-muted)" stroke-width="1" fill="none" class="anim-el step s-a"/>
              <circle cx="66" cy="64" r="5" stroke="var(--fg-muted)" stroke-width="1" fill="none" class="anim-el step s-b"/>
              <!-- Layer 4: Goal dot (highest contrast) -->
              <circle cx="92" cy="42" r="5" stroke="var(--fg)" stroke-width="1.5" fill="none" class="anim-el step s-c"/>
              <circle cx="120" cy="20" r="5" stroke="var(--fg)" stroke-width="1.5" fill="var(--fg)" opacity="0.15" class="anim-el step s-d"/>
            </svg>
          </div>
          <p>Comprendre le marché, la concurrence, les objectifs business. Chaque choix visuel a un impact mesurable.</p>
          <div class="ts-keywords">
            <span>Positionnement</span><span>Objectifs</span><span>Métriques</span>
          </div>
        </div>
      </details>

      <!-- 03 Créativité Visuelle — Palette -->
      <details class="ts-item animate-in" data-illust="palette" style="--delay: 0.35s;">
        <summary class="ts-summary">
          <div class="ts-summary-left">
            <div class="ts-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            </div>
            <div class="ts-text">
              <span class="ts-tag">03</span>
              <span class="ts-title">Créativité Visuelle</span>
            </div>
          </div>
          <svg class="ts-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="ts-body">
          <div class="ts-illustration">
            <svg viewBox="0 0 160 100" fill="none" class="illust">
              <!-- Layer 1: Brush stroke (background) -->
              <line x1="105" y1="12" x2="130" y2="35" stroke="var(--fg-muted)" stroke-width="0.75" class="anim-el brush-handle"/>
              <path d="M112 14 C118 22, 126 32, 132 26" stroke="var(--fg-muted)" stroke-width="2" stroke-linecap="round" fill="none" class="anim-el brush"/>
              <!-- Layer 2: Color dots (background, low contrast) -->
              <circle cx="52" cy="32" r="7" fill="var(--fg-muted)" opacity="0.1" class="anim-el color-dot c1"/>
              <circle cx="76" cy="28" r="7" fill="var(--fg-muted)" opacity="0.2" class="anim-el color-dot c2"/>
              <circle cx="100" cy="35" r="7" fill="var(--fg-muted)" opacity="0.3" class="anim-el color-dot c3"/>
              <circle cx="60" cy="56" r="7" fill="var(--fg-secondary)" opacity="0.25" class="anim-el color-dot c4"/>
              <circle cx="86" cy="58" r="7" fill="var(--fg-secondary)" opacity="0.35" class="anim-el color-dot c5"/>
              <!-- Layer 3: Palette outline (high contrast, on top) -->
              <ellipse cx="78" cy="46" rx="52" ry="36" stroke="var(--fg)" stroke-width="1.5" fill="none" class="anim-el palette"/>
            </svg>
          </div>
          <p>Explorer des directions inattendues. Typographie, couleur, composition — chaque pixel raconte une histoire.</p>
          <div class="ts-keywords">
            <span>Identité</span><span>Typo</span><span>Composition</span>
          </div>
        </div>
      </details>

      <!-- 04 Approche Technique — Terminal -->
      <details class="ts-item animate-in" data-illust="terminal" style="--delay: 0.45s;">
        <summary class="ts-summary">
          <div class="ts-summary-left">
            <div class="ts-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </div>
            <div class="ts-text">
              <span class="ts-tag">04</span>
              <span class="ts-title">Approche Technique</span>
            </div>
          </div>
          <svg class="ts-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="ts-body">
          <div class="ts-illustration">
            <svg viewBox="0 0 160 100" fill="none" class="illust">
              <!-- Layer 1: Terminal frame (background) -->
              <rect x="22" y="8" width="116" height="82" rx="5" stroke="var(--fg-muted)" stroke-width="1" fill="none" class="anim-el"/>
              <line x1="22" y1="24" x2="138" y2="24" stroke="var(--fg-muted)" stroke-width="0.5" class="anim-el"/>
              <circle cx="32" cy="16" r="2.5" fill="var(--fg-muted)" opacity="0.3" class="anim-el"/>
              <circle cx="40" cy="16" r="2.5" fill="var(--fg-muted)" opacity="0.3" class="anim-el"/>
              <circle cx="48" cy="16" r="2.5" fill="var(--fg-muted)" opacity="0.3" class="anim-el"/>
              <!-- Layer 2: Code lines (medium contrast) -->
              <text x="32" y="42" fill="var(--fg-muted)" font-size="8" font-family="var(--font-mono)" class="anim-el code-line cl1">&lt;Component /&gt;</text>
              <text x="32" y="55" fill="var(--fg-secondary)" font-size="8" font-family="var(--font-mono)" class="anim-el code-line cl2">  render()</text>
              <text x="32" y="68" fill="var(--fg-muted)" font-size="8" font-family="var(--font-mono)" class="anim-el code-line cl3">  return view</text>
              <!-- Layer 3: Cursor (highest contrast, on top) -->
              <rect x="32" y="74" width="5" height="9" fill="var(--fg)" class="anim-el cursor-blink"/>
            </svg>
          </div>
          <p>Code propre et performant. Accessibilité, responsive, optimisation — la beauté ne s'arrête pas au maquettage.</p>
          <div class="ts-keywords">
            <span>Accessibilité</span><span>Performance</span><span>Clean code</span>
          </div>
        </div>
      </details>

      <!-- 05 Collaboration — People -->
      <details class="ts-item animate-in" data-illust="collab" style="--delay: 0.55s;">
        <summary class="ts-summary">
          <div class="ts-summary-left">
            <div class="ts-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="ts-text">
              <span class="ts-tag">05</span>
              <span class="ts-title">Collaboration</span>
            </div>
          </div>
          <svg class="ts-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="ts-body">
          <div class="ts-illustration">
            <svg viewBox="0 0 160 100" fill="none" class="illust">
              <!-- Layer 1: Connection sparkle (background) -->
              <circle cx="80" cy="38" r="2" fill="var(--fg-muted)" opacity="0" class="anim-el shared-sparkle sp1"/>
              <circle cx="80" cy="60" r="1.5" fill="var(--fg-muted)" opacity="0" class="anim-el shared-sparkle sp2"/>
              <!-- Layer 2: Connection line (low contrast) -->
              <line x1="70" y1="50" x2="90" y2="50" stroke="var(--fg-muted)" stroke-width="1" stroke-dasharray="3 2" class="anim-el conn-line"/>
              <!-- Layer 3: Right person (VOUS — lower contrast) -->
              <g class="anim-el person p-right">
                <circle cx="105" cy="46" r="22" stroke="var(--fg-muted)" stroke-width="1.5" fill="none"/>
                <circle cx="105" cy="38" r="6" stroke="var(--fg-muted)" stroke-width="1" fill="none"/>
                <path d="M89 62 C89 54, 121 54, 121 62" stroke="var(--fg-muted)" stroke-width="1" fill="none"/>
              </g>
              <!-- Layer 4: Left person (NOUS — higher contrast, on top) -->
              <g class="anim-el person p-left">
                <circle cx="55" cy="46" r="22" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
                <circle cx="55" cy="38" r="6" stroke="var(--fg-secondary)" stroke-width="1" fill="none"/>
                <path d="M39 62 C39 54, 71 54, 71 62" stroke="var(--fg-secondary)" stroke-width="1" fill="none"/>
              </g>
            </svg>
          </div>
          <p>Un projet réussi est un projet partagé. Communication transparente, retours itératifs, co-création avec l'équipe client.</p>
          <div class="ts-keywords">
            <span>Ateliers</span><span>Retours</span><span>Co-création</span>
          </div>
        </div>
      </details>
    </div>
  </Container>
</section>

<style>
  .ts-list {
    display: flex; flex-direction: column; gap: 0;
    max-width: 700px; margin-left: auto; margin-right: auto;
  }
  .ts-item {
    border: 1px solid var(--border); border-bottom: none;
    background: var(--bg); transition: border-color 0.3s;
  }
  .ts-item:last-child { border-bottom: 1px solid var(--border); }
  .ts-item[open] { border-color: var(--border-hover); }
  .ts-item[open] + .ts-item { border-top-color: var(--border-hover); }

  .ts-summary {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1rem 1.25rem; cursor: pointer;
    list-style: none; user-select: none; transition: background 0.2s;
  }
  .ts-summary::-webkit-details-marker { display: none; }
  .ts-summary::marker { display: none; content: ""; }
  .ts-summary:hover { background: var(--bg-raised); }

  .ts-summary-left { display: flex; align-items: center; gap: 0.75rem; }

  .ts-icon {
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--border); color: var(--fg-secondary);
    flex-shrink: 0; transition: color 0.3s, border-color 0.3s;
  }
  .ts-item[open] .ts-icon { color: var(--fg); border-color: var(--border-hover); }

  .ts-text { display: flex; flex-direction: column; gap: 0.125rem; }
  .ts-tag { font-family: var(--font-mono); font-size: 0.5625rem; color: var(--fg-muted); letter-spacing: 0.1em; }
  .ts-title { font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.03em; color: var(--fg); }

  .ts-chevron { color: var(--fg-muted); transition: transform 0.3s var(--ease-out-expo); flex-shrink: 0; }
  .ts-item[open] .ts-chevron { transform: rotate(180deg); }

  .ts-body { padding: 0 1.25rem 1.25rem 3.5rem; animation: ts-dropdown-in 0.3s var(--ease-out-expo); }
  .ts-body p { font-size: 0.8125rem; line-height: 1.7; color: var(--fg-secondary); }

  .ts-keywords { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-top: 0.75rem; }
  .ts-keywords span {
    font-family: var(--font-mono); font-size: 0.5625rem;
    letter-spacing: 0.05em; text-transform: uppercase;
    padding: 0.25rem 0.5rem; border: 1px solid var(--border); color: var(--fg-muted);
  }

  .ts-illustration { margin-bottom: 0.75rem; display: flex; justify-content: center; overflow: visible; }
  .illust { width: 100%; max-width: 280px; height: auto; overflow: visible; }

  @keyframes ts-dropdown-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }

  /* ── Animations (paused by default, played on open) ── */
  .anim-el { animation-play-state: paused; }
  .ts-item[open] .anim-el { animation-play-state: running; }

  /* Lightbulb */
  .ray { animation: ray-flash 2s ease-in-out infinite; }
  .r2 { animation-delay: 0.3s; } .r3 { animation-delay: 0.6s; } .r4 { animation-delay: 0.9s; } .r5 { animation-delay: 1.2s; }
  @keyframes ray-flash { 0%, 100% { opacity: 0; } 50% { opacity: 0.7; } }
  .glow { animation: glow-pulse 2s ease-in-out infinite; }
  @keyframes glow-pulse { 0%, 100% { opacity: 0; } 50% { opacity: 0.06; } }

  /* Grid */
  .step { animation: step-appear 0.4s ease forwards; opacity: 0; }
  .s-a { animation-delay: 0s; } .s-b { animation-delay: 0.3s; } .s-c { animation-delay: 0.6s; } .s-d { animation-delay: 0.9s; }
  @keyframes step-appear { from { opacity: 0; transform: scale(0.5); } to { opacity: 1; transform: scale(1); } }
  .arrow { animation: arrow-draw 0.3s ease forwards; stroke-dashoffset: 30; stroke-dasharray: 30; }
  .a1 { animation-delay: 0.2s; } .a2 { animation-delay: 0.5s; } .a3 { animation-delay: 0.8s; }
  @keyframes arrow-draw { to { stroke-dashoffset: 0; } }

  /* Palette */
  .color-dot { animation: color-pop 0.3s ease forwards; transform-origin: center; transform: scale(0); }
  .c1 { animation-delay: 0.1s; } .c2 { animation-delay: 0.25s; } .c3 { animation-delay: 0.4s; } .c4 { animation-delay: 0.55s; } .c5 { animation-delay: 0.7s; }
  @keyframes color-pop { from { transform: scale(0); } 60% { transform: scale(1.3); } to { transform: scale(1); } }
  .brush { stroke-dasharray: 40; stroke-dashoffset: 40; animation: brush-draw 0.8s ease 0.5s forwards; }
  @keyframes brush-draw { to { stroke-dashoffset: 0; } }

  /* Terminal */
  .code-line { opacity: 0; animation: code-type 0.3s ease forwards; }
  .cl1 { animation-delay: 0.1s; } .cl2 { animation-delay: 0.4s; } .cl3 { animation-delay: 0.7s; }
  @keyframes code-type { from { opacity: 0; } to { opacity: 1; } }
  .cursor-blink { animation: cursor-blink 1s step-end infinite; }
  @keyframes cursor-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

  /* Collaboration */
  .conn-line { stroke-dashoffset: 20; animation: conn-draw 1.5s ease-in-out infinite alternate; }
  @keyframes conn-draw { from { stroke-dashoffset: 20; } to { stroke-dashoffset: 0; } }
  .shared-sparkle { animation: sparkle-float 2s ease-in-out infinite; }
  .sp1 { animation-delay: 0s; } .sp2 { animation-delay: 1s; }
  @keyframes sparkle-float { 0%, 100% { opacity: 0; transform: translateY(0); } 50% { opacity: 0.6; transform: translateY(-3px); } }
  .person { animation: person-breathe 3s ease-in-out infinite alternate; }
  .p-right { animation-delay: 1.5s; }
  @keyframes person-breathe { from { stroke-width: 1.5; } to { stroke-width: 2; } }

  @media (max-width: 480px) {
    .ts-summary { padding: 0.75rem 1rem; }
    .ts-body { padding: 0 1rem 1rem 2.75rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ts-body { animation: none; }
    .ts-chevron { transition: none; }
    .anim-el { animation: none !important; animation-play-state: running !important; }
    .step, .code-line, .color-dot { opacity: 1; transform: scale(1); }
    .brush, .arrow { stroke-dashoffset: 0; }
  }
</style>

<script>
  function initTsAccordion() {
    const items = document.querySelectorAll('.ts-item');
    items.forEach((details) => {
      details.addEventListener('toggle', () => {
        if ((details as HTMLDetailsElement).open) {
          items.forEach((other) => {
            if (other !== details) (other as HTMLDetailsElement).open = false;
          });
          // Restart animations by cloning anim-el elements
          const animEls = details.querySelectorAll('.anim-el');
          animEls.forEach((el) => {
            const clone = el.cloneNode(true);
            el.parentNode?.replaceChild(clone, el);
          });
        }
      });
    });
  }
  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initTsAccordion)
    : initTsAccordion();
</script>
