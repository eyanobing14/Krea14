---
interface Props {
  text?: string;
  index: number;
  showNum?: boolean;
}

const { text = '', index, showNum = true } = Astro.props;

const t = text.toLowerCase();

let type = 'gear';
const rules: [RegExp, string][] = [
  [/analyse|espace *besoin|besoin|recherche|audit|briefing|mapping|douleur|retours *terrain|exigence/, 'magnifier'],
  [/base de donn|schema|sché|schéma|table|sqlite|postgre|modèle de donn|historique|snapshot|position/, 'database'],
  [/développ|developp|api|endpoint|crud|moteur|typescript|code|scoring|requête|fonction|endpoint/, 'code'],
  [/interface|dashboard|panneau|desktop|tauri|écran|compile/, 'interface'],
  [/synchronis|sync|push|pull|temps r(é|e)|realtime|websocket|socket|live/, 'sync'],
  [/test|vérif|verif|optimisation|performance|controle|contrôle|correcteur/, 'check'],
  [/déploy|deploy|production|seed|mise en ligne/, 'rocket'],
  [/contenu|éditeur|editor|plan|document|annonc|cms|publi|workflow/, 'document'],
  [/securit|sécurit|auth|jwt|hach|permission|audit|chiffr/, 'shield'],
];

for (const [re, ty] of rules) {
  if (re.test(t)) {
    type = ty;
    break;
  }
}

const icons: Record<string, string> = {
  magnifier: `
    <g class="sic-radar">
      <circle cx="20" cy="20" r="14" stroke="var(--fg)" stroke-width="1" stroke-dasharray="4 18" fill="none" opacity="0.5"/>
    </g>
    <circle cx="20" cy="20" r="9" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
    <circle cx="20" cy="20" r="3" fill="var(--fg)" opacity="0.12"/>
    <line x1="20" y1="12.5" x2="20" y2="15" stroke="var(--fg)" stroke-width="1.5" stroke-linecap="round"/>
    <line x1="28.5" y1="28.5" x2="38" y2="38" stroke="var(--fg-secondary)" stroke-width="2" stroke-linecap="round"/>
    <circle cx="14" cy="20" r="1.5" fill="var(--fg)" class="sic-scan"/>
  `,
  database: `
    <ellipse cx="24" cy="13" rx="12" ry="5" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
    <path d="M12 13 L12 24 M36 13 L36 24" stroke="var(--fg)" stroke-width="1.5"/>
    <ellipse cx="24" cy="24" rx="12" ry="5" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
    <path d="M12 24 L12 35 M36 24 L36 35" stroke="var(--fg)" stroke-width="1.5"/>
    <ellipse cx="24" cy="35" rx="12" ry="5" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
    <circle cx="28" cy="35" r="2" fill="var(--fg)" class="sic-cursor"/>
    <circle cx="12" cy="12" r="1.5" fill="var(--fg)" class="sic-flow"/>
  `,
  code: `
    <path d="M16.5 15 L9.5 24 L16.5 33" stroke="var(--fg)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M31.5 15 L38.5 24 L31.5 33" stroke="var(--fg)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    <line x1="25.5" y1="13" x2="22.5" y2="35" stroke="var(--fg-secondary)" stroke-width="1.5" stroke-linecap="round"/>
    <line x1="14" y1="40" x2="34" y2="40" stroke="var(--fg-muted)" stroke-width="1.5" stroke-linecap="round"/>
    <rect x="35" y="38.4" width="2.4" height="3.4" rx="0.6" fill="var(--fg)" class="sic-cursor"/>
  `,
  interface: `
    <rect x="8" y="10" width="32" height="28" rx="3" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
    <line x1="8" y1="17" x2="40" y2="17" stroke="var(--fg)" stroke-width="1.5"/>
    <circle cx="12.5" cy="13.5" r="1.2" fill="var(--fg-muted)"/>
    <circle cx="17.5" cy="13.5" r="1.2" fill="var(--fg-muted)" opacity="0.4"/>
    <circle cx="22.5" cy="13.5" r="1.2" fill="var(--fg-muted)" opacity="0.4"/>
    <rect x="12" y="20.5" width="13" height="5" rx="1" stroke="var(--fg-secondary)" stroke-width="1.25"/>
    <rect x="28" y="20.5" width="7" height="5" rx="1" stroke="var(--fg-muted)" stroke-width="1.25" opacity="0.5"/>
    <rect x="12" y="28.5" width="23" height="3" rx="1.5" fill="var(--fg-muted)" opacity="0.5"/>
    <rect x="12" y="33.5" width="16" height="3" rx="1.5" fill="var(--fg-muted)" opacity="0.3"/>
    <rect x="12" y="28.5" width="9" height="3" rx="1.5" fill="var(--fg)" class="sic-bar"/>
  `,
  sync: `
    <g class="sic-spin">
      <path d="M41 24 A17 17 0 1 1 33 13.5" stroke="var(--fg)" stroke-width="2" fill="none" stroke-linecap="round"/>
      <path d="M41 24 L41 19.5 L36.5 24 Z" fill="var(--fg)"/>
    </g>
    <g class="sic-spin-rev">
      <path d="M7 24 A17 17 0 1 1 15 34.5" stroke="var(--fg-muted)" stroke-width="2" fill="none" stroke-linecap="round"/>
      <path d="M7 24 L7 28.5 L11.5 24 Z" fill="var(--fg-muted)"/>
    </g>
  `,
  rocket: `
    <g class="sic-rocket">
      <path d="M24 6 C28 10 30 16 30 22 L24 26 L18 22 C18 16 20 10 24 6 Z" stroke="var(--fg)" stroke-width="1.5" fill="none" stroke-linejoin="round"/>
      <circle cx="24" cy="18" r="3.2" stroke="var(--fg-secondary)" stroke-width="1.5"/>
      <path d="M20 22 L15 28 L20 26 Z" fill="var(--fg)" opacity="0.4"/>
      <path d="M28 22 L33 28 L28 26 Z" fill="var(--fg)" opacity="0.4"/>
      <path d="M24 26 L22 31.5 L24 29.5 L26 31.5 Z" fill="var(--fg)" class="sic-flame"/>
    </g>
  `,
  check: `
    <circle cx="24" cy="24" r="15" stroke="var(--fg)" stroke-width="1.5" fill="none" opacity="0.15" class="sic-check-halo"/>
    <circle cx="24" cy="24" r="11" stroke="var(--fg-muted)" stroke-width="1.5" fill="none" opacity="0.4"/>
    <path d="M17 25 L22 30 L32 18" stroke="var(--fg)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" class="sic-draw"/>
  `,
  document: `
    <path d="M14 6 H27 L33 12 V41 H14 Z" stroke="var(--fg)" stroke-width="1.5" fill="none" stroke-linejoin="round"/>
    <path d="M27 6 V12 H33" stroke="var(--fg-secondary)" stroke-width="1.5" fill="none" stroke-linejoin="round"/>
    <rect x="18" y="18" width="12" height="2.5" rx="1.25" fill="var(--fg-muted)" opacity="0.5"/>
    <rect x="18" y="24" width="12" height="2.5" rx="1.25" fill="var(--fg-muted)" opacity="0.35"/>
    <rect x="18" y="30" width="9" height="2.5" rx="1.25" fill="var(--fg)"/>
    <rect x="29" y="29.2" width="2.2" height="4.2" rx="0.6" fill="var(--fg)" class="sic-cursor"/>
  `,
  shield: `
    <path d="M24 8 L36 13.5 V24 C36 33.5 30.5 38.8 24 42 C17.5 38.8 12 33.5 12 24 V13.5 Z" stroke="var(--fg)" stroke-width="1.5" fill="none" stroke-linejoin="round"/>
    <path d="M17.5 24.5 L22.5 29.5 L31 19.5" stroke="var(--fg-secondary)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="sic-draw"/>
    <circle cx="24" cy="24" r="17" stroke="var(--fg)" stroke-width="1" fill="none" opacity="0.12" class="sic-check-halo"/>
  `,
  gear: `
    <g class="sic-spin" style="--dur: 10s;">
      <circle cx="24" cy="24" r="12" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
      <circle cx="24" cy="24" r="4.5" stroke="var(--fg-secondary)" stroke-width="1.25" fill="none"/>
      <line x1="24" y1="10" x2="24" y2="14" stroke="var(--fg)" stroke-width="1.5" stroke-linecap="round"/>
      <line x1="24" y1="34" x2="24" y2="38" stroke="var(--fg)" stroke-width="1.5" stroke-linecap="round"/>
      <line x1="10" y1="24" x2="14" y2="24" stroke="var(--fg)" stroke-width="1.5" stroke-linecap="round"/>
      <line x1="34" y1="24" x2="38" y2="24" stroke="var(--fg)" stroke-width="1.5" stroke-linecap="round"/>
    </g>
    <circle cx="40" cy="12" r="2" fill="var(--fg)" class="sic-scan"/>
  `,
};

const svg = icons[type] || icons.gear;
---

<div class="sic-block">
  <svg viewBox="0 0 48 48" fill="none" class="sic-svg" aria-hidden="true" set:html={svg}></svg>
  {showNum && <span class="sic-num">{String(index + 1).padStart(2, '0')}</span>}
</div>

<style>
  .sic-block {
    flex-shrink: 0;
    width: 4.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .sic-svg {
    width: 100%;
    height: 4.25rem;
    padding: 0.35rem;
    border: 1px solid var(--border);
    background: var(--bg-raised);
  }
  .sic-num {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
    padding: 0.5rem 0 0.25rem;
  }
</style>

<style is:global>
  .sic-radar {
    transform-origin: 20px 20px;
    animation: sic-spin 4s linear infinite;
  }
  .sic-scan {
    animation: sic-scan 2.2s ease-in-out infinite;
  }
  @keyframes sic-scan {
    0%, 100% { opacity: 0.1; }
    50% { opacity: 1; }
  }
  .sic-cursor {
    animation: sic-blink 1s steps(1) infinite;
  }
  @keyframes sic-blink {
    50% { opacity: 0; }
  }
  .sic-flow {
    animation: sic-flow 2.4s ease-in-out infinite;
  }
  @keyframes sic-flow {
    0% { transform: translateY(0); opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { transform: translateY(22px); opacity: 0; }
  }
  .sic-bar {
    transform-box: fill-box;
    transform-origin: left;
    animation: sic-load 2.2s ease-in-out infinite;
  }
  @keyframes sic-load {
    0% { transform: scaleX(0); }
    50% { transform: scaleX(1); }
    100% { transform: scaleX(0); }
  }
  .sic-spin {
    transform-origin: 24px 24px;
    animation: sic-spin var(--dur, 6s) linear infinite;
  }
  .sic-spin-rev {
    transform-origin: 24px 24px;
    animation: sic-spin-rev 9s linear infinite;
  }
  @keyframes sic-spin {
    to { transform: rotate(360deg); }
  }
  @keyframes sic-spin-rev {
    to { transform: rotate(-360deg); }
  }
  .sic-rocket {
    animation: sic-float 3s ease-in-out infinite;
  }
  @keyframes sic-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-2.5px); }
  }
  .sic-flame {
    transform-box: fill-box;
    transform-origin: bottom;
    animation: sic-flame 0.5s ease-in-out infinite alternate;
  }
  @keyframes sic-flame {
    from { opacity: 0.6; transform: scaleY(0.8); }
    to { opacity: 1; transform: scaleY(1.15); }
  }
  .sic-draw {
    stroke-dasharray: 30;
    stroke-dashoffset: 30;
    animation: sic-draw 1.8s ease-in-out infinite 0.3s;
  }
  @keyframes sic-draw {
    0% { stroke-dashoffset: 30; }
    45%, 100% { stroke-dashoffset: 0; }
  }
  .sic-check-halo {
    transform-box: fill-box;
    transform-origin: center;
    animation: sic-halo 2.4s ease-out infinite;
  }
  @keyframes sic-halo {
    0% { transform: scale(0.6); opacity: 0.5; }
    70%, 100% { transform: scale(1.15); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sic-radar, .sic-scan, .sic-cursor, .sic-flow, .sic-bar, .sic-spin,
    .sic-spin-rev, .sic-rocket, .sic-flame, .sic-draw, .sic-check-halo {
      animation: none !important;
    }
    .sic-draw { stroke-dashoffset: 0; }
    .sic-flame { opacity: 1; }
    .sic-check-halo { opacity: 0.12; }
  }
</style>