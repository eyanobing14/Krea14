---
import data from "../../../public/data/portfolio.json";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ScrollReveal from "../../components/ScrollReveal.astro";
import Container from "../../components/Container.astro";

export function getStaticPaths() {
  return (data.caseStudies || []).map((study: any) => ({
    params: { slug: study.slug },
  }));
}

const { slug } = Astro.params;
const study = (data.caseStudies || []).find((s: any) => s.slug === slug);

if (!study) {
  return Astro.redirect("/work");
}

const heroSrcs = [
  study.heroImage || study.thumbnail,
  ...(study.gallery || []).map((g: any) => (typeof g === 'object' ? g.image : '')),
  ...(study.flow || []).map((s: any) => (typeof s === 'object' ? s.image : ''))
].filter((s: string) => typeof s === 'string' && s.trim() !== '');
const heroGridClass =
  heroSrcs.length >= 4 ? 'grid-cols-4' :
  heroSrcs.length === 3 ? 'grid-cols-3 [&>*:first-child]:col-span-2' :
  heroSrcs.length === 2 ? 'grid-cols-2' : '';
const heroGridImages = heroSrcs.slice(0, 4);
---

<Layout title={`${study.title} — Portfolio`}>
  <Header />
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-20 sm:pt-28 pb-8 md:pt-40 md:pb-24">
      <Container>
        <div class="flex flex-wrap items-center gap-3 mb-8">
          <a
            href="/work"
            class="text-xs no-underline transition-colors duration-200"
            style="color: var(--fg-muted);"
            onmouseover="this.style.color='var(--fg)'"
            onmouseout="this.style.color='var(--fg-muted)'">← Retour</a
          >
          <span class="text-xs" style="color: var(--fg-muted);">·</span>
          <span class="text-xs font-mono" style="color: var(--fg-muted);"
            >{study.year}</span
          >
        </div>
        <h1
          class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.1] tracking-[-0.03em]"
          style="color: var(--fg);"
        >
          <span data-fr={study.title} data-en={study.titleEn || study.title}>{study.title}</span>
        </h1>
        <p
          class="mt-4 text-base sm:text-lg leading-relaxed max-w-2xl"
          style="color: var(--fg-secondary);"
        ><span data-fr={study.description} data-en={study.descriptionEn || study.description}>{study.description}</span>
        </p>
        <div class="mt-6 flex flex-wrap gap-2">                    {study.tags?.map((tag: string, i: number) => (
                      <span
                        class="px-3 py-1 text-xs font-mono uppercase tracking-wider"
                        style="color: var(--fg-muted); border: 1px solid var(--border);"
                      ><span data-fr={tag} data-en={study.tagsEn?.[i] || tag}>{tag}</span>
                      </span>
                    ))}
        </div>
      </Container>
    </section>

    <!-- Hero Image -->
    <Container>
      <div
        class="w-full aspect-video lg:aspect-21/9 relative overflow-hidden gsap-scale"
        style={`background: ${study.heroColor || "var(--bg-raised)"}; border: 1px solid var(--border);`}
      >
        <div
          class="absolute inset-0 opacity-[0.07]"
          aria-hidden="true"
          style="background-image: linear-gradient(to right, var(--fg) 1px, transparent 1px), linear-gradient(to bottom, var(--fg) 1px, transparent 1px); background-size: 80px 80px;"
        >
        </div>
        {heroGridImages.length > 1 ? (
          <div class={`w-full h-full grid ${heroGridClass}`}>
            {heroGridImages.map((src: string, i: number) => (
              <div class="relative overflow-hidden" style={i > 0 ? "border-left: 1px solid var(--border);" : undefined}>
                <img src={src} alt={study.title} class="absolute inset-0 w-full h-full object-cover" loading={i === 0 ? "eager" : "lazy"} />
              </div>
            ))}
          </div>
        ) : heroGridImages.length === 1 ? (
          <img
            src={heroGridImages[0]}
            alt={study.title}
            class="absolute inset-0 w-full h-full object-cover"
            loading="eager"
          />
        ) : (
          <span
            class="font-mono text-sm uppercase tracking-widest opacity-20"
            style="color: var(--fg);">Image du projet</span
          >
        )}
      </div>
    </Container>

    <div class="section-divider mt-8 sm:mt-16" aria-hidden="true"></div>

    <!-- Stats band -->
    {
      study.stats && study.stats.length > 0 && (
        <section class="section">
          <Container>
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 gsap-stagger-grid">
              {study.stats.map((stat: any, i: number) => (
                <div class="p-6 sm:p-8" style="border: 1px solid var(--border); background: var(--bg-raised);">
                  <p class="font-mono text-xs uppercase tracking-widest mb-3" style="color: var(--fg-muted);">{String(i + 1).padStart(2, "0")}</p>
                  <p class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-[-0.02em]" style="color: var(--fg);">{stat.value}</p>
                  <p class="mt-2 text-sm leading-relaxed" style="color: var(--fg-secondary);"><span data-fr={stat.label} data-en={stat.labelEn || stat.label}>{stat.label}</span></p>
                </div>
              ))}
            </div>
          </Container>
        </section>
      )
    }

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Details -->
    <section class="section">
      <Container>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-16">
          <!-- Left: challenge -->
          <div class="min-w-0 col-span-12 lg:col-span-5">
            <p
              class="text-base sm:text-lg leading-relaxed"
              style="color: var(--fg);"
            ><span data-fr={study.challenge} data-en={study.challengeEn || study.challenge}>{study.challenge}</span>
            </p>
          </div>

          <!-- Right: solution -->
          <div
            class="min-w-0 col-span-12 lg:col-span-6 lg:col-start-7"
          >
            <p
              class="text-sm leading-relaxed"
              style="color: var(--fg-secondary);"
            ><span data-fr={study.solution} data-en={study.solutionEn || study.solution}>{study.solution}</span>
            </p>
          </div>
        </div>
      </Container>
    </section>

    <!-- Key visual (full-width) -->
    {
      study.keyVisual && (study.keyVisual.image || study.keyVisual.caption) && (
        <section class="section" style="background: var(--bg-raised);">
          <Container>
            <figure>
              {study.keyVisual.image ? (
                <img
                  src={study.keyVisual.image}
                  alt={study.keyVisual.caption || ''}
                  class="w-full aspect-video object-cover"
                  style="border: 1px solid var(--border);"
                  loading="lazy"
                />
              ) : (
                <div
                  class="w-full aspect-video relative overflow-hidden flex items-center justify-center"
                  style="border: 1px solid var(--border); background: var(--bg-raised);"
                >
                  <span class="font-mono text-sm uppercase tracking-widest opacity-20" style="color: var(--fg);">Visuel clé</span>
                </div>
              )}
              {study.keyVisual.caption && (
                <figcaption class="mt-3 font-mono text-xs uppercase tracking-wider" style="color: var(--fg-muted);">
                  <span data-fr={study.keyVisual.caption} data-en={study.keyVisual.captionEn || study.keyVisual.caption}>{study.keyVisual.caption}</span>
                </figcaption>
              )}
            </figure>
          </Container>
        </section>
      )
    }

    <!-- Architecture -->
    {
      study.architecture && (study.architecture.text || (study.architecture.stack && study.architecture.stack.length)) && (
        <section class="section">
          <Container>
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-16">
              <div class="min-w-0 col-span-12 lg:col-span-7">
                <h2 class="text-xl md:text-2xl font-bold leading-tight mb-4" style="color: var(--fg);">
                  L&apos;architecture.
                </h2>
                <p class="text-sm leading-relaxed" style="color: var(--fg-secondary);">
                  <span data-fr={study.architecture.text} data-en={study.architecture.textEn || study.architecture.text}>{study.architecture.text}</span>
                </p>
                {study.architecture.stack && study.architecture.stack.length > 0 && (
                  <div class="mt-6 flex flex-wrap gap-2">
                    {study.architecture.stack.map((t: string, i: number) => (
                      <span class="px-3 py-1 text-xs font-mono uppercase tracking-wider" style="color: var(--fg-muted); border: 1px solid var(--border);">
                        <span data-fr={t} data-en={study.architecture.stackEn?.[i] || t}>{t}</span>
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </Container>
        </section>
      )
    }

    <!-- Flow / Process -->
    {
      study.flow && study.flow.length > 0 && (
        <>
          <div class="section-divider" aria-hidden="true" />
          <section class="section">
            <Container>
              <div class="max-w-2xl">
                <h2
                  class="mt-6 text-xl md:text-2xl font-bold leading-tight"
                  style="color: var(--fg);"
                >
                  Comment nous abordons ce projet.
                </h2>
              </div>
              <div class="mt-8 sm:mt-12 space-y-0">
                {study.flow.map((step: any, i: number) => {
                  const stepText = typeof step === 'string' ? step : step.text;
                  const stepImage = typeof step === 'object' ? step.image : '';
                  return (
                    <div
                      class="flex items-start gap-4 sm:gap-6 py-5 sm:py-6 gsap-reveal"
                      style="border-bottom: 1px solid var(--border);"
                    >
                    <span
                      class="shrink-0 font-mono text-sm font-semibold w-11 h-11 flex items-center justify-center"
                      style="color: var(--fg-muted); border: 1px solid var(--border);"
                    >
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <div class="flex-1 min-w-0">
                      <p
                        class="text-lg leading-relaxed pt-1"
                        style="color: var(--fg-secondary);"
                      >
                        {stepText}
                      </p>
                      {stepImage && (
                        <div class="mt-4 w-full max-w-2xl relative" style="border: 1px solid var(--border); background: var(--bg-raised);">
                          <img
                            src={stepImage}
                            alt={`Étape ${i + 1} — ${stepText || ''}`}
                            class="w-full aspect-video object-cover block"
                            loading="lazy"
                          />
                          <span
                            class="absolute top-2 right-2 font-mono text-[10px] uppercase tracking-wider px-2 py-1"
                            style="background: var(--bg); color: var(--fg-muted); border: 1px solid var(--border);"
                          >
                            Étape {String(i + 1).padStart(2, "0")}
                          </span>
                        </div>
                      )}
                    </div>
                  </div>
                )})}
              </div>
            </Container>
          </section>
        </>
      )
    }

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Gallery -->
    {
      study.gallery && study.gallery.length > 0 && (
        <section class="section">
          <Container>
            <h2 class="text-xl md:text-2xl font-bold leading-tight" style="color: var(--fg);">
              Écrans clés.
            </h2>
            <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 gsap-stagger-grid">
              {study.gallery.map((item: any, i: number) => (
                <figure class="group">
                  {item.image ? (
                    <img
                      src={item.image}
                      alt={item.caption || ''}
                      class="w-full aspect-video object-cover transition-transform duration-500 group-hover:scale-105"
                      style="border: 1px solid var(--border); background: var(--bg-raised);"
                      loading="lazy"
                    />
                  ) : (
                    <div
                      class="w-full aspect-video relative overflow-hidden flex items-center justify-center"
                      style="border: 1px solid var(--border); background: var(--bg-raised);"
                    >
                      <span class="font-mono text-xs uppercase tracking-widest opacity-20" style="color: var(--fg);">Écran {String(i + 1).padStart(2, "0")}</span>
                    </div>
                  )}
                  <figcaption class="mt-3 font-mono text-xs uppercase tracking-wider" style="color: var(--fg-muted);">
                    <span data-fr={item.caption} data-en={item.captionEn || item.caption}>{item.caption}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </Container>
        </section>
      )
    }

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Results -->
    {
      study.results && study.results.length > 0 && (
        <section class="section" style="background: var(--bg-raised);">
          <Container>
            <div class="mt-8 sm:mt-12 grid grid-cols-1 md:grid-cols-3 gap-4 gsap-stagger-grid">
              {study.results.map((result: string) => (
                <div class="p-6" style="border: 1px solid var(--border);">
                  <p
                    class="text-sm font-medium leading-relaxed"
                    style="color: var(--fg);"
                  >
                    {result}
                  </p>
                </div>
              ))}
            </div>
          </Container>
        </section>
      )
    }

    <!-- CTA -->
    <section class="section" style="border-top: 1px solid var(--border);">          <Container class="text-center">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold" style="color: var(--fg);">
          Projet suivant?
        </h2>
        <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4">
          <a
            href="/work"
            class="px-6 py-3 text-sm font-medium no-underline transition-all text-center w-full sm:w-auto"
            style="background: var(--fg); color: var(--bg);"
            onmouseover="this.style.opacity='0.85'"
            onmouseout="this.style.opacity='1'"
          >
            Voir tous les projets
          </a>
          <a
            href="/contact"
            class="px-6 py-3 text-sm no-underline transition-all text-center w-full sm:w-auto"
            style="color: var(--fg-secondary); border: 1px solid var(--border-strong); background: var(--bg);"
            onmouseover="this.style.color='var(--fg)'"
            onmouseout="this.style.color='var(--fg-secondary)'"
          >
            Démarrer un projet
          </a>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
  <ScrollReveal />
</Layout>
