---
import data from "../../../public/data/portfolio.json";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ScrollReveal from "../../components/ScrollReveal.astro";
import Container from "../../components/Container.astro";
import PortfolioImage from "../../components/PortfolioImage.astro";
import StepIcon from "../../components/StepIcon.astro";
import BentoCard from "../../components/BentoCard.astro";

export function getStaticPaths() {
  return (data.caseStudies || []).map((study: any) => ({
    params: { slug: study.slug },
  }));
}

const { slug } = Astro.params;
const study = (data.caseStudies || []).find((s: any) => s.slug === slug);

if (!study) {
  return Astro.redirect("/work");
}

const heroSrcs = [
  study.heroImage || study.thumbnail,
  ...(study.gallery || []).map((g: any) => (typeof g === 'object' ? g.image : '')),
  ...(study.flow || []).map((s: any) => (typeof s === 'object' ? s.image : ''))
].filter((s: string) => typeof s === 'string' && s.trim() !== '');
const heroGridClass =
  heroSrcs.length >= 4 ? 'grid-cols-4' :
  heroSrcs.length === 3 ? 'grid-cols-3 [&>*:first-child]:col-span-2' :
  heroSrcs.length === 2 ? 'grid-cols-2' : '';
const heroGridImages = heroSrcs.slice(0, 4);

// ── Écrans clés — split into two marquee rows scrolling in opposite directions ──
interface GalleryEntry {
  item: { image?: string; caption?: string; captionEn?: string };
  index: number;
}
const galleryEntries: GalleryEntry[] = ((study.gallery || []) as any[]).map(
  (item, index) => ({ item, index })
);
// Alternate items between the two rows so both stay balanced whatever the count
const galleryRows: GalleryEntry[][] = [
  galleryEntries.filter((e) => e.index % 2 === 0),
  galleryEntries.filter((e) => e.index % 2 === 1),
].filter((row) => row.length > 0);
// Repeat a row's items so one loop is wider than the viewport (seamless marquee)
function loopRow<T>(row: T[]): T[] {
  const repeats = Math.max(1, Math.ceil(6 / row.length));
  return Array.from({ length: repeats }, () => row).flat();
}
---

<Layout title={`${study.title} · Portfolio`}>
  <Header />
  <main id="main-content">
    <!-- Hero -->
    <section class="relative overflow-hidden pt-20 sm:pt-28 pb-8 md:pt-40 md:pb-24">
      <!-- Grid lines — theme-aware -->
      <div class="absolute inset-0 opacity-[0.08] dark:opacity-[0.1]" aria-hidden="true" style="z-index: -1; background-image: linear-gradient(to right, var(--fg) 1px, transparent 1px), linear-gradient(to bottom, var(--fg) 1px, transparent 1px); background-size: 80px 80px;"></div>
      <Container>
        <div class="flex flex-wrap items-center gap-3 mb-8 relative z-10">
          <a
            href="/work"
            class="text-xs no-underline transition-colors duration-200"
            style="color: var(--fg-muted);"
            onmouseover="this.style.color='var(--fg)'"
            onmouseout="this.style.color='var(--fg-muted)'">← Retour</a
          >
          <span class="text-xs" style="color: var(--fg-muted);">·</span>
          <span class="text-xs font-mono" style="color: var(--fg-muted);"
            >{study.year}</span
          >
        </div>
        <h1
          class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.1] tracking-[-0.03em]"
          style="color: var(--fg);"
        >
          <span data-fr={study.title} data-en={study.titleEn || study.title}>{study.title}</span>
        </h1>
        <p
          class="mt-4 text-base sm:text-lg leading-relaxed max-w-2xl"
          style="color: var(--fg-secondary);"
        ><span data-fr={study.description} data-en={study.descriptionEn || study.description}>{study.description}</span>
        </p>
        <div class="mt-6 flex flex-wrap gap-2">                    {study.tags?.map((tag: string, i: number) => (
                      <span
                        class="px-3 py-1 text-xs font-mono uppercase tracking-wider"
                        style="color: var(--fg-muted); border: 1px solid var(--border);"
                      ><span data-fr={tag} data-en={study.tagsEn?.[i] || tag}>{tag}</span>
                      </span>
                    ))}
        </div>
      </Container>
    </section>

    <!-- Hero Image -->
    <Container>
      <div
        class="w-full aspect-video lg:aspect-21/9 relative overflow-hidden gsap-scale kg-hero-media"
        data-kg-modal-open={heroGridImages.length > 0 ? '' : undefined}
        style={`background: ${study.heroColor || "var(--bg-raised)"}; border: 1px solid var(--border);`}
      >
        {heroGridImages.length > 1 ? (
          <div class={`w-full h-full grid ${heroGridClass}`}>
            {heroGridImages.map((src: string, i: number) => (
              <div class="relative overflow-hidden" style={i > 0 ? "border-left: 1px solid var(--border);" : undefined}>
                <PortfolioImage src={src} alt={study.title} class="absolute inset-0 w-full h-full object-cover" loading={i === 0 ? "eager" : "lazy"} sizes="(min-width: 1024px) 25vw, 50vw" />
              </div>
            ))}
          </div>
        ) : heroGridImages.length === 1 ? (
          <PortfolioImage
            src={heroGridImages[0]}
            alt={study.title}
            class="absolute inset-0 w-full h-full object-cover"
            loading="eager"
            sizes="(min-width: 1024px) 70vw, 100vw"
          />
        ) : (
          <span
            class="font-mono text-sm uppercase tracking-widest opacity-20"
            style="color: var(--fg);">Image du projet</span
          >
        )}
        {heroGridImages.length > 0 && (
          <button type="button" class="kg-hero-open" aria-label="Agrandir l'image">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"
              ><path
                d="M8.5 1.5h4v4M5.5 12.5h-4v-4M12.5 1.5 8 6M1.5 12.5 6 8"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
          </button>
        )}
      </div>
    </Container>

    <!-- Hero lightbox — blurred backdrop, title & description at the bottom -->
    {heroGridImages.length > 0 && (
      <div
        class="kg-modal"
        id="kg-hero-modal"
        data-state="closed"
        role="dialog"
        aria-modal="true"
        aria-label={study.title}
      >
        <div class="kg-modal-backdrop" data-kg-modal-close></div>
        <figure class="kg-modal-figure">
          <PortfolioImage
            src={heroGridImages[0]}
            alt={study.title}
            loading="lazy"
            sizes="100vw"
            style="max-width: 100%; max-height: 46vh; width: auto; height: auto; margin: 0 auto; border: 1px solid var(--border); background: var(--bg-raised);"
          />
          <figcaption class="kg-modal-caption">
            <h3 class="text-lg sm:text-xl font-semibold leading-tight" style="color: var(--fg);">
              <span data-fr={study.title} data-en={study.titleEn || study.title}>{study.title}</span>
            </h3>
            <p class="mt-2 text-sm leading-relaxed" style="color: var(--fg-secondary);">
              <span data-fr={study.description} data-en={study.descriptionEn || study.description}>{study.description}</span>
            </p>
          </figcaption>
          {galleryRows.length > 0 && (
            <div class="kg-modal-carousel" aria-label="Écrans clés">
              {galleryRows.map((row, rowIndex) => (
                <div
                  class="kg-row"
                  style={`--kg-delay: ${rowIndex % 2 === 1 ? '1.1s' : '0.35s'};`}
                >
                  <div
                    class={`kg-track${rowIndex % 2 === 1 ? ' kg-track--reverse' : ''}`}
                  >
                    <div class="kg-slide">
                      {[0, 1].map((copy) =>
                        loopRow(row).map((entry, i) => (
                          <figure
                            class="kg-item"
                            aria-hidden={copy === 1 || i >= row.length ? 'true' : undefined}
                          >
                            {entry.item.image ? (
                              <PortfolioImage
                                src={entry.item.image}
                                alt={entry.item.caption || ''}
                                class="w-full aspect-video object-cover"
                                loading="lazy"
                                sizes="(min-width: 1024px) 20vw, 45vw"
                              />
                            ) : (
                              <div
                                class="w-full aspect-video relative overflow-hidden flex items-center justify-center"
                              >
                                <span
                                  class="font-mono text-xs uppercase tracking-widest opacity-20"
                                  style="color: var(--fg);">Écran {String(entry.index + 1).padStart(2, "0")}</span
                                >
                              </div>
                            )}
                            <figcaption class="kg-caption">
                              <span
                                data-fr={entry.item.caption}
                                data-en={entry.item.captionEn || entry.item.caption}
                              >{entry.item.caption}</span
                              >
                            </figcaption>
                          </figure>
                        ))
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </figure>
        <button type="button" class="kg-modal-close" data-kg-modal-close aria-label="Fermer">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"
            ><path d="M1 1l12 12M13 1 1 13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg
          >
        </button>
      </div>
    )}

    <div class="section-divider mt-8 sm:mt-16" aria-hidden="true"></div>

    <!-- Stats band -->
    {
      study.stats && study.stats.length > 0 && (
        <section class="section">
          <Container>
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 gsap-stagger-grid">
              {study.stats.map((stat: any, i: number) => (
                <div class="p-6 sm:p-8" style="border: 1px solid var(--border); background: var(--bg-raised);">
                  <p class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-[-0.02em]" style="color: var(--fg);">{stat.value}</p>
                  <p class="mt-2 text-sm leading-relaxed" style="color: var(--fg-secondary);"><span data-fr={stat.label} data-en={stat.labelEn || stat.label}>{stat.label}</span></p>
                </div>
              ))}
            </div>
          </Container>
        </section>
      )
    }

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Details -->
    <section class="section">
      <Container>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-16">
          <!-- Left: challenge -->
          <div class="min-w-0 col-span-12 lg:col-span-5">
            <p
              class="text-base sm:text-lg leading-relaxed"
              style="color: var(--fg);"
            ><span data-fr={study.challenge} data-en={study.challengeEn || study.challenge}>{study.challenge}</span>
            </p>
          </div>

          <!-- Right: solution -->
          <div
            class="min-w-0 col-span-12 lg:col-span-6 lg:col-start-7"
          >
            <p
              class="text-sm leading-relaxed"
              style="color: var(--fg-secondary);"
            ><span data-fr={study.solution} data-en={study.solutionEn || study.solution}>{study.solution}</span>
            </p>
          </div>
        </div>
      </Container>
    </section>

    <!-- Key visual (full-width) -->
    {
      study.keyVisual && (study.keyVisual.image || study.keyVisual.caption) && (
        <section class="section" style="background: var(--bg-raised);">
          <Container>
            <figure>
              {study.keyVisual.image ? (
                <PortfolioImage
                  src={study.keyVisual.image}
                  alt={study.keyVisual.caption || ''}
                  class="w-full aspect-video object-cover"
                  style="border: 1px solid var(--border);"
                  loading="lazy"
                />
              ) : (
                <div
                  class="w-full aspect-video relative overflow-hidden flex items-center justify-center"
                  style="border: 1px solid var(--border); background: var(--bg-raised);"
                >
                  <span class="font-mono text-sm uppercase tracking-widest opacity-20" style="color: var(--fg);">Visuel clé</span>
                </div>
              )}
              {study.keyVisual.caption && (
                <figcaption class="mt-3 font-mono text-xs uppercase tracking-wider" style="color: var(--fg-muted);">
                  <span data-fr={study.keyVisual.caption} data-en={study.keyVisual.captionEn || study.keyVisual.caption}>{study.keyVisual.caption}</span>
                </figcaption>
              )}
            </figure>
          </Container>
        </section>
      )
    }

    <!-- Architecture -->
    {
      study.architecture && (study.architecture.text || (study.architecture.stack && study.architecture.stack.length)) && (
        <section class="section relative overflow-hidden">
          <Container>
            <div
              class="absolute inset-0 opacity-[0.08] dark:opacity-[0.1]"
              aria-hidden="true"
              style="z-index: -1; background-image: linear-gradient(to right, var(--fg) 1px, transparent 1px), linear-gradient(to bottom, var(--fg) 1px, transparent 1px); background-size: 80px 80px;"
            ></div>
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-16">
              <div class="min-w-0 col-span-12 lg:col-span-8">
                <h2 class="text-2xl md:text-3xl font-bold leading-tight mb-6" style="color: var(--fg);">
                  Le principe.
                </h2>
                <p class="text-base sm:text-lg leading-relaxed" style="color: var(--fg-secondary);">
                  <span data-fr={study.architecture.text} data-en={study.architecture.textEn || study.architecture.text}>{study.architecture.text}</span>
                </p>
              </div>
            </div>
          </Container>
        </section>
      )
    }

    <!-- Flow / Process -->
    {
      study.flow && study.flow.length > 0 && (
        <>
          <div class="section-divider" aria-hidden="true" />
          <section class="section">
            <Container>
              <div class="max-w-2xl">
                <h2
                  class="mt-6 text-xl md:text-2xl font-bold leading-tight"
                  style="color: var(--fg);"
                >
                  Comment ce projet a été abordé.
                </h2>
              </div>
              <div class="mt-8 sm:mt-12 bento-grid">
                {study.flow.map((step: any, i: number) => {
                  const stepText = typeof step === 'string' ? step : step.text;
                  const stepImage = typeof step === 'object' ? step.image : '';
                  return (
                    <BentoCard
                      index={i}
                      text={stepText}
                      image={stepImage}
                      total={study.flow.length}
                    />
                  );
                })}
              </div>
            </Container>
          </section>
        </>
      )
    }

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Gallery -->
    {
      study.gallery && study.gallery.length > 0 && (
        <section class="section">
          <Container>
            <h2 class="text-xl md:text-2xl font-bold leading-tight" style="color: var(--fg);">
              Écrans clés.
            </h2>

            <!-- Two rows, opposite directions, staggered start delay -->
            <div class="kg-marquee-stack" aria-label="Écrans clés">
              {galleryRows.map((row, rowIndex) => (
              <div
                class="kg-row"
                style={`--kg-delay: ${rowIndex % 2 === 1 ? '1.1s' : '0.35s'};`}
              >
                <div
                  class={`kg-track${rowIndex % 2 === 1 ? ' kg-track--reverse' : ''}`}
                >
                  <!-- .kg-slide carries the drag offset, the track keeps the CSS loop -->
                  <div class="kg-slide">
                  {[0, 1].map((copy) =>
                    loopRow(row).map((entry, i) => (
                      <figure
                        class="kg-item group"
                        aria-hidden={copy === 1 || i >= row.length ? 'true' : undefined}
                      >
                        {entry.item.image ? (
                          <PortfolioImage
                            src={entry.item.image}
                            alt={entry.item.caption || ''}
                            class="w-full aspect-video object-cover transition-transform duration-500 group-hover:scale-105"
                            loading="lazy"
                            sizes="(min-width: 1024px) 30vw, 70vw"
                          />
                        ) : (
                          <div
                            class="w-full aspect-video relative overflow-hidden flex items-center justify-center"
                          >
                            <span
                              class="font-mono text-xs uppercase tracking-widest opacity-20"
                              style="color: var(--fg);">Écran {String(entry.index + 1).padStart(2, "0")}</span
                            >
                          </div>
                        )}
                        <figcaption class="kg-caption">
                          <span
                            data-fr={entry.item.caption}
                            data-en={entry.item.captionEn || entry.item.caption}
                          >{entry.item.caption}</span
                          >
                        </figcaption>
                      </figure>
                    ))
                  )}
                  </div>
                </div>
              </div>
            ))}
            </div>
          </Container>
        </section>
      )
    }

    <!-- CTA -->
    <section class="section" style="border-top: 1px solid var(--border);">          <Container class="text-center">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold" style="color: var(--fg);">
          Projet suivant?
        </h2>
        <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4">
          <a
            href="/work"
            class="px-6 py-3 text-sm font-medium no-underline transition-all text-center w-full sm:w-auto"
            style="background: var(--fg); color: var(--bg);"
            onmouseover="this.style.opacity='0.85'"
            onmouseout="this.style.opacity='1'"
          >
            Voir tous les projets
          </a>
          <a
            href="/contact"
            class="px-6 py-3 text-sm no-underline transition-all text-center w-full sm:w-auto"
            style="color: var(--fg-secondary); border: 1px solid var(--border-strong); background: var(--bg);"
            onmouseover="this.style.color='var(--fg)'"
            onmouseout="this.style.color='var(--fg-secondary)'"
          >
            Démarrer un projet
          </a>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
  <ScrollReveal />
</Layout>

<style>
  .bento-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 3.5fr) minmax(0, 3.5fr);
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .bento-grid {
      gap: 1rem;
    }
  }
  @media (max-width: 767px) {
    .bento-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 0.75rem;
    }
  }

  /* ── Écrans clés — 2 rows scrolling in opposite directions ── */
  .kg-marquee-stack {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  @media (min-width: 768px) {
    .kg-marquee-stack {
      gap: 1rem;
      margin-top: 3rem;
    }
  }
  .kg-row {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 4%,
      #000 96%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 4%,
      #000 96%,
      transparent 100%
    );
  }
  .kg-track {
    display: flex;
    width: max-content;
    animation: kg-scroll-left 90s linear infinite;
    /* small start delay so the rows don't all move off the beat */
    animation-delay: var(--kg-delay, 0s);
    will-change: transform;
  }
  .kg-track--reverse {
    animation: kg-scroll-right 90s linear infinite;
    animation-delay: var(--kg-delay, 0s);
  }
  .kg-row:hover .kg-track {
    animation-play-state: paused;
  }
  .kg-item {
    flex: 0 0 auto;
    width: clamp(200px, 26vw, 380px);
    /* uniform gap keeps the loop seamless: translateX(-50%) === one copy */
    margin: 0 1rem 0 0;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    overflow: hidden;
  }
  .kg-caption {
    display: block;
    padding: 0.7rem 1rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @keyframes kg-scroll-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes kg-scroll-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .kg-track {
      animation: none;
      transform: translateX(0);
    }
  }

  /* ── Swipe / drag the rows ── */
  .kg-slide {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .kg-row {
    /* horizontal drag is ours, vertical scroll stays native */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .kg-row--dragging .kg-track {
    animation-play-state: paused;
  }

  /* ── Hero lightbox ── */
  .kg-hero-open {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--bg) 68%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--fg);
    transition:
      border-color 0.3s var(--ease-out-quart),
      transform 0.3s var(--ease-out-quart);
  }
  .kg-hero-open:hover {
    border-color: var(--border-hover);
    transform: scale(1.06);
  }

  .kg-modal {
    position: fixed;
    inset: 0;
    z-index: 140;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    visibility: hidden;
    pointer-events: none;
    /* visibility flips instantly on open, once the fade is done on close */
    transition: visibility 0.18s;
  }
  .kg-modal[data-state='open'] {
    visibility: visible;
    pointer-events: auto;
    transition: visibility 0s;
  }
  /* Blurred view of the page content behind the lightbox */
  .kg-modal-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 62%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(115%);
    backdrop-filter: blur(14px) saturate(115%);
    /* fade the backdrop itself: the blur is composed once, not re-blurred per frame */
    opacity: 0;
    transition: opacity 0.2s var(--ease-out-quart);
  }
  .kg-modal[data-state='open'] .kg-modal-backdrop {
    opacity: 1;
  }
  .kg-modal-figure {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: min(1100px, 100%);
    max-height: 100%;
    margin: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
    opacity: 0;
    /* compositor-friendly: only transform + opacity animate */
    transform: translate3d(0, 8px, 0) scale(0.985);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    will-change: transform, opacity;
    transition:
      transform 0.24s var(--ease-out-quart),
      opacity 0.16s linear;
  }
  .kg-modal-figure::-webkit-scrollbar {
    display: none;
  }
  .kg-modal[data-state='open'] .kg-modal-figure {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
  .kg-modal-caption {
    max-width: 44rem;
  }
  /* Key screens carousel inside the lightbox */
  .kg-modal-carousel {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .kg-modal-carousel .kg-item {
    width: clamp(150px, 17vw, 230px);
  }
  .kg-modal-carousel .kg-caption {
    padding: 0.5rem 0.75rem;
    font-size: 0.625rem;
  }
  .kg-modal-close {
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--bg) 68%, transparent);
    color: var(--fg);
    transition: border-color 0.3s var(--ease-out-quart);
  }
  .kg-modal-close:hover {
    border-color: var(--border-hover);
  }
</style>

<script>
  // ── Écrans clés — swipe / drag to browse the rows ──
  function initKeyScreenDrag() {
    document.querySelectorAll<HTMLElement>('.kg-row').forEach((row) => {
      if (row.dataset.dragReady === '1') return;
      const slide = row.querySelector<HTMLElement>('.kg-slide');
      if (!slide) return;
      row.dataset.dragReady = '1';

      let offset = 0;
      let startX = 0;
      let startOffset = 0;
      let dragging = false;
      let copyWidth = 0;

      const apply = () => {
        if (!copyWidth) return;
        // keep the offset inside (-copy, 0] — the row repeats every copy
        let value = offset % copyWidth;
        if (value > 0) value -= copyWidth;
        offset = value;
        slide.style.transform = `translate3d(${value}px, 0, 0)`;
      };

      row.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        copyWidth = slide.scrollWidth / 2;
        if (!copyWidth) return;
        dragging = true;
        startX = event.clientX;
        startOffset = offset;
        row.classList.add('kg-row--dragging');
        try {
          row.setPointerCapture(event.pointerId);
        } catch {
          /* capture unavailable — drag still works while the pointer stays over the row */
        }
      });

      row.addEventListener(
        'pointermove',
        (event) => {
          if (!dragging) return;
          offset = startOffset + (event.clientX - startX);
          apply();
          if (event.cancelable) event.preventDefault();
        },
        { passive: false }
      );

      const endDrag = (event: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        row.classList.remove('kg-row--dragging');
        try {
          row.releasePointerCapture(event.pointerId);
        } catch {
          /* already released */
        }
      };

      row.addEventListener('pointerup', endDrag);
      row.addEventListener('pointercancel', endDrag);
    });
  }

  // ── Hero image — lightbox with a blurred backdrop ──
  function initHeroLightbox() {
    const modal = document.getElementById('kg-hero-modal');
    if (!modal || modal.dataset.ready === '1') return;
    modal.dataset.ready = '1';

    const setOpen = (open: boolean) => {
      modal.dataset.state = open ? 'open' : 'closed';
      if (open) {
        // reserve the scrollbar width so the page behind the lightbox doesn't shift
        const gap = window.innerWidth - document.documentElement.clientWidth;
        document.documentElement.style.overflow = 'hidden';
        document.body.style.paddingRight = gap > 0 ? `${gap}px` : '';
      } else {
        document.documentElement.style.overflow = '';
        document.body.style.paddingRight = '';
      }
    };

    document.querySelectorAll<HTMLElement>('[data-kg-modal-open]').forEach((el) => {
      el.addEventListener('click', () => setOpen(true));
    });
    modal.querySelectorAll<HTMLElement>('[data-kg-modal-close]').forEach((el) => {
      el.addEventListener('click', () => setOpen(false));
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal.dataset.state === 'open') setOpen(false);
    });
  }

  function initKeyScreenPage() {
    initKeyScreenDrag();
    initHeroLightbox();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initKeyScreenPage);
  } else {
    initKeyScreenPage();
  }
  document.addEventListener('astro:page-load', initKeyScreenPage);
</script>
