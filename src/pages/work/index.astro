---
import data from '../../../public/data/portfolio.json';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import Container from '../../components/Container.astro';

const profile = data.profile;
const caseStudies = data.caseStudies || [];
const designSubcategories = data.designSubcategories || [];

// Extract unique categories (first part before "·")
const categories = [...new Set(
  caseStudies.map((s: any) => s.category.split('·')[0].trim())
)] as string[];
---

<Layout title="Work — Portfolio">
  <Header />
  <main>
    <section class="work-hero min-h-screen flex flex-col justify-center pt-20 sm:min-h-0 sm:block sm:pt-28 pb-20 md:pt-40 md:pb-24">
      <Container>
        <div class="work-hero-inner">
          <div class="work-hero-text">
            <h1 class="text-3xl sm:text-4xl md:text-6xl lg:text-7xl font-bold leading-none tracking-[-0.03em]" style="color: var(--fg);">
              Tous mes<br/>
              <span style="color: var(--fg-tertiary);">projets.</span>
            </h1>
            <p class="mt-6 text-base sm:text-lg leading-relaxed max-w-2xl" style="color: var(--fg-secondary);">
              Une sélection de projets en branding, UI/UX, développement frontend et logo design.
            </p>
          </div>

          <!-- Animation -->
          <div class="work-hero-anim">
            <svg viewBox="0 0 400 160" fill="none" class="work-process-svg" id="work-process-svg">
              <circle cx="200" cy="70" r="60" fill="var(--fg)" opacity="0.02" class="anim-glow"/>

              <!-- Step 1: Recherche (magnifying glass) -->
              <g class="anim-step as1">
                <circle cx="60" cy="70" r="32" stroke="var(--fg-muted)" stroke-width="1" fill="none" opacity="0.3"/>
                <circle cx="60" cy="70" r="28" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
                <circle cx="56" cy="66" r="10" stroke="var(--fg-secondary)" stroke-width="1.5" fill="none"/>
                <line x1="63" y1="73" x2="72" y2="82" stroke="var(--fg-secondary)" stroke-width="1.5" stroke-linecap="round"/>
                <text x="60" y="118" text-anchor="middle" fill="var(--fg-secondary)" font-size="10" font-weight="500" font-family="var(--font-mono)" letter-spacing="0.05em">Recherche</text>
              </g>

              <g class="anim-arrow aa1">
                <line x1="96" y1="70" x2="126" y2="70" stroke="var(--fg-muted)" stroke-width="1.5" stroke-dasharray="4 3"/>
                <polygon points="130,70 122,65 122,75" fill="var(--fg-muted)"/>
              </g>

              <!-- Step 2: Analyse (bar chart) -->
              <g class="anim-step as2">
                <circle cx="156" cy="70" r="32" stroke="var(--fg-muted)" stroke-width="1" fill="none" opacity="0.3"/>
                <circle cx="156" cy="70" r="28" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
                <rect x="142" y="72" width="5" height="12" rx="1" stroke="var(--fg-secondary)" stroke-width="1" fill="none"/>
                <rect x="150" y="64" width="5" height="20" rx="1" stroke="var(--fg-secondary)" stroke-width="1" fill="none"/>
                <rect x="158" y="68" width="5" height="16" rx="1" stroke="var(--fg-secondary)" stroke-width="1" fill="none"/>
                <rect x="166" y="60" width="5" height="24" rx="1" stroke="var(--fg-muted)" stroke-width="1" fill="none"/>
                <text x="156" y="118" text-anchor="middle" fill="var(--fg-secondary)" font-size="10" font-weight="500" font-family="var(--font-mono)" letter-spacing="0.05em">Analyse</text>
              </g>

              <g class="anim-arrow aa2">
                <line x1="192" y1="70" x2="222" y2="70" stroke="var(--fg-muted)" stroke-width="1.5" stroke-dasharray="4 3"/>
                <polygon points="226,70 218,65 218,75" fill="var(--fg-muted)"/>
              </g>

              <!-- Step 3: Création (pen/pencil) -->
              <g class="anim-step as3">
                <circle cx="256" cy="70" r="32" stroke="var(--fg-muted)" stroke-width="1" fill="none" opacity="0.3"/>
                <circle cx="256" cy="70" r="28" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
                <path d="M248 82 L264 58 L268 62 L252 86 Z" stroke="var(--fg-secondary)" stroke-width="1.2" fill="none"/>
                <line x1="264" y1="58" x2="268" y2="62" stroke="var(--fg-secondary)" stroke-width="1.5"/>
                <line x1="248" y1="82" x2="252" y2="86" stroke="var(--fg-secondary)" stroke-width="1"/>
                <text x="256" y="118" text-anchor="middle" fill="var(--fg-secondary)" font-size="10" font-weight="500" font-family="var(--font-mono)" letter-spacing="0.05em">Création</text>
              </g>

              <g class="anim-arrow aa3">
                <line x1="292" y1="70" x2="322" y2="70" stroke="var(--fg-muted)" stroke-width="1.5" stroke-dasharray="4 3"/>
                <polygon points="326,70 318,65 318,75" fill="var(--fg-muted)"/>
              </g>

              <!-- Step 4: Résultat (star) -->
              <g class="anim-step as4">
                <circle cx="356" cy="70" r="32" stroke="var(--fg-muted)" stroke-width="1" fill="none" opacity="0.3"/>
                <circle cx="356" cy="70" r="28" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
                <path d="M356 56 L359 66 L370 66 L361 72 L364 82 L356 76 L348 82 L351 72 L342 66 L353 66 Z" stroke="var(--fg)" stroke-width="1.2" fill="none" class="anim-check"/>
                <g class="anim-sparkle">
                  <line x1="374" y1="54" x2="380" y2="54" stroke="var(--fg)" stroke-width="1"/>
                  <line x1="377" y1="51" x2="377" y2="57" stroke="var(--fg)" stroke-width="1"/>
                </g>
                <text x="356" y="118" text-anchor="middle" fill="var(--fg-secondary)" font-size="10" font-weight="500" font-family="var(--font-mono)" letter-spacing="0.05em">Résultat</text>
              </g>

              <line x1="60" y1="140" x2="356" y2="140" stroke="var(--border)" stroke-width="2" stroke-linecap="round"/>
              <line x1="60" y1="140" x2="356" y2="140" stroke="var(--fg)" stroke-width="2" stroke-linecap="round" class="anim-progress"/>
            </svg>
          </div>
        </div>

        <!-- Category Filters -->
        <div class="mt-10 flex flex-wrap gap-2" id="work-filters">
          <button
            class="filter-btn active px-4 py-2 text-xs font-mono uppercase tracking-wider transition-all duration-300"
            data-category="all"
          >
            Tous
          </button>
          {categories.map((cat: string) => (
            <button
              class="filter-btn px-4 py-2 text-xs font-mono uppercase tracking-wider transition-all duration-300"
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>

        <!-- Subcategory Filters (Design Graphique only) -->
        <div class="mt-3 flex flex-wrap gap-2 hidden" id="work-subfilters">
          <button
            class="subfilter-btn active px-3 py-1.5 text-[10px] font-mono uppercase tracking-wider transition-all duration-300"
            data-subcategory="all"
          >
            Tous
          </button>
          {designSubcategories.map((sub: any) => (
            <button
              class="subfilter-btn px-3 py-1.5 text-[10px] font-mono uppercase tracking-wider transition-all duration-300"
              data-subcategory={sub.id}
            >
              {sub.label}
            </button>
          ))}
        </div>
      </Container>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <section class="section">
      <Container>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 gsap-stagger-grid" id="work-grid" style="scroll-margin-top: 5rem;">
          {caseStudies.map((study: any) => {
            const mainCategory = study.category.split('·')[0].trim();
            const subCategory = (study.category.split('·')[1] || '').trim();
            return (
              <a
                href={`/work/${study.slug}`}
                class="group block no-underline work-card"
                style="border: 1px solid var(--border);"
                data-category={mainCategory}
                data-subcategory={subCategory}
              >
                <div class="aspect-video flex items-center justify-center transition-all duration-500 relative overflow-hidden" style={`background: ${study.heroColor || 'var(--bg-raised)'};`}>
                  <span class="font-mono text-xs uppercase tracking-widest opacity-30" style="color: var(--fg);">{study.category}</span>
                  <!-- Hover overlay -->
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500" style="background: rgba(0,0,0,0.4);">
                    <span class="text-sm font-medium" style="color: #fff;"><span data-fr="Voir le projet →" data-en="View project →">Voir le projet →</span></span>
                  </div>
                </div>
                <div class="p-6" style="border-top: 1px solid var(--border);">
                  <div class="flex items-center justify-between">
                    <h2 class="text-base font-semibold" style="color: var(--fg);"><span data-fr={study.title} data-en={study.titleEn || study.title}>{study.title}</span></h2>
                    <span class="text-xs font-mono" style="color: var(--fg-muted);">{study.year}</span>
                  </div>
                  <p class="mt-3 text-sm leading-relaxed" style="color: var(--fg-secondary);"><span data-fr={study.description} data-en={study.descriptionEn || study.description}>{study.description}</span></p>
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {study.tags?.map((tag: string, i: number) => (
                      <span class="px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider" style="color: var(--fg-muted); border: 1px solid var(--border);"><span data-fr={tag} data-en={study.tagsEn?.[i] || tag}>{tag}</span></span>
                    ))}
                  </div>
                </div>
              </a>
            );
          })}
        </div>

        <!-- Empty state -->
        <div id="work-empty" class="hidden text-center py-20">
          <p class="text-sm" style="color: var(--fg-muted);">Aucun projet dans cette catégorie.</p>
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <section class="section" style="border-top: 1px solid var(--border);">
      <Container class="text-center">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold" style="color: var(--fg);">Envie de collaborer?</h2>
        <p class="mt-4 max-w-lg mx-auto" style="color: var(--fg-secondary);">
          Chaque projet est une nouvelle aventure. Parlons du vôtre.
        </p>
        <div class="mt-8 flex flex-col items-center gap-3 w-full max-w-[280px] mx-auto">
          <a href="/contact" class="px-6 py-3 text-sm font-medium no-underline transition-all text-center w-full" style="background: var(--fg); color: var(--bg);" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
            Nous contacter
          </a>
          <a href={`https://wa.me/${profile.whatsapp || '25761729788'}`} target="_blank" rel="noopener noreferrer" class="px-6 py-3 text-sm no-underline transition-all border w-full text-center" style="color: var(--fg-secondary); border-color: var(--border); background: var(--bg);" onmouseover="this.style.color='var(--fg)'; this.style.borderColor='var(--border-hover)'" onmouseout="this.style.color='var(--fg-secondary)'; this.style.borderColor='var(--border)'">
            <span class="inline-flex items-center gap-2">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </span>
          </a>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
  <ScrollReveal />
</Layout>

<style>
  .work-hero {
    position: relative;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 60px 60px;
    background-position: center center;
    background-blend-mode: overlay;
  }
  .work-hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120px;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  .filter-btn {
    color: var(--fg-muted);
    border: 1px solid var(--border);
    background: var(--bg);
  }
  .filter-btn:hover {
    color: var(--fg);
    border-color: var(--border-hover);
  }
  .filter-btn.active {
    color: var(--bg);
    background: var(--fg);
    border-color: var(--fg);
  }
  .work-card {
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .work-card.is-hidden {
    display: none;
  }
  .subfilter-btn {
    color: var(--fg-muted);
    border: 1px solid var(--border);
    background: var(--bg);
  }
  .subfilter-btn:hover {
    color: var(--fg);
    border-color: var(--border-hover);
  }
  .subfilter-btn.active {
    color: var(--bg);
    background: var(--fg);
    border-color: var(--fg);
  }

  /* ── Work hero split layout ── */
  .work-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    .work-hero-inner {
      flex-direction: row;
      align-items: center;
      gap: 4rem;
    }
  }

  .work-hero-text {
    flex: 1;
    min-width: 0;
  }

  .work-hero-anim {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background: radial-gradient(ellipse at center, var(--bg) 50%, transparent 100%);
    border-radius: 1rem;
    padding: 1.5rem;
  }

  .work-process-svg {
    width: 100%;
    max-width: 480px;
    height: auto;
    overflow: visible;
  }
  @media (max-width: 1023px) {
    .work-process-svg {
      max-width: 100%;
    }
  }

  /* ── Process animation (looping 3s) ── */
  .anim-step {
    opacity: 0;
    transform-origin: center;
  }
  .anim-arrow { opacity: 0; }
  .anim-check {
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
  }
  .anim-sparkle { opacity: 0; }
  .anim-glow { opacity: 0; }
  .anim-progress {
    stroke-dasharray: 296;
    stroke-dashoffset: 296;
  }

  .anim-step { animation: step-in 0.4s ease forwards, step-out 0.3s ease 2.7s forwards; }
  .as1 { animation-delay: 0s, 2.7s; }
  .as2 { animation-delay: 0.3s, 2.7s; }
  .as3 { animation-delay: 0.6s, 2.7s; }
  .as4 { animation-delay: 0.9s, 2.7s; }

  .anim-arrow { animation: arrow-in 0.2s ease forwards, arrow-out 0.2s ease 2.8s forwards; }
  .aa1 { animation-delay: 0.2s, 2.8s; }
  .aa2 { animation-delay: 0.5s, 2.8s; }
  .aa3 { animation-delay: 0.8s, 2.8s; }

  .anim-check { animation: check-draw 0.5s ease 1.2s forwards, check-erase 0.3s ease 2.7s forwards; }
  .anim-sparkle { animation: sparkle-in 0.3s ease 1.5s forwards, sparkle-out 0.2s ease 2.8s forwards; }
  .anim-glow { animation: glow-in 0.5s ease 0.3s forwards, glow-out 0.5s ease 2.7s forwards; }
  .anim-progress { animation: progress-fill 2s ease 0.3s forwards, progress-erase 0.5s ease 2.7s forwards; }

  @keyframes step-in {
    from { opacity: 0; transform: scale(0.8) translateY(8px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
  @keyframes step-out {
    from { opacity: 1; transform: scale(1); }
    to { opacity: 0; transform: scale(0.9); }
  }
  @keyframes arrow-in {
    from { opacity: 0; }
    to { opacity: 0.6; }
  }
  @keyframes arrow-out {
    from { opacity: 0.6; }
    to { opacity: 0; }
  }
  @keyframes check-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes check-erase {
    to { stroke-dashoffset: 40; }
  }
  @keyframes sparkle-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes sparkle-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  @keyframes glow-in {
    from { opacity: 0; }
    to { opacity: 0.02; }
  }
  @keyframes glow-out {
    from { opacity: 0.02; }
    to { opacity: 0; }
  }
  @keyframes progress-fill {
    from { stroke-dashoffset: 296; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes progress-erase {
    from { stroke-dashoffset: 0; }
    to { stroke-dashoffset: 296; }
  }

  @media (prefers-reduced-motion: reduce) {
    .anim-step, .anim-arrow, .anim-check, .anim-sparkle, .anim-glow, .anim-progress {
      animation: none !important;
      opacity: 1;
    }
    .anim-check { stroke-dashoffset: 0; }
    .anim-progress { stroke-dashoffset: 0; }
  }
</style>

<script>
  function initFilters() {
    const buttons = document.querySelectorAll('.filter-btn');
    const subBtns = document.querySelectorAll('.subfilter-btn');
    const subContainer = document.getElementById('work-subfilters');
    const cards = document.querySelectorAll('.work-card');
    const empty = document.getElementById('work-empty');
    let activeCategory = 'all';
    let activeSubcategory = 'all';

    function applyFilters() {
      let visibleCount = 0;
      cards.forEach((card) => {
        const cardCat = (card as HTMLElement).dataset.category;
        const cardSub = (card as HTMLElement).dataset.subcategory || '';
        const matchCat = activeCategory === 'all' || cardCat === activeCategory;
        const matchSub = activeSubcategory === 'all' || cardSub === activeSubcategory;
        if (matchCat && matchSub) {
          (card as HTMLElement).classList.remove('is-hidden');
          visibleCount++;
        } else {
          (card as HTMLElement).classList.add('is-hidden');
        }
      });
      empty?.classList.toggle('hidden', visibleCount > 0);
    }

    const grid = document.getElementById('work-grid');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeCategory = (btn as HTMLElement).dataset.category || 'all';
        activeSubcategory = 'all';
        subBtns.forEach((b) => b.classList.remove('active'));
        subBtns[0]?.classList.add('active');
        // Show subfilters only for Design Graphique
        subContainer?.classList.toggle('hidden', activeCategory !== 'Design Graphique');
        applyFilters();
        // Scroll to grid
        grid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    subBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        subBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeSubcategory = (btn as HTMLElement).dataset.subcategory || 'all';
        applyFilters();
      });
    });
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initFilters)
    : initFilters();

  // Loop animation every 3s
  const workSvg = document.getElementById('work-process-svg');
  if (workSvg) {
    setInterval(() => {
      workSvg.querySelectorAll('.anim-step, .anim-arrow, .anim-check, .anim-sparkle, .anim-glow, .anim-progress').forEach(el => {
        const clone = el.cloneNode(true);
        el.parentNode?.replaceChild(clone, el);
      });
    }, 3000);
  }
</script>
