---
import data from '../../../public/data/portfolio.json';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import Container from '../../components/Container.astro';

const profile = data.profile;
const caseStudies = data.caseStudies || [];
const designSubcategories = data.designSubcategories || [];

// Extract unique categories (first part before "·")
const categories = [...new Set(
  caseStudies.map((s: any) => s.category.split('·')[0].trim())
)] as string[];
---

<Layout title="Work — Portfolio">
  <Header />
  <main>
    <section class="work-hero min-h-[70vh] flex flex-col justify-center pt-20 sm:min-h-0 sm:block sm:pt-28 pb-20 md:pt-40 md:pb-24">
      <Container>
        <h1 class="text-3xl sm:text-4xl md:text-6xl lg:text-7xl font-bold leading-none tracking-[-0.03em]" style="color: var(--fg);">
          Tous mes<br/>
          <span style="color: var(--fg-tertiary);">projets.</span>
        </h1>
        <p class="mt-6 text-base sm:text-lg leading-relaxed max-w-2xl" style="color: var(--fg-secondary);">
          Une sélection de projets en branding, UI/UX, développement frontend et logo design.
        </p>

        <!-- Category Filters -->
        <div class="mt-10 flex flex-wrap gap-2" id="work-filters">
          <button
            class="filter-btn active px-4 py-2 text-xs font-mono uppercase tracking-wider transition-all duration-300"
            data-category="all"
          >
            Tous
          </button>
          {categories.map((cat: string) => (
            <button
              class="filter-btn px-4 py-2 text-xs font-mono uppercase tracking-wider transition-all duration-300"
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>

        <!-- Subcategory Filters (Design Graphique only) -->
        <div class="mt-3 flex flex-wrap gap-2 hidden" id="work-subfilters">
          <button
            class="subfilter-btn active px-3 py-1.5 text-[10px] font-mono uppercase tracking-wider transition-all duration-300"
            data-subcategory="all"
          >
            Tous
          </button>
          {designSubcategories.map((sub: any) => (
            <button
              class="subfilter-btn px-3 py-1.5 text-[10px] font-mono uppercase tracking-wider transition-all duration-300"
              data-subcategory={sub.id}
            >
              {sub.label}
            </button>
          ))}
        </div>
      </Container>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <section class="section">
      <Container>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 gsap-stagger-grid" id="work-grid">
          {caseStudies.map((study: any) => {
            const mainCategory = study.category.split('·')[0].trim();
            const subCategory = (study.category.split('·')[1] || '').trim();
            return (
              <a
                href={`/work/${study.slug}`}
                class="group block no-underline work-card"
                style="border: 1px solid var(--border);"
                data-category={mainCategory}
                data-subcategory={subCategory}
              >
                <div class="aspect-video flex items-center justify-center transition-all duration-500 relative overflow-hidden" style={`background: ${study.heroColor || 'var(--bg-raised)'};`}>
                  <span class="font-mono text-xs uppercase tracking-widest opacity-30" style="color: var(--fg);">{study.category}</span>
                  <!-- Hover overlay -->
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500" style="background: rgba(0,0,0,0.4);">
                    <span class="text-sm font-medium" style="color: #fff;"><span data-fr="Voir le projet →" data-en="View project →">Voir le projet →</span></span>
                  </div>
                </div>
                <div class="p-6" style="border-top: 1px solid var(--border);">
                  <div class="flex items-center justify-between">
                    <h2 class="text-base font-semibold" style="color: var(--fg);"><span data-fr={study.title} data-en={study.titleEn || study.title}>{study.title}</span></h2>
                    <span class="text-xs font-mono" style="color: var(--fg-muted);">{study.year}</span>
                  </div>
                  <p class="mt-3 text-sm leading-relaxed" style="color: var(--fg-secondary);"><span data-fr={study.description} data-en={study.descriptionEn || study.description}>{study.description}</span></p>
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {study.tags?.map((tag: string, i: number) => (
                      <span class="px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider" style="color: var(--fg-muted); border: 1px solid var(--border);"><span data-fr={tag} data-en={study.tagsEn?.[i] || tag}>{tag}</span></span>
                    ))}
                  </div>
                </div>
              </a>
            );
          })}
        </div>

        <!-- Empty state -->
        <div id="work-empty" class="hidden text-center py-20">
          <p class="text-sm" style="color: var(--fg-muted);">Aucun projet dans cette catégorie.</p>
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <section class="section" style="border-top: 1px solid var(--border);">
      <Container class="text-center">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold" style="color: var(--fg);">Envie de collaborer?</h2>
        <p class="mt-4 max-w-lg mx-auto" style="color: var(--fg-secondary);">
          Chaque projet est une nouvelle aventure. Parlons du vôtre.
        </p>
        <div class="mt-8 flex flex-col items-center gap-3 w-full max-w-[280px] mx-auto">
          <a href="/contact" class="px-6 py-3 text-sm font-medium no-underline transition-all text-center w-full" style="background: var(--fg); color: var(--bg);" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
            Nous contacter
          </a>
          <a href={`https://wa.me/${profile.whatsapp || '25761729788'}`} target="_blank" rel="noopener noreferrer" class="px-6 py-3 text-sm no-underline transition-all border w-full text-center" style="color: var(--fg-secondary); border-color: var(--border); background: var(--bg);" onmouseover="this.style.color='var(--fg)'; this.style.borderColor='var(--border-hover)'" onmouseout="this.style.color='var(--fg-secondary)'; this.style.borderColor='var(--border)'">
            <span class="inline-flex items-center gap-2">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </span>
          </a>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
  <ScrollReveal />
</Layout>

<style>
  .work-hero {
    position: relative;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 60px 60px;
    background-position: center center;
    background-blend-mode: overlay;
  }
  .work-hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120px;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  .filter-btn {
    color: var(--fg-muted);
    border: 1px solid var(--border);
    background: var(--bg);
  }
  .filter-btn:hover {
    color: var(--fg);
    border-color: var(--border-hover);
  }
  .filter-btn.active {
    color: var(--bg);
    background: var(--fg);
    border-color: var(--fg);
  }
  .work-card {
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .work-card.is-hidden {
    display: none;
  }
  .subfilter-btn {
    color: var(--fg-muted);
    border: 1px solid var(--border);
    background: var(--bg);
  }
  .subfilter-btn:hover {
    color: var(--fg);
    border-color: var(--border-hover);
  }
  .subfilter-btn.active {
    color: var(--bg);
    background: var(--fg);
    border-color: var(--fg);
  }
</style>

<script>
  function initFilters() {
    const buttons = document.querySelectorAll('.filter-btn');
    const subBtns = document.querySelectorAll('.subfilter-btn');
    const subContainer = document.getElementById('work-subfilters');
    const cards = document.querySelectorAll('.work-card');
    const empty = document.getElementById('work-empty');
    let activeCategory = 'all';
    let activeSubcategory = 'all';

    function applyFilters() {
      let visibleCount = 0;
      cards.forEach((card) => {
        const cardCat = (card as HTMLElement).dataset.category;
        const cardSub = (card as HTMLElement).dataset.subcategory || '';
        const matchCat = activeCategory === 'all' || cardCat === activeCategory;
        const matchSub = activeSubcategory === 'all' || cardSub === activeSubcategory;
        if (matchCat && matchSub) {
          (card as HTMLElement).classList.remove('is-hidden');
          visibleCount++;
        } else {
          (card as HTMLElement).classList.add('is-hidden');
        }
      });
      empty?.classList.toggle('hidden', visibleCount > 0);
    }

    const grid = document.getElementById('work-grid');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeCategory = (btn as HTMLElement).dataset.category || 'all';
        activeSubcategory = 'all';
        subBtns.forEach((b) => b.classList.remove('active'));
        subBtns[0]?.classList.add('active');
        // Show subfilters only for Design Graphique
        subContainer?.classList.toggle('hidden', activeCategory !== 'Design Graphique');
        applyFilters();
        // Scroll to grid
        grid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    subBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        subBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeSubcategory = (btn as HTMLElement).dataset.subcategory || 'all';
        applyFilters();
      });
    });
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initFilters)
    : initFilters();
</script>
