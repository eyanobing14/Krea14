---
import data from "../../public/data/portfolio.json";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import Container from "../components/Container.astro";

const profile = data.profile;
const services = data.services || [];
const caseStudies = (data.caseStudies || []).slice(0, 3);
---

<Layout title={`${profile.name} — ${profile.title}`}>
  <Header />
  <main>
    <!-- Hero -->
    <section
      class="relative flex flex-col justify-between pb-14 sm:pb-16 md:pb-24 pt-20 sm:pt-28 overflow-clip min-h-[100dvh]"
    >
      <div
        class="absolute inset-0 opacity-[0.07] gsap-parallax"
        data-speed="0.2"
        aria-hidden="true"
        style="background-image: linear-gradient(to right, var(--fg) 1px, transparent 1px), linear-gradient(to bottom, var(--fg) 1px, transparent 1px); background-size: 80px 80px;"
      >
      </div>

      <!-- Horizontal scrolling text -->
      <Container class="relative w-full my-auto py-10 md:py-16">
        <div class="overflow-clip max-w-full">
          <div class="hero-scroll-track">
            <div class="hero-scroll-inner">
              <span class="hero-scroll-text">Graphic Design</span>
              <span class="hero-scroll-sep" aria-hidden="true">—</span>
              <span class="hero-scroll-text">UI/UX Design</span>
              <span class="hero-scroll-sep" aria-hidden="true">—</span>
              <span class="hero-scroll-text">Frontend Development</span>
              <span class="hero-scroll-sep" aria-hidden="true">—</span>
              <span class="hero-scroll-text">Logo Design</span>
              <span class="hero-scroll-sep" aria-hidden="true">—</span>
            </div>
            <div class="hero-scroll-inner" aria-hidden="true">
              <span class="hero-scroll-text">Graphic Design</span>
              <span class="hero-scroll-sep">—</span>
              <span class="hero-scroll-text">UI/UX Design</span>
              <span class="hero-scroll-sep">—</span>
              <span class="hero-scroll-text">Frontend Development</span>
              <span class="hero-scroll-sep">—</span>
              <span class="hero-scroll-text">Logo Design</span>
              <span class="hero-scroll-sep">—</span>
            </div>
          </div>
        </div>
      </Container>

      <!-- Bottom content -->
      <Container class="relative w-full">
        <div
          class="flex flex-col md:flex-row md:items-end md:justify-between gap-8"
        >
          <div class="min-w-0 max-w-xl">
            <p
              class="hero-desc text-base md:text-lg leading-relaxed animate-in"
              style="color: var(--fg-secondary);"
            >
              {profile.tagline} Nous transformons des idées en expériences numériques
              mémorables.
            </p>
            <div class="hero-actions mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 animate-in" style="--delay: 0.15s;">
              <a
                href="/work"
                class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-medium no-underline transition-all duration-200 min-w-[160px]"
                style="background: var(--fg); color: var(--bg);"
                onmouseover="this.style.opacity='0.85'"
                onmouseout="this.style.opacity='1'"
              >
                Voir mes projets
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none"
                  ><path
                    d="M2 6H10M7 3L10 6L7 9"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
              </a>
              <a
                href="/about"
                class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm no-underline transition-all duration-200 min-w-[160px]"
                style="color: var(--fg-secondary); border: 1px solid var(--border-strong); background: var(--bg);"
                onmouseover="this.style.color='var(--fg)'; this.style.borderColor='var(--fg-muted)'"
                onmouseout="this.style.color='var(--fg-secondary)'; this.style.borderColor='var(--border-strong)'"
              >
                En savoir plus
              </a>
            </div>
          </div>

          <div class="hero-metrics flex flex-wrap gap-6 sm:gap-10 md:gap-14 min-w-0 animate-in" style="--delay: 0.3s;">
            <div>
              <div
                class="font-mono text-2xl md:text-3xl font-semibold tabular-nums"
                style="color: var(--fg);"
              >
                50+
              </div>
              <div
                class="mt-1 text-xs uppercase tracking-widest font-mono"
                style="color: var(--fg-muted);"
              >
                projets livrés
              </div>
            </div>
            <div>
              <div
                class="font-mono text-2xl md:text-3xl font-semibold tabular-nums"
                style="color: var(--fg);"
              >
                5+
              </div>
              <div
                class="mt-1 text-xs uppercase tracking-widest font-mono"
                style="color: var(--fg-muted);"
              >
                ans d'expérience
              </div>
            </div>
            <div>
              <div
                class="font-mono text-2xl md:text-3xl font-semibold tabular-nums"
                style="color: var(--fg);"
              >
                30+
              </div>
              <div
                class="mt-1 text-xs uppercase tracking-widest font-mono"
                style="color: var(--fg-muted);"
              >
                clients satisfaits
              </div>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Featured Work -->
    <section class="section">
      <Container>
        <div
          class="flex flex-col md:flex-row md:items-end md:justify-between gap-6"
        >
          <div class="max-w-2xl">
            <h2
              class="text-3xl sm:text-4xl md:text-5xl font-bold leading-[1.05] tracking-[-0.02em]"
              style="color: var(--fg);"
            >
              Travail récent.
            </h2>
          </div>
          <a
            href="/work"
            class="text-sm no-underline transition-colors duration-200"
            style="color: var(--fg-secondary);"
            onmouseover="this.style.color='var(--fg)'"
            onmouseout="this.style.color='var(--fg-secondary)'"
          >
            Voir tous les projets →
          </a>
        </div>

        <div
          class="mt-10 md:mt-16 lg:mt-20 grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4 gsap-stagger-grid"
        >
          {
            caseStudies.map((study: any) => (
              <a
                href={`/work/${study.slug}`}
                class="group block no-underline"
                style="border: 1px solid var(--border);"
              >
                <div
                  class="aspect-4/3 flex items-center justify-center transition-all duration-500"
                  style={`background: ${study.heroColor || "var(--bg-raised)"};`}
                >
                  <span
                    class="font-mono text-xs uppercase tracking-widest opacity-30"
                    style="color: var(--fg);"
                  >
                    {study.category}
                  </span>
                </div>
                <div class="p-5" style="border-top: 1px solid var(--border);">
                  <div class="flex items-center justify-between">
                    <h3 class="text-sm font-semibold" style="color: var(--fg);">
                      {study.title}
                    </h3>
                    <span
                      class="text-xs font-mono"
                      style="color: var(--fg-muted);"
                    >
                      {study.year}
                    </span>
                  </div>
                  <p
                    class="mt-2 text-xs leading-relaxed"
                    style="color: var(--fg-secondary); overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;"
                  >
                    {study.description}
                  </p>
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {study.tags?.slice(0, 3).map((tag: string) => (
                      <span
                        class="px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider"
                        style="color: var(--fg-muted); border: 1px solid var(--border);"
                      >
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </Container>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Services -->
    <section class="section" style="background: var(--bg-raised);">
      <Container>
        <div class="max-w-2xl">
          <h2
            class="text-3xl sm:text-4xl md:text-5xl font-bold leading-[1.05] tracking-[-0.02em]"
            style="color: var(--fg);"
          >
            Ce que nous faisons.
          </h2>
        </div>

        <div
          class="mt-10 md:mt-16 lg:mt-20 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 gsap-stagger-grid"
        >
          {
            services.map((service: any) => (
              <div
                class="p-6 transition-colors duration-300"
                style="border: 1px solid var(--border);"
                onmouseover="this.style.borderColor='var(--border-hover)'"
                onmouseout="this.style.borderColor='var(--border)'"
              >
                <h3 class="text-sm font-semibold" style="color: var(--fg);">
                  {service.title}
                </h3>
                <p
                  class="mt-3 text-xs leading-relaxed"
                  style="color: var(--fg-secondary);"
                >
                  {service.description}
                </p>
              </div>
            ))
          }
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <section class="section" style="border-top: 1px solid var(--border);">
      <Container class="text-center">
        <h2 class="text-3xl sm:text-4xl font-bold" style="color: var(--fg);">
          Un projet en tête?
        </h2>
        <p class="mt-4 max-w-lg mx-auto" style="color: var(--fg-secondary);">
          Discutons de votre prochain projet. Nous sommes disponibles pour du
          freelance.
        </p>
        <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4">
          <a
            href="/contact"
            class="px-6 py-3 text-sm font-medium no-underline transition-all text-center min-w-[160px]"
            style="background: var(--fg); color: var(--bg);"
            onmouseover="this.style.opacity='0.85'"
            onmouseout="this.style.opacity='1'"
          >
            Nous contacter
          </a>
          <a
            href="/work"
            class="px-6 py-3 text-sm no-underline transition-all text-center min-w-[160px]"
            style="color: var(--fg-secondary); border: 1px solid var(--border-strong); background: var(--bg);"
            onmouseover="this.style.color='var(--fg)'"
            onmouseout="this.style.color='var(--fg-secondary)'"
          >
            Voir le portfolio
          </a>
          <a
            href="https://wa.me/25761729788"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 text-sm no-underline transition-all text-center min-w-[160px]"
            style="color: var(--fg-secondary); border: 1px solid var(--border-strong); background: var(--bg);"
            onmouseover="this.style.color='var(--fg)'"
            onmouseout="this.style.color='var(--fg-secondary)'"
          >
            <span class="inline-flex items-center gap-2 justify-center">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </span>
          </a>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
  <ScrollReveal />
</Layout>

<style>
  /* ── Horizontal scroll text ── */
  .hero-scroll-track {
    display: flex;
    width: max-content;
    animation: hero-scroll 60s linear infinite;
  }
  .hero-scroll-inner {
    display: flex;
    align-items: center;
    gap: 0;
    flex-shrink: 0;
    padding-right: 0;
  }
  .hero-scroll-text {
    font-size: clamp(1.5rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--fg);
    white-space: nowrap;
    padding: 0 0.75rem;
  }
  .hero-scroll-sep {
    font-size: clamp(1.5rem, 4vw, 3.5rem);
    font-weight: 300;
    color: var(--fg-muted);
    padding: 0 0.5rem;
    flex-shrink: 0;
  }

  @keyframes hero-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-track {
      animation: none;
    }
  }
</style>
