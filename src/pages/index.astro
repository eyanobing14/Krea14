---
import data from "../../public/data/portfolio.json";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import Container from "../components/Container.astro";

const profile = data.profile as typeof data.profile & { taglineEn?: string };
const services = data.services || [];
const caseStudies = (data.caseStudies || []).slice(0, 3);
---

<Layout title={`${profile.name} — ${profile.title}`}>
  <Header />
  <main>
    <!-- Hero -->
    <section
      class="relative flex flex-col justify-between pb-14 sm:pb-16 md:pb-24 pt-20 sm:pt-28 overflow-clip hero-height"
    >
      <div
        class="absolute inset-0 opacity-[0.07] gsap-parallax"
        data-speed="0.2"
        aria-hidden="true"
        style="background-image: linear-gradient(to right, var(--fg) 1px, transparent 1px), linear-gradient(to bottom, var(--fg) 1px, transparent 1px); background-size: 80px 80px;"
      >
      </div>

      <!-- Horizontal scrolling text -->
      <Container class="relative w-full my-auto py-10 md:py-16">
        <div class="overflow-clip max-w-full">
          <div class="hero-scroll-track">
            <div class="hero-scroll-inner">
              <span class="hero-scroll-text">Graphic Design</span>
              <span class="hero-scroll-sep" aria-hidden="true">—</span>
              <span class="hero-scroll-text">UI/UX Design</span>
              <span class="hero-scroll-sep" aria-hidden="true">—</span>
              <span class="hero-scroll-text">Frontend Development</span>
              <span class="hero-scroll-sep" aria-hidden="true">—</span>
              <span class="hero-scroll-text">Logo Design</span>
              <span class="hero-scroll-sep" aria-hidden="true">—</span>
            </div>
            <div class="hero-scroll-inner" aria-hidden="true">
              <span class="hero-scroll-text">Graphic Design</span>
              <span class="hero-scroll-sep">—</span>
              <span class="hero-scroll-text">UI/UX Design</span>
              <span class="hero-scroll-sep">—</span>
              <span class="hero-scroll-text">Frontend Development</span>
              <span class="hero-scroll-sep">—</span>
              <span class="hero-scroll-text">Logo Design</span>
              <span class="hero-scroll-sep">—</span>
            </div>
          </div>
        </div>
      </Container>

      <!-- Bottom content -->
      <Container class="relative w-full">
        <div
          class="flex flex-col md:flex-row md:items-end md:justify-between gap-8"
        >
          <div class="min-w-0 max-w-xl">
            <p
              class="hero-desc text-base md:text-lg leading-relaxed animate-in"
              style="color: var(--fg-secondary);"
            >
              <span data-fr={`${profile.tagline} Nous transformons des idées en expériences numériques mémorables.`} data-en={`${profile.taglineEn || 'We create digital experiences that leave a mark.'} We turn ideas into memorable digital experiences.`}>{profile.tagline} Nous transformons des idées en expériences numériques
              mémorables.</span>
            </p>
            <div class="hero-actions mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 animate-in" style="--delay: 0.15s;">
              <a
                href="/work"
                class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-medium no-underline transition-all duration-200 min-w-[160px]"
                style="background: var(--fg); color: var(--bg);"
                onmouseover="this.style.opacity='0.85'"
                onmouseout="this.style.opacity='1'"
              >
                Voir mes projets
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none"
                  ><path
                    d="M2 6H10M7 3L10 6L7 9"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
              </a>
              <a
                href="/about"
                class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm no-underline transition-all duration-200 min-w-[160px]"
                style="color: var(--fg-secondary); border: 1px solid var(--border-strong); background: var(--bg);"
                onmouseover="this.style.color='var(--fg)'; this.style.borderColor='var(--fg-muted)'"
                onmouseout="this.style.color='var(--fg-secondary)'; this.style.borderColor='var(--border-strong)'"
              >
                En savoir plus
              </a>
            </div>
          </div>

          <div class="hero-metrics flex flex-wrap gap-6 sm:gap-10 md:gap-14 min-w-0 animate-in" style="--delay: 0.3s;">
            <div>
              <div
                class="font-mono text-2xl md:text-3xl font-semibold tabular-nums"
                style="color: var(--fg);"
              >
                50+
              </div>
              <div
                class="mt-1 text-xs uppercase tracking-widest font-mono"
                style="color: var(--fg-muted);"
              >
                projets livrés
              </div>
            </div>
            <div>
              <div
                class="font-mono text-2xl md:text-3xl font-semibold tabular-nums"
                style="color: var(--fg);"
              >
                5+
              </div>
              <div
                class="mt-1 text-xs uppercase tracking-widest font-mono"
                style="color: var(--fg-muted);"
              >
                ans d'expérience
              </div>
            </div>
            <div>
              <div
                class="font-mono text-2xl md:text-3xl font-semibold tabular-nums"
                style="color: var(--fg);"
              >
                30+
              </div>
              <div
                class="mt-1 text-xs uppercase tracking-widest font-mono"
                style="color: var(--fg-muted);"
              >
                clients satisfaits
              </div>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Featured Work -->
    <section class="section">
      <Container>
        <div
          class="flex flex-col md:flex-row md:items-end md:justify-between gap-6"
        >
          <div class="max-w-2xl">
            <h2
              class="text-3xl sm:text-4xl md:text-5xl font-bold leading-[1.05] tracking-[-0.02em]"
              style="color: var(--fg);"
            >
              Travail récent.
            </h2>
          </div>
          <a
            href="/work"
            class="text-sm no-underline transition-colors duration-200"
            style="color: var(--fg-secondary);"
            onmouseover="this.style.color='var(--fg)'"
            onmouseout="this.style.color='var(--fg-secondary)'"
          >
            Voir tous les projets →
          </a>
        </div>

        <div
          class="mt-10 md:mt-16 lg:mt-20 grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4 gsap-stagger-grid"
        >
          {
            caseStudies.map((study: any) => (
              <a
                href={`/work/${study.slug}`}
                class="group block no-underline"
                style="border: 1px solid var(--border);"
              >
                <div
                  class="aspect-4/3 flex items-center justify-center transition-all duration-500"
                  style={`background: ${study.heroColor || "var(--bg-raised)"};`}
                >
                  <span
                    class="font-mono text-xs uppercase tracking-widest opacity-30"
                    style="color: var(--fg);"
                  >
                    {study.category}
                  </span>
                </div>
                <div class="p-5" style="border-top: 1px solid var(--border);">
                  <div class="flex items-center justify-between">
                    <h3 class="text-base sm:text-lg font-semibold" style="color: var(--fg);">
                      <span data-fr={study.title} data-en={study.titleEn || study.title}>{study.title}</span>
                    </h3>
                    <span
                      class="text-xs font-mono"
                      style="color: var(--fg-muted);"
                    >
                      {study.year}
                    </span>
                  </div>
                  <p
                    class="mt-2 text-sm leading-relaxed"
                    style="color: var(--fg-secondary); overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;"
                  ><span data-fr={study.description} data-en={study.descriptionEn || study.description}>{study.description}</span>
                  </p>
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {study.tags?.slice(0, 3).map((tag: string, i: number) => (
                      <span
                        class="px-2.5 py-1 text-[11px] font-mono uppercase tracking-wider"
                        style="color: var(--fg-muted); border: 1px solid var(--border);"
                      ><span data-fr={tag} data-en={study.tagsEn?.[i] || tag}>{tag}</span>
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </Container>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Services -->
    <section class="section" style="background: var(--bg-raised);">
      <Container>
        <div class="max-w-2xl">
          <h2
            class="text-3xl sm:text-4xl md:text-5xl font-bold leading-[1.05] tracking-[-0.02em]"
            style="color: var(--fg);"
          >
            Ce que nous faisons.
          </h2>
        </div>

        <div
          class="mt-10 md:mt-16 lg:mt-20 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 gsap-stagger-grid"
        >
          {
            services.map((service: any) => (
              <div class="service-card p-7 transition-colors duration-300"
                style="border: 1px solid var(--border);"
                onmouseover="this.style.borderColor='var(--border-hover)'"
                onmouseout="this.style.borderColor='var(--border)'"
              >
                <div class="service-icon">
                  <svg viewBox="0 0 48 48" fill="none" class="service-illust">
                    {service.title === 'Design Graphique' && (
                      <g>
                        <rect x="8" y="8" width="32" height="32" rx="4" stroke="var(--fg)" stroke-width="1.5" fill="none" class="svc-shape"/>
                        <circle cx="20" cy="20" r="6" stroke="var(--fg-muted)" stroke-width="1" fill="none" class="svc-orbit"/>
                        <circle cx="20" cy="20" r="2" fill="var(--fg)" opacity="0.3"/>
                        <line x1="28" y1="28" x2="36" y2="36" stroke="var(--fg-muted)" stroke-width="1" stroke-dasharray="2 2" class="svc-line"/>
                      </g>
                    )}
                    {service.title === 'UI/UX Design' && (
                      <g>
                        <rect x="6" y="10" width="16" height="28" rx="3" stroke="var(--fg)" stroke-width="1.5" fill="none" class="svc-phone"/>
                        <line x1="10" y1="18" x2="18" y2="18" stroke="var(--fg-muted)" stroke-width="1"/>
                        <line x1="10" y1="22" x2="16" y2="22" stroke="var(--fg-muted)" stroke-width="1"/>
                        <rect x="26" y="14" width="16" height="20" rx="2" stroke="var(--fg-muted)" stroke-width="1" fill="none" class="svc-screen"/>
                        <circle cx="34" cy="24" r="4" stroke="var(--fg)" stroke-width="1" fill="none" class="svc-pulse"/>
                      </g>
                    )}
                    {service.title === 'Développement Frontend' && (
                      <g>
                        <text x="8" y="22" fill="var(--fg)" font-size="14" font-family="var(--font-mono)" class="svc-bracket">&lt;/&gt;</text>
                        <line x1="8" y1="28" x2="40" y2="28" stroke="var(--fg-muted)" stroke-width="0.75" stroke-dasharray="3 2" class="svc-line"/>
                        <circle cx="14" cy="36" r="3" stroke="var(--fg-muted)" stroke-width="1" fill="none"/>
                        <circle cx="24" cy="36" r="3" stroke="var(--fg)" stroke-width="1" fill="none"/>
                        <circle cx="34" cy="36" r="3" stroke="var(--fg-muted)" stroke-width="1" fill="none"/>
                      </g>
                    )}
                    {service.title === 'Logo Design' && (
                      <g>
                        <circle cx="24" cy="22" r="12" stroke="var(--fg)" stroke-width="1.5" fill="none" class="svc-ring"/>
                        <path d="M18 22 L22 28 L30 18" stroke="var(--fg-muted)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" class="svc-check"/>
                        <line x1="24" y1="38" x2="24" y2="42" stroke="var(--fg-muted)" stroke-width="1"/>
                      </g>
                    )}
                  </svg>
                </div>
                <h3 class="text-base sm:text-lg font-semibold" style="color: var(--fg);">
                  {service.title}
                </h3>
                <p
                  class="mt-3 text-sm leading-relaxed"
                  style="color: var(--fg-secondary);"
                >
                  {service.description}
                </p>
              </div>
            ))
          }
        </div>
      </Container>
    </section>

    <!-- Animated Orbital Skills -->
    <section class="section">
      <Container>
        <div class="max-w-2xl text-center mx-auto">
          <h2
            class="text-3xl sm:text-4xl md:text-5xl font-bold leading-[1.05] tracking-[-0.02em] animate-in"
            style="color: var(--fg);"
          >
            <span data-fr="Notre expertise." data-en="Our expertise.">Notre expertise.</span>
          </h2>
          <p
            class="mt-4 text-base sm:text-lg max-w-xl mx-auto animate-in"
            style="color: var(--fg-secondary); --delay: 0.1s;"
          >
            <span data-fr="Un écosystème de compétences combinées pour chaque projet." data-en="A combined ecosystem of skills for every project.">Un écosystème de compétences combinées pour chaque projet.</span>
          </p>
        </div>

        <div class="orbital-container animate-in" style="--delay: 0.2s;">
          <div class="orbital-system">
            <!-- Center -->
            <div class="orbital-center">
              <img src="/favicon.svg" alt="" class="w-8 h-8" style="filter: invert(var(--logo-invert, 0));" />
            </div>

            <!-- Orbit rings -->
            <div class="orbital-ring orbital-ring--1"></div>
            <div class="orbital-ring orbital-ring--2"></div>
            <div class="orbital-ring orbital-ring--3"></div>

            <!-- Ring 1 — inner -->
            <div class="orbital-item" style="--r: 90px; --start: 0deg; --speed: 22s;">
              <span class="orbital-label"><span data-fr="UI/UX" data-en="UI/UX">UI/UX</span></span>
            </div>
            <div class="orbital-item" style="--r: 90px; --start: 180deg; --speed: 22s;">
              <span class="orbital-label"><span data-fr="Design System" data-en="Design System">Design System</span></span>
            </div>

            <!-- Ring 2 — middle -->
            <div class="orbital-item" style="--r: 140px; --start: 30deg; --speed: 30s;">
              <span class="orbital-label"><span data-fr="Performance" data-en="Performance">Performance</span></span>
            </div>
            <div class="orbital-item" style="--r: 140px; --start: 150deg; --speed: 30s;">
              <span class="orbital-label"><span data-fr="Accessibilité" data-en="Accessibility">Accessibilité</span></span>
            </div>
            <div class="orbital-item" style="--r: 140px; --start: 270deg; --speed: 30s;">
              <span class="orbital-label"><span data-fr="Animation" data-en="Animation">Animation</span></span>
            </div>

            <!-- Ring 3 — outer -->
            <div class="orbital-item" style="--r: 190px; --start: 0deg; --speed: 40s;">
              <span class="orbital-label"><span data-fr="Responsive" data-en="Responsive">Responsive</span></span>
            </div>
            <div class="orbital-item" style="--r: 190px; --start: 90deg; --speed: 40s;">
              <span class="orbital-label"><span data-fr="Architecture" data-en="Architecture">Architecture</span></span>
            </div>
            <div class="orbital-item" style="--r: 190px; --start: 180deg; --speed: 40s;">
              <span class="orbital-label"><span data-fr="DevOps" data-en="DevOps">DevOps</span></span>
            </div>
            <div class="orbital-item" style="--r: 190px; --start: 270deg; --speed: 40s;">
              <span class="orbital-label"><span data-fr="API Design" data-en="API Design">API Design</span></span>
            </div>

            <!-- Ambient particles -->
            <div class="orbital-particle orbital-particle--1"></div>
            <div class="orbital-particle orbital-particle--2"></div>
            <div class="orbital-particle orbital-particle--3"></div>
            <div class="orbital-particle orbital-particle--4"></div>
            <div class="orbital-particle orbital-particle--5"></div>
          </div>
        </div>
      </Container>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <!-- CTA -->
    <section class="section">
      <Container class="text-center">
        <h2 class="text-3xl sm:text-4xl font-bold" style="color: var(--fg);">
          Un projet en tête?
        </h2>
        <p class="mt-4 max-w-lg mx-auto" style="color: var(--fg-secondary);">
          Discutons de votre prochain projet. Nous sommes disponibles pour du
          freelance.
        </p>
        <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4">
          <a
            href="/contact"
            class="px-6 py-3 text-sm font-medium no-underline transition-all text-center min-w-[160px]"
            style="background: var(--fg); color: var(--bg);"
            onmouseover="this.style.opacity='0.85'"
            onmouseout="this.style.opacity='1'"
          >
            Nous contacter
          </a>
          <a
            href="/work"
            class="px-6 py-3 text-sm no-underline transition-all text-center min-w-[160px]"
            style="color: var(--fg-secondary); border: 1px solid var(--border-strong); background: var(--bg);"
            onmouseover="this.style.color='var(--fg)'"
            onmouseout="this.style.color='var(--fg-secondary)'"
          >
            Voir le portfolio
          </a>
          <a
            href={`https://wa.me/${profile.whatsapp || '25761729788'}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 text-sm no-underline transition-all text-center min-w-[160px]"
            style="color: var(--fg-secondary); border: 1px solid var(--border-strong); background: var(--bg);"
            onmouseover="this.style.color='var(--fg)'"
            onmouseout="this.style.color='var(--fg-secondary)'"
          >
            <span class="inline-flex items-center gap-2 justify-center">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </span>
          </a>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
  <ScrollReveal />
</Layout>

<style>
  :root { --logo-invert: 0; }
  :root:not([data-theme="light"]) { --logo-invert: 1; }
  /* ── Horizontal scroll text ── */
  .hero-scroll-track {
    display: flex;
    width: max-content;
    animation: hero-scroll 60s linear infinite;
  }
  .hero-scroll-inner {
    display: flex;
    align-items: center;
    gap: 0;
    flex-shrink: 0;
    padding-right: 0;
  }
  .hero-scroll-text {
    font-size: clamp(1.5rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--fg);
    white-space: nowrap;
    padding: 0 0.75rem;
  }
  .hero-scroll-sep {
    font-size: clamp(1.5rem, 4vw, 3.5rem);
    font-weight: 300;
    color: var(--fg-muted);
    padding: 0 0.5rem;
    flex-shrink: 0;
  }

  @keyframes hero-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Hauteur hero stable — pas de saut sur mobile */
  .hero-height {
    min-height: 100vh; /* stable, pas de resize avec la barre d'adresse */
  }
  @supports (height: 100dvh) {
    .hero-height {
      min-height: 100dvh; /* desktop: dvh ok */
    }
  }
  @media (max-width: 768px) {
    .hero-height {
      min-height: 100vh; /* mobile: forcer 100vh pour éviter le saut */
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-track {
      animation: none;
    }
  }

  /* ── Orbital Skills ── */
  .orbital-container {
    display: flex;
    justify-content: center;
    padding: 2rem 0;
  }
  .orbital-system {
    position: relative;
    width: 400px;
    height: 400px;
  }
  .orbital-center {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 64px; height: 64px;
    border: 1px solid var(--border-hover);
    display: flex; align-items: center; justify-content: center;
    background: var(--bg);
    z-index: 3;
  }
  .orbital-center-text {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
  }
  .orbital-ring {
    position: absolute;
    top: 50%; left: 50%;
    border: 1px dashed var(--border);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .orbital-ring--1 { width: 180px; height: 180px; }
  .orbital-ring--2 { width: 280px; height: 280px; }
  .orbital-ring--3 { width: 380px; height: 380px; }
  .orbital-item {
    position: absolute;
    top: 50%; left: 50%;
    width: 0; height: 0;
    transform: rotate(var(--start, 0deg)) translateX(var(--r, 90px)) rotate(calc(-1 * var(--start, 0deg)));
    animation: orbital-orbit var(--speed, 20s) linear infinite;
    z-index: 2;
  }
  @keyframes orbital-orbit {
    from { transform: rotate(var(--start, 0deg)) translateX(var(--r, 90px)) rotate(calc(-1 * var(--start, 0deg) - 0deg)); }
    to   { transform: rotate(calc(var(--start, 0deg) + 360deg)) translateX(var(--r, 90px)) rotate(calc(-1 * var(--start, 0deg) - 360deg)); }
  }
  .orbital-label {
    position: absolute;
    transform: translate(-50%, -50%);
