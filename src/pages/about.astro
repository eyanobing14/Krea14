---
import data from "../../public/data/portfolio.json";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import Container from "../components/Container.astro";
import ThinkingStyles from "../components/ThinkingStyles.astro";
import ImpactSection from "../components/ImpactSection.astro";
import DevArchitecture from "../components/DevArchitecture.astro";

const profile = data.profile as typeof data.profile & { photo?: string };
const services = data.services || [];
const socials = (profile.socials || {}) as Record<string, string>;
---

<Layout title={`À propos — ${profile.name}`}>
  <Header />
  <main>
    <!-- Hero — Photo centrée + Identité -->
    <section class="pt-24 sm:pt-28 pb-12 md:pt-36 md:pb-20">
      <Container class="flex flex-col items-center text-center">
        <!-- Photo centrée -->
        <div class="animate-in">
          <div
            class="about-photo"
          >
            {
              profile.photo ? (
                <img
                  src={profile.photo}
                  alt={profile.name}
                  class="w-full h-full object-cover"
                />
              ) : (
                <span
                  class="font-mono text-sm uppercase tracking-widest opacity-20"
                  style="color: var(--fg);"
                >
                  Photo
                </span>
              )
            }
          </div>
        </div>

        <!-- Nom + Titre -->
        <h1
          class="mt-8 text-3xl sm:text-4xl md:text-5xl font-bold leading-none tracking-[-0.03em] animate-in"
          style="color: var(--fg); --delay: 0.15s;"
        >
          {profile.name}
        </h1>
        <p
          class="mt-3 text-sm sm:text-base font-mono uppercase tracking-wider animate-in"
          style="color: var(--fg-muted); --delay: 0.25s;"
        >
          {profile.title}
        </p>

        <!-- Bio courte -->
        <p
          class="mt-6 max-w-xl text-base sm:text-lg leading-relaxed animate-in"
          style="color: var(--fg-secondary); --delay: 0.35s;"
        >
          {profile.bio}
        </p>

        <!-- Infos -->
        <div
          class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 animate-in"
          style="--delay: 0.45s;"
        >
          <span class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider" style="color: var(--fg-muted);">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            {profile.location}
          </span>
          <span class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider" style="color: var(--fg-muted);">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            {profile.availability}
          </span>
        </div>

        <!-- Réseaux -->
        <div class="mt-6 flex gap-3 animate-in" style="--delay: 0.55s;">
          {
            Object.entries(socials).map(([name, url]) => (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-9 h-9 flex items-center justify-center transition-colors duration-200 no-underline text-xs font-mono uppercase"
                style="color: var(--fg-muted); border: 1px solid var(--border);"
                onmouseover="this.style.color='var(--fg)'; this.style.borderColor='var(--border-hover)'"
                onmouseout="this.style.color='var(--fg-muted)'; this.style.borderColor='var(--border)'"
              >
                {name[0].toUpperCase()}
              </a>
            ))
          }
        </div>
      </Container>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <!-- L'impact que nous créons -->
    <ImpactSection />

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Nos façons de penser -->
    <ThinkingStyles />

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Architecture Full-Stack -->
    <DevArchitecture />

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Services -->
    <section class="section" style="background: var(--bg-raised);">
      <Container>
        <h2
          class="text-2xl sm:text-3xl md:text-4xl font-bold"
          style="color: var(--fg);"
        >
          Ce que nous maîtrisons.
        </h2>

        <div
          class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-4 gsap-stagger-grid"
        >
          {
            services.map((service: any) => (
              <div
                class="p-6 transition-colors duration-300"
                style="border: 1px solid var(--border);"
                onmouseover="this.style.borderColor='var(--border-hover)'"
                onmouseout="this.style.borderColor='var(--border)'"
              >
                <h3 class="text-sm font-semibold" style="color: var(--fg);">
                  {service.title}
                </h3>
                <p
                  class="mt-3 text-sm leading-relaxed"
                  style="color: var(--fg-secondary);"
                >
                  {service.description}
                </p>
              </div>
            ))
          }
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <section class="section" style="border-top: 1px solid var(--border);">
      <Container class="text-center">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold" style="color: var(--fg);">
          Contactons-nous.
        </h2>
        <p class="mt-4 max-w-lg mx-auto text-base sm:text-lg" style="color: var(--fg-secondary);">
          {profile.availability}.          N'hésitez pas à nous contacter pour discuter de
          votre projet.
        </p>
        <div class="mt-8 flex flex-col items-center gap-3">
          <a
            href={`mailto:${profile.email}`}
            class="px-6 py-3 text-sm font-medium no-underline transition-all w-full max-w-[260px] text-center"
            style="background: var(--fg); color: var(--bg);"
            onmouseover="this.style.opacity='0.85'"
            onmouseout="this.style.opacity='1'"
          >
            Nous contacter
          </a>
          <a
            href="https://wa.me/25761729788"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 text-sm font-medium no-underline transition-all border w-full max-w-[260px] text-center"
            style="color: var(--fg); border-color: var(--border);"
            onmouseover="this.style.borderColor='var(--border-hover)'"
            onmouseout="this.style.borderColor='var(--border)'"
          >
            <span class="inline-flex items-center gap-2 justify-center">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </span>
          </a>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
  <ScrollReveal />
</Layout>

<style>
  .about-photo {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    background: var(--bg-raised);
  }
  @media (min-width: 640px) {
    .about-photo {
      width: 260px;
      height: 260px;
    }
  }
  @media (min-width: 768px) {
    .about-photo {
      width: 300px;
      height: 300px;
    }
  }
</style>
