---
import data from "../../public/data/portfolio.json";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import Container from "../components/Container.astro";
import ThinkingStyles from "../components/ThinkingStyles.astro";
import ImpactSection from "../components/ImpactSection.astro";
import OrbitalSkills from "../components/OrbitalSkills.astro";

const profile = data.profile as typeof data.profile & { photo?: string };
const socials = (profile.socials || {}) as Record<string, string>;
---

<Layout title={`À propos — ${profile.name}`}>
  <Header />
  <main>
    <!-- Hero — Split: Left = photo + icons, Right = name + bio -->
    <section class="about-hero-section pt-24 sm:pt-28 pb-12 md:pt-36 md:pb-20">
      <Container>
        <div class="about-hero">
          <!-- Left: Photo + Social icons -->
          <div class="about-hero-left">
            <div class="about-photo-row">
            <div class="animate-in">
              <div class="about-photo">
                {
                  profile.photo ? (
                    <img
                      src={profile.photo}
                      alt={profile.name}
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <span
                      class="font-mono text-sm uppercase tracking-widest opacity-20"
                      style="color: var(--fg);"
                    >
                      Photo
                    </span>
                  )
                }
                <div class="about-wave">👋</div>
              </div>
            </div>

            <!-- Réseaux à côté de la photo, centrés verticalement -->
            <div class="about-social-icons flex flex-col gap-2 animate-in" style="--delay: 0.2s;">
              {
                Object.entries(socials).map(([name, url]) => (
                  <a
                    href={url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-9 h-9 flex items-center justify-center transition-colors duration-200 no-underline"
                    style="color: var(--fg); background: var(--fg); border: 1px solid var(--border);"
                    onmouseover="this.style.opacity='0.8'"
                    onmouseout="this.style.opacity='1'"
                    aria-label={name}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--bg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      {name === 'dribbble' && <><circle cx="12" cy="12" r="10"/><path d="M8.56 2.75c4.37 6.03 6.02 9.42 8.03 17.72m2.54-15.38c-3.72 4.35-8.94 5.66-16.88 5.85m19.5 1.9c-3.5-.93-6.63-.82-8.94 0-2.58.92-5.01 2.86-7.44 6.32"/></>}
                      {name === 'behance' && <><path d="M1 12.5h8c1.66 0 3-1.34 3-3s-1.34-3-3-3H1v12h9c2.76 0 5-2.24 5-5s-2.24-5-5-5"/><path d="M15 6h6m-3-3v6"/><path d="M15 15.5c0 2.49 2.01 4.5 4.5 4.5s4.5-2.01 4.5-4.5"/></>}
                      {name === 'github' && <><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></>}
                      {name === 'linkedin' && <><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></>}
                      {name === 'instagram' && <><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></>}
                    </svg>
                  </a>
                ))
              }
            </div>
            </div>
          </div>

          <!-- Right: Name + Title + Bio + Location -->
          <div class="about-hero-right">
            <h1
              class="text-3xl sm:text-4xl md:text-5xl font-bold leading-none tracking-[-0.03em] animate-in"
              style="color: var(--fg); --delay: 0.1s;"
            >
              {profile.name}
            </h1>
            <p
              class="mt-3 text-sm sm:text-base font-mono uppercase tracking-wider animate-in"
              style="color: var(--fg-muted); --delay: 0.2s;"
            >
              {profile.title}
            </p>

            <p
              class="mt-6 text-base sm:text-lg leading-relaxed animate-in"
              style="color: var(--fg-secondary); --delay: 0.3s;"
            >
              <span data-fr={profile.bio} data-en="Passionate designer with 5+ years of experience in graphic design, UI/UX and frontend development. We turn complex ideas into elegant and intuitive interfaces.">{profile.bio}</span>
            </p>

            <div
              class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 animate-in"
              style="--delay: 0.4s;"
            >
              <span class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider" style="color: var(--fg-muted);">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                {profile.location}
              </span>
              <span class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider" style="color: var(--fg-muted);">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                <span data-fr={profile.availability} data-en="Available for freelance">{profile.availability}</span>
              </span>
            </div>

            <div class="mt-6 animate-in" style="--delay: 0.5s;">
              <a
                href="/contact"
                class="inline-block px-6 py-3 text-sm font-medium no-underline transition-all"
                style="background: var(--fg); color: var(--bg);"
                onmouseover="this.style.opacity='0.85'"
                onmouseout="this.style.opacity='1'"
              >
                <span data-fr="Nous contacter" data-en="Get in touch">Nous contacter</span>
              </a>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <!-- Bande déroulante — Ce que nous savons faire -->
    <div class="about-marquee">
      <div class="about-marquee-track">
        <span data-fr="Brandings" data-en="Brandings">Brandings</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="UI/UX Design" data-en="UI/UX Design">UI/UX Design</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="Développement Web" data-en="Web Development">Développement Web</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="Applications Mobiles" data-en="Mobile Applications">Applications Mobiles</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="Systèmes de Design" data-en="Design Systems">Systèmes de Design</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="Design Graphique" data-en="Graphic Design">Design Graphique</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="Identité Visuelle" data-en="Visual Identity">Identité Visuelle</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="APIs & Backend" data-en="APIs & Backend">APIs & Backend</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="Prototypage" data-en="Prototyping">Prototypage</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="Motion Design" data-en="Motion Design">Motion Design</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <!-- Duplicate -->
        <span data-fr="Brandings" data-en="Brandings">Brandings</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="UI/UX Design" data-en="UI/UX Design">UI/UX Design</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="Développement Web" data-en="Web Development">Développement Web</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="Applications Mobiles" data-en="Mobile Applications">Applications Mobiles</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="Systèmes de Design" data-en="Design Systems">Systèmes de Design</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="Design Graphique" data-en="Graphic Design">Design Graphique</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="Identité Visuelle" data-en="Visual Identity">Identité Visuelle</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="APIs & Backend" data-en="APIs & Backend">APIs & Backend</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="Prototypage" data-en="Prototyping">Prototypage</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
        <span data-fr="Motion Design" data-en="Motion Design">Motion Design</span>
        <span class="about-marquee-sep" aria-hidden="true">✦</span>
      </div>
    </div>

    <div class="section-divider" aria-hidden="true"></div>

    <!-- L'impact que nous créons -->
    <ImpactSection />

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Nos façons de penser -->
    <ThinkingStyles />

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Expertise — Système orbital -->
    <OrbitalSkills />

    <!-- CTA -->
    <section class="section">
      <Container class="text-center">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold" style="color: var(--fg);">
          <span data-fr="Contactons-nous." data-en="Let's get in touch.">Contactons-nous.</span>
        </h2>
        <p class="mt-4 max-w-lg mx-auto text-base sm:text-lg" style="color: var(--fg-secondary);">
          {profile.availability}.
          <span data-fr="N'hésitez pas à nous contacter pour discuter de votre projet." data-en="Don't hesitate to reach out to discuss your project.">N'hésitez pas à nous contacter pour discuter de votre projet.</span>
        </p>
        <div class="mt-8 flex flex-col items-center gap-3">
          <a
            href="/contact"
            class="px-6 py-3 text-sm font-medium no-underline transition-all w-full max-w-[260px] text-center"
            style="background: var(--fg); color: var(--bg);"
            onmouseover="this.style.opacity='0.85'"
            onmouseout="this.style.opacity='1'"
          >
            <span data-fr="Nous contacter" data-en="Get in touch">Nous contacter</span>
          </a>
          <a
            href={`https://wa.me/${profile.whatsapp || '25761729788'}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 text-sm font-medium no-underline transition-all border w-full max-w-[260px] text-center"
            style="color: var(--fg); border-color: var(--border); background: var(--bg);"
            onmouseover="this.style.borderColor='var(--border-hover)'"
            onmouseout="this.style.borderColor='var(--border)'"
          >
            <span class="inline-flex items-center gap-2 justify-center">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </span>
          </a>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
  <ScrollReveal />
</Layout>

<style>
  /* ── Hero grid background ── */
  .about-hero-section {
    position: relative;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 60px 60px;
    background-position: center center;
    background-blend-mode: overlay;
  }
  .about-hero-section::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60px;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  /* ── Hero split layout ── */
  .about-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    .about-hero {
      flex-direction: row;
      text-align: left;
      align-items: flex-start;
      gap: 4rem;
    }
  }

  .about-hero-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex-shrink: 0;
  }
  .about-photo-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  .about-social-icons {
    justify-content: center;
  }
  @media (min-width: 1024px) {
    .about-hero-left {
      align-items: flex-start;
      width: 40%;
      position: sticky;
      top: 120px;
    }
  }

  .about-hero-right {
    display: flex;
    flex-direction: column;
    max-width: 600px;
    background: var(--bg);
    padding: 1.5rem;
    border-radius: 0.5rem;
  }
  @media (min-width: 1024px) {
    .about-hero-right {
      padding-top: 1rem;
    }
  }

  /* ── Photo ── */
  .about-photo {
    width: 200px;
    height: 200px;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    position: relative;
  }
  .about-photo img {
    border-radius: 8px;
  }
  .about-wave {
    position: absolute;
    bottom: 8px;
    right: 8px;
    font-size: 1.75rem;
    line-height: 1;
    animation: wave-hand 1.8s ease-in-out infinite;
    transform-origin: 70% 70%;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
  }
  @keyframes wave-hand {
    0%, 100% { transform: rotate(0deg); }
    15% { transform: rotate(14deg); }
    30% { transform: rotate(-8deg); }
    45% { transform: rotate(14deg); }
    60% { transform: rotate(-4deg); }
    75% { transform: rotate(10deg); }
    90% { transform: rotate(0deg); }
  }
  @media (min-width: 640px) {
    .about-photo {
      width: 260px;
      height: 260px;
    }
  }
  @media (min-width: 768px) {
    .about-photo {
      width: 300px;
      height: 300px;
    }
  }

  /* ── Marquee ── */
  .about-marquee {
    overflow: hidden;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 0.875rem 0;
  }
  .about-marquee-track {
    display: flex;
    gap: 0;
    white-space: nowrap;
    animation: about-marquee 30s linear infinite;
    width: max-content;
  }
  .about-marquee-track span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding: 0 0.75rem;
    flex-shrink: 0;
  }
  .about-marquee-sep {
    color: var(--border-hover) !important;
    font-size: 0.5rem !important;
  }
  @keyframes about-marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .about-marquee-track { animation: none; }
  }
</style>
