---
import data from "../../public/data/portfolio.json";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import Container from "../components/Container.astro";
import ThinkingProcess from "../components/ThinkingProcess.astro";

const profile = data.profile as typeof data.profile & { photo?: string };
const services = data.services || [];
const socials = (profile.socials || {}) as Record<string, string>;
---

<Layout title={`À propos — ${profile.name}`}>
  <Header />
  <main>
    <!-- Hero -->
    <section class="pt-20 sm:pt-28 pb-8 md:pt-40 md:pb-24">
      <Container>
        <h1
          class="text-3xl sm:text-4xl md:text-5xl font-bold leading-none tracking-[-0.03em] animate-in"
          style="color: var(--fg);"
        >
          Qui sommes-nous?
        </h1>
      </Container>
    </section>

    <!-- Processus créatif animé -->
    <section class="section">
      <Container>
        <h2
          class="text-2xl sm:text-3xl md:text-4xl font-bold text-center animate-in"
          style="color: var(--fg);"
        >
          Comment nous approchons chaque projet.
        </h2>
        <p
          class="mt-4 text-center text-base sm:text-lg max-w-2xl mx-auto animate-in"
          style="color: var(--fg-secondary); --delay: 0.15s;"
        >
          Chaque projet commence par une compréhension profonde du besoin, puis se<br class="hidden sm:block" />
          décline en plusieurs pistes explorées en parallèle avant de converger<br class="hidden sm:block" />
          vers la direction créative optimale.
        </p>
        <div class="mt-12 animate-in" style="--delay: 0.3s;">
          <ThinkingProcess />
        </div>
      </Container>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Bio -->
    <section class="section">
      <Container>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-16">
          <div class="min-w-0 col-span-12 lg:col-span-5 animate-in">
            <div
              class="w-full max-w-[280px] sm:max-w-none aspect-square flex items-center justify-center overflow-hidden"
              style="background: var(--bg-raised); border: 1px solid var(--border);"
            >
              {
                profile.photo ? (
                  <img
                    src={profile.photo}
                    alt={profile.name}
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <span
                    class="font-mono text-sm uppercase tracking-widest opacity-20"
                    style="color: var(--fg);"
                  >
                    Photo
                  </span>
                )
              }
            </div>
          </div>
          <div
            class="min-w-0 col-span-12 lg:col-span-6 lg:col-start-7 animate-in" style="--delay: 0.15s;"
          >
            <p
              class="text-lg leading-relaxed"
              style="color: var(--fg-secondary);"
            >
              {profile.bio}
            </p>
            <div class="mt-8 space-y-4">
              <div class="flex items-center gap-3">
                <span
                  class="text-xs font-mono uppercase tracking-wider w-24 shrink-0"
                  style="color: var(--fg-muted);">Localisation</span
                >
                <span class="text-sm" style="color: var(--fg);"
                  >{profile.location}</span
                >
              </div>
              <div class="flex items-center gap-3">
                <span
                  class="text-xs font-mono uppercase tracking-wider w-24 shrink-0"
                  style="color: var(--fg-muted);">Email</span
                >
                <a
                  href={`mailto:${profile.email}`}
                  class="text-sm no-underline transition-colors duration-200 break-all"
                  style="color: var(--fg);"
                  onmouseover="this.style.color='var(--fg-secondary)'"
                  onmouseout="this.style.color='var(--fg)'">{profile.email}</a
                >
              </div>
              <div class="flex items-center gap-3">
                <span
                  class="text-xs font-mono uppercase tracking-wider w-24 shrink-0"
                  style="color: var(--fg-muted);">Statut</span
                >
                <span class="text-sm" style="color: var(--fg);"
                  >{profile.availability}</span
                >
              </div>
            </div>
            <div class="mt-8 flex gap-3">
              {
                Object.entries(socials).map(([name, url]) => (
                  <a
                    href={url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-10 h-10 flex items-center justify-center transition-colors duration-200 no-underline text-xs font-mono uppercase"
                    style="color: var(--fg-muted); border: 1px solid var(--border);"
                    onmouseover="this.style.color='var(--fg)'; this.style.borderColor='var(--border-hover)'"
                    onmouseout="this.style.color='var(--fg-muted)'; this.style.borderColor='var(--border)'"
                  >
                    {name[0].toUpperCase()}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </Container>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Services -->
    <section class="section" style="background: var(--bg-raised);">
      <Container>
        <h2
          class="text-3xl sm:text-4xl font-bold"
          style="color: var(--fg);"
        >
          Ce que nous maîtrisons.
        </h2>

        <div
          class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-4 gsap-stagger-grid"
        >
          {
            services.map((service: any) => (
              <div
                class="p-6 transition-colors duration-300"
                style="border: 1px solid var(--border);"
                onmouseover="this.style.borderColor='var(--border-hover)'"
                onmouseout="this.style.borderColor='var(--border)'"
              >
                <h3 class="text-sm font-semibold" style="color: var(--fg);">
                  {service.title}
                </h3>
                <p
                  class="mt-3 text-sm leading-relaxed"
                  style="color: var(--fg-secondary);"
                >
                  {service.description}
                </p>
              </div>
            ))
          }
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <section class="section" style="border-top: 1px solid var(--border);">
      <Container class="text-center">
        <h2 class="text-3xl sm:text-4xl font-bold" style="color: var(--fg);">
          Travaillons ensemble.
        </h2>
        <p class="mt-4 max-w-lg mx-auto" style="color: var(--fg-secondary);">
          {profile.availability}. N'hésitez pas à me contacter pour discuter de
          votre projet.
        </p>
        <div class="mt-8">
          <a
            href={`mailto:${profile.email}`}
            class="px-6 py-3 text-sm font-medium no-underline transition-all"
            style="background: var(--fg); color: var(--bg);"
            onmouseover="this.style.opacity='0.85'"
            onmouseout="this.style.opacity='1'"
          >
            Me contacter
          </a>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
  <ScrollReveal />
</Layout>


