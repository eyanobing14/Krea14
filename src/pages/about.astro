---
import data from "../../public/data/portfolio.json";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import Container from "../components/Container.astro";

const profile = data.profile as typeof data.profile & { photo?: string };
const services = data.services || [];
const socials = (profile.socials || {}) as Record<string, string>;
---

<Layout title={`À propos — ${profile.name}`}>
  <Header />
  <main>
    <!-- Hero -->
    <section class="pt-20 sm:pt-28 pb-8 md:pt-40 md:pb-24">
      <Container>
        <h1
          class="text-3xl sm:text-4xl md:text-5xl font-bold leading-none tracking-[-0.03em] animate-in"
          style="color: var(--fg);"
        >
          Qui sommes-nous?
        </h1>
      </Container>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Bio -->
    <section class="section">
      <Container>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-16">
          <div class="min-w-0 col-span-12 lg:col-span-5 animate-in">
            <div
              class="w-full max-w-[280px] sm:max-w-none aspect-square flex items-center justify-center overflow-hidden"
              style="background: var(--bg-raised); border: 1px solid var(--border);"
            >
              {
                profile.photo ? (
                  <img
                    src={profile.photo}
                    alt={profile.name}
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <span
                    class="font-mono text-sm uppercase tracking-widest opacity-20"
                    style="color: var(--fg);"
                  >
                    Photo
                  </span>
                )
              }
            </div>
          </div>
          <div
            class="min-w-0 col-span-12 lg:col-span-6 lg:col-start-7 animate-in" style="--delay: 0.15s;"
          >
            <p
              class="text-lg leading-relaxed"
              style="color: var(--fg-secondary);"
            >
              {profile.bio}
            </p>
            <div class="mt-8 space-y-4">
              <div class="flex items-center gap-3">
                <span
                  class="text-xs font-mono uppercase tracking-wider w-24 shrink-0"
                  style="color: var(--fg-muted);">Localisation</span
                >
                <span class="text-sm" style="color: var(--fg);"
                  >{profile.location}</span
                >
              </div>
              <div class="flex items-center gap-3">
                <span
                  class="text-xs font-mono uppercase tracking-wider w-24 shrink-0"
                  style="color: var(--fg-muted);">Email</span
                >
                <a
                  href={`mailto:${profile.email}`}
                  class="text-sm no-underline transition-colors duration-200 break-all"
                  style="color: var(--fg);"
                  onmouseover="this.style.color='var(--fg-secondary)'"
                  onmouseout="this.style.color='var(--fg)'">{profile.email}</a
                >
              </div>
              <div class="flex items-center gap-3">
                <span
                  class="text-xs font-mono uppercase tracking-wider w-24 shrink-0"
                  style="color: var(--fg-muted);">Statut</span
                >
                <span class="text-sm" style="color: var(--fg);"
                  >{profile.availability}</span
                >
              </div>
            </div>
            <div class="mt-8 flex gap-3">
              {
                Object.entries(socials).map(([name, url]) => (
                  <a
                    href={url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-10 h-10 flex items-center justify-center transition-colors duration-200 no-underline text-xs font-mono uppercase"
                    style="color: var(--fg-muted); border: 1px solid var(--border);"
                    onmouseover="this.style.color='var(--fg)'; this.style.borderColor='var(--border-hover)'"
                    onmouseout="this.style.color='var(--fg-muted)'; this.style.borderColor='var(--border)'"
                  >
                    {name[0].toUpperCase()}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </Container>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Services -->
    <section class="section" style="background: var(--bg-raised);">
      <Container>
        <h2
          class="text-3xl sm:text-4xl font-bold"
          style="color: var(--fg);"
        >
          Ce que nous maîtrisons.
        </h2>

        <div
          class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-4 gsap-stagger-grid"
        >
          {
            services.map((service: any) => (
              <div
                class="p-6 transition-colors duration-300"
                style="border: 1px solid var(--border);"
                onmouseover="this.style.borderColor='var(--border-hover)'"
                onmouseout="this.style.borderColor='var(--border)'"
              >
                <h3 class="text-sm font-semibold" style="color: var(--fg);">
                  {service.title}
                </h3>
                <p
                  class="mt-3 text-sm leading-relaxed"
                  style="color: var(--fg-secondary);"
                >
                  {service.description}
                </p>
              </div>
            ))
          }
        </div>
      </Container>
    </section>

    <!-- Skills / Tools -->
    <section class="section">
      <Container>
        <h2
          class="text-3xl sm:text-4xl font-bold"
          style="color: var(--fg);"
        >
          Nos outils.
        </h2>
        <p class="mt-4 max-w-xl text-sm sm:text-base leading-relaxed" style="color: var(--fg-secondary);">
          Les technologies et logiciels que nous utilisons au quotidien pour donner vie à vos projets.
        </p>

        <div class="mt-12 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
          {[
            { name: 'Figma', icon: '◐' },
            { name: 'Photoshop', icon: '◇' },
            { name: 'Illustrator', icon: '△' },
            { name: 'After Effects', icon: '▶' },
            { name: 'Premiere Pro', icon: '⬟' },
            { name: 'Blender', icon: '◎' },
            { name: 'React', icon: '⚛' },
            { name: 'Astro', icon: '✦' },
            { name: 'Tailwind', icon: '◠' },
            { name: 'GSAP', icon: '〰' },
            { name: 'TypeScript', icon: 'TS' },
            { name: 'Git', icon: '⊕' },
          ].map((tool, i) => (
            <div
              class="skill-card group relative p-5 flex flex-col items-center justify-center gap-3 transition-all duration-500"
              style={`border: 1px solid var(--border); animation-delay: ${i * 0.08}s;`}
              onmouseover="this.style.borderColor='var(--border-hover)'; this.style.transform='translateY(-4px)'"
              onmouseout="this.style.borderColor='var(--border)'; this.style.transform='translateY(0)'"
            >
              <span
                class="text-2xl font-bold transition-transform duration-500 group-hover:scale-110"
                style="color: var(--fg-muted);"
              >
                {tool.icon}
              </span>
              <span class="text-xs font-mono uppercase tracking-wider" style="color: var(--fg-secondary);">
                {tool.name}
              </span>
            </div>
          ))}
        </div>

        <!-- Animated skill orbit -->
        <div class="mt-16 relative h-48 sm:h-64 overflow-hidden">
          <div class="skill-orbit absolute inset-0 flex items-center justify-center">
            <div class="orbit-ring orbit-ring-1"></div>
            <div class="orbit-ring orbit-ring-2"></div>
            <div class="orbit-ring orbit-ring-3"></div>
            <div class="orbit-dot orbit-dot-1"></div>
            <div class="orbit-dot orbit-dot-2"></div>
            <div class="orbit-dot orbit-dot-3"></div>
            <div class="orbit-dot orbit-dot-4"></div>
            <div class="orbit-dot orbit-dot-5"></div>
            <div class="orbit-center">
              <span class="text-xs font-mono uppercase tracking-widest" style="color: var(--fg-muted);">Stack</span>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Case Study Guide -->
    <section class="section" style="background: var(--bg-raised);">
      <Container>
        <div class="max-w-2xl">
          <h2
            class="text-3xl sm:text-4xl font-bold"
            style="color: var(--fg);"
          >
            Comment nous rédigeons un case study.
          </h2>
          <p class="mt-4 text-sm sm:text-base leading-relaxed" style="color: var(--fg-secondary);">
            Chaque projet raconte une histoire. Voici la structure que nous suivons pour présenter nos réalisations.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            {
              num: '01',
              title: 'Le contexte',
              desc: 'Présenter le client, son secteur d\'activité et les enjeux spécifiques du projet.',
              tip: 'Qui est le client ? Quel était le problème à résoudre ?',
            },
            {
              num: '02',
              title: 'Le défi',
              desc: 'Définir le problème principal et les contraintes (temps, budget, technique).',
              tip: 'Qu\'est-ce qui rendait ce projet difficile ou unique ?',
            },
            {
              num: '03',
              title: 'Notre approche',
              desc: 'Expliquer la méthodologie, les outils choisis et pourquoi.',
              tip: 'Comment avons-nous abordé le problème ? Quelles solutions ?',
            },
            {
              num: '04',
              title: 'Le processus',
              desc: 'Détailler les étapes clés : recherche, conception, développement, tests.',
              tip: '6 étapes maximum, claires et concises.',
            },
            {
              num: '05',
              title: 'Les résultats',
              desc: 'Mesurer l\'impact avec des métriques concrètes et des chiffres.',
              tip: '+40% de visibilité, score Lighthouse 98/100, etc.',
            },
            {
              num: '06',
              title: 'Les learnings',
              desc: 'Partager ce que nous avons appris et ce que nous ferions différemment.',
              tip: 'Montre l\'expertise et la capacité d\'introspection.',
            },
          ].map((step) => (
            <div
              class="p-6 animate-in"
              style="border: 1px solid var(--border);"
            >
              <span class="font-mono text-xs font-semibold" style="color: var(--fg-muted);">
                {step.num}
              </span>
              <h3 class="mt-3 text-sm font-semibold" style="color: var(--fg);">
                {step.title}
              </h3>
              <p class="mt-2 text-xs leading-relaxed" style="color: var(--fg-secondary);">
                {step.desc}
              </p>
              <div class="mt-3 p-3 text-xs" style="background: var(--bg); border: 1px solid var(--border);">
                <span class="font-mono" style="color: var(--fg-muted);">💡 </span>
                <span style="color: var(--fg-secondary);">{step.tip}</span>
              </div>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <section class="section" style="border-top: 1px solid var(--border);">
      <Container class="text-center">
        <h2 class="text-3xl sm:text-4xl font-bold" style="color: var(--fg);">
          Travaillons ensemble.
        </h2>
        <p class="mt-4 max-w-lg mx-auto" style="color: var(--fg-secondary);">
          {profile.availability}. N'hésitez pas à me contacter pour discuter de
          votre projet.
        </p>
        <div class="mt-8">
          <a
            href={`mailto:${profile.email}`}
            class="px-6 py-3 text-sm font-medium no-underline transition-all"
            style="background: var(--fg); color: var(--bg);"
            onmouseover="this.style.opacity='0.85'"
            onmouseout="this.style.opacity='1'"
          >
            Me contacter
          </a>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
  <ScrollReveal />
</Layout>

<style>
  /* ── Skill orbit animation ── */
  .skill-orbit {
    position: relative;
  }
  .orbit-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid var(--border);
  }
  .orbit-ring-1 {
    width: 120px;
    height: 120px;
    animation: orbit-spin 20s linear infinite;
  }
  .orbit-ring-2 {
    width: 200px;
    height: 200px;
    animation: orbit-spin 30s linear infinite reverse;
  }
  .orbit-ring-3 {
    width: 280px;
    height: 280px;
    animation: orbit-spin 40s linear infinite;
  }
  .orbit-dot {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--fg);
    opacity: 0.4;
  }
  .orbit-dot-1 {
    animation: orbit-float-1 6s ease-in-out infinite;
  }
  .orbit-dot-2 {
    animation: orbit-float-2 8s ease-in-out infinite;
  }
  .orbit-dot-3 {
    animation: orbit-float-3 7s ease-in-out infinite;
  }
  .orbit-dot-4 {
    animation: orbit-float-4 9s ease-in-out infinite;
  }
  .orbit-dot-5 {
    animation: orbit-float-5 5s ease-in-out infinite;
  }
  .orbit-center {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: var(--bg);
  }

  @keyframes orbit-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @keyframes orbit-float-1 {
    0%, 100% { transform: translate(60px, 0); }
    50% { transform: translate(-40px, 30px); }
  }
  @keyframes orbit-float-2 {
    0%, 100% { transform: translate(-80px, 20px); }
    50% { transform: translate(50px, -40px); }
  }
  @keyframes orbit-float-3 {
    0%, 100% { transform: translate(30px, -60px); }
    50% { transform: translate(-50px, 50px); }
  }
  @keyframes orbit-float-4 {
    0%, 100% { transform: translate(-30px, -50px); }
    50% { transform: translate(70px, 20px); }
  }
  @keyframes orbit-float-5 {
    0%, 100% { transform: translate(50px, 40px); }
    50% { transform: translate(-60px, -30px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit-ring, .orbit-dot { animation: none; }
    .orbit-dot { opacity: 0.6; }
  }
</style>
