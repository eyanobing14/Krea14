---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

const dataPath = path.resolve(process.cwd(), 'public/data/portfolio.json');
const data = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
const profile = data.profile;
const services = data.services || [];
---

<Layout title={`À propos — ${profile.name}`}>
  <Header />
  <main>
    <!-- Hero -->
    <section class="pt-32 pb-16 md:pt-40 md:pb-24">
      <div class="container-page">
        <span class="label">À propos</span>
        <h1 class="mt-8 text-4xl md:text-5xl lg:text-6xl font-bold leading-[1] tracking-[-0.03em]" style="color: var(--fg);">
          Qui suis-je?
        </h1>
      </div>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Bio -->
    <section class="section">
      <div class="container-page">
        <div class="grid grid-cols-12 gap-8 md:gap-16">
          <div class="col-span-12 lg:col-span-5 gsap-slide-left">
            <div class="w-full aspect-square flex items-center justify-center overflow-hidden" style="background: var(--bg-raised); border: 1px solid var(--border);">
              {profile.photo ? (
                <img src={profile.photo} alt={profile.name} class="w-full h-full object-cover" />
              ) : (
                <span class="font-mono text-sm uppercase tracking-widest opacity-20" style="color: var(--fg);">Photo</span>
              )}
            </div>
          </div>
          <div class="col-span-12 lg:col-span-6 lg:col-start-7 gsap-slide-right">
            <p class="text-lg leading-relaxed" style="color: var(--fg-secondary);">
              {profile.bio}
            </p>
            <div class="mt-8 space-y-4">
              <div class="flex items-center gap-3">
                <span class="text-xs font-mono uppercase tracking-wider w-24 shrink-0" style="color: var(--fg-muted);">Localisation</span>
                <span class="text-sm" style="color: var(--fg);">{profile.location}</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-xs font-mono uppercase tracking-wider w-24 shrink-0" style="color: var(--fg-muted);">Email</span>
                <a href={`mailto:${profile.email}`} class="text-sm no-underline transition-colors duration-200" style="color: var(--fg);" onmouseover="this.style.color='var(--fg-secondary)'" onmouseout="this.style.color='var(--fg)'">{profile.email}</a>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-xs font-mono uppercase tracking-wider w-24 shrink-0" style="color: var(--fg-muted);">Statut</span>
                <span class="text-sm" style="color: var(--fg);">{profile.availability}</span>
              </div>
            </div>
            <div class="mt-8 flex gap-3">
              {profile.socials && Object.entries(profile.socials).map(([name, url]) => (
                <a href={url} target="_blank" rel="noopener noreferrer" class="w-10 h-10 flex items-center justify-center transition-colors duration-200 no-underline text-xs font-mono uppercase" style="color: var(--fg-muted); border: 1px solid var(--border);" onmouseover="this.style.color='var(--fg)'; this.style.borderColor='var(--border-hover)'" onmouseout="this.style.color='var(--fg-muted)'; this.style.borderColor='var(--border)'">
                  {name[0].toUpperCase()}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Services -->
    <section class="section" style="background: var(--bg-raised);">
      <div class="container-page">
        <span class="label">Services</span>
        <h2 class="mt-6 text-2xl md:text-3xl font-bold" style="color: var(--fg);">Ce que je maîtrise.</h2>

        <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-4 gsap-stagger-grid">
          {services.map((service) => (
            <div class="p-6 transition-colors duration-300" style="border: 1px solid var(--border);" onmouseover="this.style.borderColor='var(--border-hover)'" onmouseout="this.style.borderColor='var(--border)'">
              <h3 class="text-sm font-semibold" style="color: var(--fg);">{service.title}</h3>
              <p class="mt-3 text-sm leading-relaxed" style="color: var(--fg-secondary);">{service.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section" style="border-top: 1px solid var(--border);">
      <div class="container-page text-center">
        <h2 class="text-3xl md:text-4xl font-bold" style="color: var(--fg);">Travaillons ensemble.</h2>
        <p class="mt-4 max-w-lg mx-auto" style="color: var(--fg-secondary);">
          {profile.availability}. N'hésitez pas à me contacter pour discuter de votre projet.
        </p>
        <div class="mt-8">
          <a href={`mailto:${profile.email}`} class="px-6 py-3 text-sm font-medium no-underline transition-all" style="background: var(--fg); color: var(--bg);" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
            Me contacter
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <ScrollReveal />
</Layout>
