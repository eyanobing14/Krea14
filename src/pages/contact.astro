---
import data from "../../public/data/portfolio.json";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import Container from "../components/Container.astro";

const profile = data.profile;
const socials = (profile.socials || {}) as Record<string, string>;
---

<Layout title={`Contact — ${profile.name}`}>
  <Header />
  <main>
    <section class="pt-20 sm:pt-28 pb-8 md:pt-40 md:pb-24">
      <Container>
        <h1
          class="text-3xl sm:text-4xl md:text-6xl lg:text-7xl font-bold leading-[1.1] tracking-[-0.03em]"
          style="color: var(--fg);"
        >
          Parlons de votre<br />
          <span style="color: var(--fg-tertiary);">projet.</span>
        </h1>
      </Container>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <section class="section">
      <Container>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-16">
          <!-- Left: Form -->
          <div class="min-w-0 col-span-12 lg:col-span-7">
            <form id="contact-form" class="space-y-4 sm:space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label
                    class="block text-xs font-mono uppercase tracking-wider mb-2"
                    style="color: var(--fg-muted);">Nom</label
                  >
                  <input
                    type="text"
                    name="name"
                    required
                    class="contact-input"
                    placeholder="Votre nom"
                  />
                </div>
                <div>
                  <label
                    class="block text-xs font-mono uppercase tracking-wider mb-2"
                    style="color: var(--fg-muted);">Email</label
                  >
                  <input
                    type="email"
                    name="email"
                    required
                    class="contact-input"
                    placeholder="votre@email.com"
                  />
                </div>
              </div>
              <div>
                <label
                  class="block text-xs font-mono uppercase tracking-wider mb-2"
                  style="color: var(--fg-muted);">Type de projet</label
                >
                <select name="project-type" class="contact-input">
                  <option value="">Sélectionnez...</option>
                  <option value="branding">Branding / Identité visuelle</option>
                  <option value="uiux">UI/UX Design</option>
                  <option value="frontend">Développement Frontend</option>
                  <option value="logo">Logo Design</option>
                  <option value="other">Autre</option>
                </select>
              </div>
              <div>
                <label
                  class="block text-xs font-mono uppercase tracking-wider mb-2"
                  style="color: var(--fg-muted);">Budget estimé</label
                >
                <select name="budget" class="contact-input">
                  <option value="">Sélectionnez...</option>
                  <option value="1k-3k">1 000 € — 3 000 €</option>
                  <option value="3k-5k">3 000 € — 5 000 €</option>
                  <option value="5k-10k">5 000 € — 10 000 €</option>
                  <option value="10k+">10 000 € +</option>
                </select>
              </div>
              <div>
                <label
                  class="block text-xs font-mono uppercase tracking-wider mb-2"
                  style="color: var(--fg-muted);">Message</label
                >
                <textarea
                  name="message"
                  rows="5"
                  required
                  class="contact-input"
                  placeholder="Décrivez votre projet, vos objectifs, votre timeline..."
                ></textarea>
              </div>
              <div>
                <button
                  type="submit"
                  class="px-8 py-3 text-sm font-medium transition-all"
                  style="background: var(--fg); color: var(--bg);"
                  onmouseover="this.style.opacity='0.85'"
                  onmouseout="this.style.opacity='1'"
                >
                  Envoyer le message →
                </button>
              </div>
            </form>
            <div
              id="contact-success"
              class="hidden mt-6 p-6"
              style="border: 1px solid var(--border);"
            >
              <p class="text-sm font-medium" style="color: var(--fg);">
                Message envoyé!
              </p>
              <p class="mt-2 text-xs" style="color: var(--fg-secondary);">
                Nous vous répondrons dans les plus brefs délais.
              </p>
            </div>
          </div>

          <!-- Right: Process + Info -->
          <div class="min-w-0 col-span-12 lg:col-span-5">
            <!-- Work process animation -->
            <div class="process-illustration mb-10">
              <svg viewBox="0 0 320 120" fill="none" class="process-svg">
                <!-- Step 1: Message -->
                <g class="process-step ps1">
                  <circle cx="40" cy="60" r="22" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
                  <path d="M30 52 L50 52 L50 68 L30 68 Z" stroke="var(--fg-muted)" stroke-width="1" fill="none"/>
                  <line x1="34" y1="57" x2="46" y2="57" stroke="var(--fg-muted)" stroke-width="0.75"/>
                  <line x1="34" y1="61" x2="42" y2="61" stroke="var(--fg-muted)" stroke-width="0.75"/>
                  <text x="40" y="95" text-anchor="middle" fill="var(--fg-secondary)" font-size="8" font-family="var(--font-mono)">Message</text>
                </g>
                <!-- Arrow 1 -->
                <line x1="68" y1="60" x2="92" y2="60" stroke="var(--fg-muted)" stroke-width="1" stroke-dasharray="3 2" class="process-arrow pa1"/>
                <polygon points="92,60 86,56 86,64" fill="var(--fg-muted)" class="process-arrow pa1"/>
                <!-- Step 2: Discussion -->
                <g class="process-step ps2">
                  <circle cx="112" cy="60" r="22" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
                  <path d="M102 50 C102 44, 122 44, 122 50 L122 56 C122 62, 102 62, 102 56 Z" stroke="var(--fg-muted)" stroke-width="1" fill="none"/>
                  <circle cx="107" cy="53" r="1.5" fill="var(--fg-muted)"/>
                  <circle cx="112" cy="53" r="1.5" fill="var(--fg-muted)"/>
                  <circle cx="117" cy="53" r="1.5" fill="var(--fg-muted)"/>
                  <text x="112" y="95" text-anchor="middle" fill="var(--fg-secondary)" font-size="8" font-family="var(--font-mono)">Discussion</text>
                </g>
                <!-- Arrow 2 -->
                <line x1="140" y1="60" x2="164" y2="60" stroke="var(--fg-muted)" stroke-width="1" stroke-dasharray="3 2" class="process-arrow pa2"/>
                <polygon points="164,60 158,56 158,64" fill="var(--fg-muted)" class="process-arrow pa2"/>
                <!-- Step 3: Conception -->
                <g class="process-step ps3">
                  <circle cx="184" cy="60" r="22" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
                  <rect x="174" y="50" width="20" height="14" rx="2" stroke="var(--fg-muted)" stroke-width="1" fill="none"/>
                  <line x1="178" y1="55" x2="190" y2="55" stroke="var(--fg-muted)" stroke-width="0.5"/>
                  <line x1="178" y1="58" x2="186" y2="58" stroke="var(--fg-muted)" stroke-width="0.5"/>
                  <line x1="178" y1="61" x2="188" y2="61" stroke="var(--fg-muted)" stroke-width="0.5"/>
                  <text x="184" y="95" text-anchor="middle" fill="var(--fg-secondary)" font-size="8" font-family="var(--font-mono)">Conception</text>
                </g>
                <!-- Arrow 3 -->
                <line x1="212" y1="60" x2="236" y2="60" stroke="var(--fg-muted)" stroke-width="1" stroke-dasharray="3 2" class="process-arrow pa3"/>
                <polygon points="236,60 230,56 230,64" fill="var(--fg-muted)" class="process-arrow pa3"/>
                <!-- Step 4: Livraison -->
                <g class="process-step ps4">
                  <circle cx="256" cy="60" r="22" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
                  <path d="M248 62 L254 68 L266 52" stroke="var(--fg)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="check-mark"/>
                  <text x="256" y="95" text-anchor="middle" fill="var(--fg-secondary)" font-size="8" font-family="var(--font-mono)">Livraison</text>
                </g>
                <!-- Progress line -->
                <line x1="40" y1="108" x2="256" y2="108" stroke="var(--border)" stroke-width="1"/>
                <line x1="40" y1="108" x2="256" y2="108" stroke="var(--fg)" stroke-width="1" class="progress-line"/>
              </svg>
            </div>
            <div class="space-y-8">
              <div>
                <span class="label block">Email direct</span>
                <a
                  href={`mailto:${profile.email}`}
                  class="mt-3 block text-sm sm:text-base font-medium no-underline transition-colors duration-200 break-all"
                  style="color: var(--fg);"
                  onmouseover="this.style.color='var(--fg-secondary)'"
                  onmouseout="this.style.color='var(--fg)'"
                >
                  {profile.email}
                </a>
              </div>
              <div>
                <span class="label">Localisation</span>
                <p class="mt-3 text-sm" style="color: var(--fg-secondary);">
                  {profile.location}
                </p>
              </div>
              <div>
                <span class="label">Disponibilité</span>
                <p class="mt-3 text-sm" style="color: var(--fg-secondary);">
                  {profile.availability}
                </p>
              </div>
              <div>
                <span class="label">Réseaux</span>
                <div class="mt-3 flex gap-3">
                  {
                    Object.entries(socials).map(([name, url]) => (
                      <a
                        href={url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-10 h-10 flex items-center justify-center transition-colors duration-200 no-underline text-xs font-mono uppercase"
                        style="color: var(--fg-muted); border: 1px solid var(--border);"
                        onmouseover="this.style.color='var(--fg)'; this.style.borderColor='var(--border-hover)'"
                        onmouseout="this.style.color='var(--fg-muted)'; this.style.borderColor='var(--border)'"
                      >
                        {name[0].toUpperCase()}
                      </a>
                    ))
                  }
                </div>
              </div>
              <div
                class="p-6"
                style="border: 1px solid var(--border); background: var(--bg-raised);"
              >
                <p
                  class="text-xs leading-relaxed"
                  style="color: var(--fg-secondary);"
                >
                  Réponse sous 24h ouvrées. Pour les projets urgents,
                  mentionnez-le dans votre message.
                </p>
              </div>
            </div>
          </div>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
  <ScrollReveal />
</Layout>

<style>
  .contact-input {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 0.625rem 0.75rem;
    font-size: 0.875rem;
    font-family: var(--font-body);
    background: var(--bg-raised);
    color: var(--fg);
    border: 1px solid var(--border-strong);
    outline: none;
    transition: border-color 0.2s;
    -webkit-appearance: none;
    border-radius: 0;
  }
  .contact-input:focus {
    border-color: var(--fg);
  }
  .contact-input::placeholder {
    color: var(--fg-muted);
  }
  select.contact-input {
    cursor: pointer;
  }

  /* ── Process illustration ── */
  .process-illustration {
    display: flex;
    justify-content: center;
    overflow: visible;
  }
  .process-svg {
    width: 100%;
    max-width: 320px;
    height: auto;
    overflow: visible;
  }

  /* Steps appear sequentially */
  .process-step { opacity: 0; animation: step-in 0.4s ease forwards; }
  .ps1 { animation-delay: 0s; }
  .ps2 { animation-delay: 0.4s; }
  .ps3 { animation-delay: 0.8s; }
  .ps4 { animation-delay: 1.2s; }
  @keyframes step-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Arrows draw in */
  .process-arrow { opacity: 0; animation: arrow-in 0.3s ease forwards; }
  .pa1 { animation-delay: 0.3s; }
  .pa2 { animation-delay: 0.7s; }
  .pa3 { animation-delay: 1.1s; }
  @keyframes arrow-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Checkmark draws */
  .check-mark {
    stroke-dasharray: 30;
    stroke-dashoffset: 30;
    animation: draw-check 0.6s ease 1.4s forwards;
  }
  @keyframes draw-check {
    to { stroke-dashoffset: 0; }
  }

  /* Progress line fills */
  .progress-line {
    stroke-dasharray: 216;
    stroke-dashoffset: 216;
    animation: fill-progress 2s ease 0.2s forwards;
  }
  @keyframes fill-progress {
    to { stroke-dashoffset: 0; }
  }

  @media (max-width: 480px) {
    .process-svg { max-width: 280px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-step, .process-arrow, .check-mark, .progress-line { animation: none !important; }
    .process-step { opacity: 1; }
    .process-arrow { opacity: 1; }
    .check-mark, .progress-line { stroke-dashoffset: 0; }
  }
</style>

<script>
  function initContact() {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const success = document.getElementById("contact-success");
    if (!form) return;

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      // In a real app this would POST to an API
      form.classList.add("hidden");
      success?.classList.remove("hidden");
    });
  }
  document.readyState === "loading"
    ? document.addEventListener("DOMContentLoaded", initContact)
    : initContact();
</script>
