---
import data from "../../public/data/portfolio.json";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import Container from "../components/Container.astro";

const profile = data.profile;
const socials = (profile.socials || {}) as Record<string, string>;
---

<Layout title={`Contact — ${profile.name}`}>
  <Header />
  <main>
    <!-- Hero: h1 + animation side by side on desktop -->
    <section class="contact-hero pt-20 sm:pt-28 pb-8 md:pt-40 md:pb-20">
      <Container>
        <div class="contact-hero-inner">
          <!-- H1 -->
          <div class="contact-hero-text">
            <h1
              class="text-3xl sm:text-4xl md:text-6xl lg:text-7xl font-bold leading-[1.1] tracking-[-0.03em]"
              style="color: var(--fg);"
            >
              Parlons de votre<br />
              <span style="color: var(--fg-tertiary);">projet.</span>
            </h1>
            <p class="mt-4 text-base sm:text-lg" style="color: var(--fg-secondary);">
              <span data-fr="Disponible pour freelance. N'hésitez pas à nous contacter pour discuter de votre projet." data-en="Available for freelance. Don't hesitate to contact us to discuss your project.">Disponible pour freelance. N'hésitez pas à nous contacter pour discuter de votre projet.</span>
            </p>
            <div class="mt-6 flex flex-col sm:flex-row gap-3">
              <a
                href="#contact-form"
                class="px-6 py-3 text-sm font-medium no-underline transition-all text-center"
                style="background: var(--fg); color: var(--bg);"
                onmouseover="this.style.opacity='0.85'"
                onmouseout="this.style.opacity='1'"
              >
                <span data-fr="Envoyer un message" data-en="Send a message">Envoyer un message</span>
              </a>
              <a
                href={`https://wa.me/${profile.whatsapp || '25761729788'}`}
                target="_blank"
                rel="noopener noreferrer"
                class="px-6 py-3 text-sm no-underline transition-all text-center"
                style="color: var(--fg); border: 1px solid var(--border); background: var(--bg);"
                onmouseover="this.style.borderColor='var(--border-hover)'"
                onmouseout="this.style.borderColor='var(--border)'"
              >
                <span class="inline-flex items-center gap-2 justify-center">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  WhatsApp
                </span>
              </a>
            </div>
          </div>
          <!-- Animation -->
          <div class="contact-hero-anim">
            <svg viewBox="0 0 400 160" fill="none" class="process-svg" id="process-svg">
              <!-- Background glow -->
              <circle cx="200" cy="70" r="60" fill="var(--fg)" opacity="0.02" class="anim-glow"/>

              <!-- Step 1: Message (large envelope) -->
              <g class="anim-step as1">
                <circle cx="60" cy="70" r="32" stroke="var(--fg-muted)" stroke-width="1" fill="none" opacity="0.3"/>
                <circle cx="60" cy="70" r="28" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
                <rect x="42" y="58" width="36" height="24" rx="3" stroke="var(--fg-secondary)" stroke-width="1.2" fill="none"/>
                <path d="M42 61 L60 73 L78 61" stroke="var(--fg-secondary)" stroke-width="1" fill="none"/>
                <line x1="48" y1="78" x2="56" y2="78" stroke="var(--fg-muted)" stroke-width="0.75" opacity="0.5"/>
                <line x1="48" y1="82" x2="54" y2="82" stroke="var(--fg-muted)" stroke-width="0.75" opacity="0.5"/>
                <text x="60" y="118" text-anchor="middle" fill="var(--fg-secondary)" font-size="10" font-weight="500" font-family="var(--font-mono)" letter-spacing="0.05em">Message</text>
              </g>

              <!-- Arrow 1 -->
              <g class="anim-arrow aa1">
                <line x1="96" y1="70" x2="126" y2="70" stroke="var(--fg-muted)" stroke-width="1.5" stroke-dasharray="4 3"/>
                <polygon points="130,70 122,65 122,75" fill="var(--fg-muted)"/>
              </g>

              <!-- Step 2: Discussion (chat bubbles) -->
              <g class="anim-step as2">
                <circle cx="156" cy="70" r="32" stroke="var(--fg-muted)" stroke-width="1" fill="none" opacity="0.3"/>
                <circle cx="156" cy="70" r="28" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
                <rect x="140" y="58" width="32" height="12" rx="6" stroke="var(--fg-secondary)" stroke-width="1.2" fill="none"/>
                <line x1="146" y1="63" x2="166" y2="63" stroke="var(--fg-muted)" stroke-width="0.75"/>
                <line x1="146" y1="67" x2="160" y2="67" stroke="var(--fg-muted)" stroke-width="0.75"/>
                <rect x="144" y="74" width="28" height="10" rx="5" stroke="var(--fg-muted)" stroke-width="1" fill="none"/>
                <line x1="150" y1="79" x2="164" y2="79" stroke="var(--fg-muted)" stroke-width="0.75"/>
                <text x="156" y="118" text-anchor="middle" fill="var(--fg-secondary)" font-size="10" font-weight="500" font-family="var(--font-mono)" letter-spacing="0.05em">Discussion</text>
              </g>

              <!-- Arrow 2 -->
              <g class="anim-arrow aa2">
                <line x1="192" y1="70" x2="222" y2="70" stroke="var(--fg-muted)" stroke-width="1.5" stroke-dasharray="4 3"/>
                <polygon points="226,70 218,65 218,75" fill="var(--fg-muted)"/>
              </g>

              <!-- Step 3: Conception (wireframe) -->
              <g class="anim-step as3">
                <circle cx="256" cy="70" r="32" stroke="var(--fg-muted)" stroke-width="1" fill="none" opacity="0.3"/>
                <circle cx="256" cy="70" r="28" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
                <rect x="238" y="56" width="36" height="28" rx="3" stroke="var(--fg-secondary)" stroke-width="1.2" fill="none"/>
                <line x1="238" y1="64" x2="274" y2="64" stroke="var(--fg-muted)" stroke-width="0.75"/>
                <rect x="242" y="68" width="12" height="8" rx="1" stroke="var(--fg-muted)" stroke-width="0.75" fill="none"/>
                <line x1="258" y1="70" x2="270" y2="70" stroke="var(--fg-muted)" stroke-width="0.5"/>
                <line x1="258" y1="74" x2="266" y2="74" stroke="var(--fg-muted)" stroke-width="0.5"/>
                <line x1="242" y1="80" x2="270" y2="80" stroke="var(--fg-muted)" stroke-width="0.5"/>
                <text x="256" y="118" text-anchor="middle" fill="var(--fg-secondary)" font-size="10" font-weight="500" font-family="var(--font-mono)" letter-spacing="0.05em">Conception</text>
              </g>

              <!-- Arrow 3 -->
              <g class="anim-arrow aa3">
                <line x1="292" y1="70" x2="322" y2="70" stroke="var(--fg-muted)" stroke-width="1.5" stroke-dasharray="4 3"/>
                <polygon points="326,70 318,65 318,75" fill="var(--fg-muted)"/>
              </g>

              <!-- Step 4: Livraison (checkmark + sparkle) -->
              <g class="anim-step as4">
                <circle cx="356" cy="70" r="32" stroke="var(--fg-muted)" stroke-width="1" fill="none" opacity="0.3"/>
                <circle cx="356" cy="70" r="28" stroke="var(--fg)" stroke-width="1.5" fill="none"/>
                <path d="M344 70 L352 78 L370 58" stroke="var(--fg)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" class="anim-check"/>
                <g class="anim-sparkle">
                  <line x1="374" y1="54" x2="380" y2="54" stroke="var(--fg)" stroke-width="1"/>
                  <line x1="377" y1="51" x2="377" y2="57" stroke="var(--fg)" stroke-width="1"/>
                </g>
                <g class="anim-sparkle aspk2">
                  <line x1="336" y1="50" x2="340" y2="50" stroke="var(--fg-muted)" stroke-width="0.75"/>
                  <line x1="338" y1="48" x2="338" y2="52" stroke="var(--fg-muted)" stroke-width="0.75"/>
                </g>
                <text x="356" y="118" text-anchor="middle" fill="var(--fg-secondary)" font-size="10" font-weight="500" font-family="var(--font-mono)" letter-spacing="0.05em">Livraison</text>
              </g>

              <!-- Progress bar -->
              <line x1="60" y1="140" x2="356" y2="140" stroke="var(--border)" stroke-width="2" stroke-linecap="round"/>
              <line x1="60" y1="140" x2="356" y2="140" stroke="var(--fg)" stroke-width="2" stroke-linecap="round" class="anim-progress"/>
            </svg>
          </div>
        </div>
      </Container>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <section class="section">
      <Container>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-16">
          <!-- Left: Form -->
          <div class="min-w-0 col-span-12 lg:col-span-7">
            <form id="contact-form" class="space-y-4 sm:space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label
                    class="block text-xs font-mono uppercase tracking-wider mb-2"
                    style="color: var(--fg-muted);"><span data-fr="Nom" data-en="Name">Nom</span></label
                  >
                  <input
                    type="text"
                    name="name"
                    required
                    class="contact-input"
                    placeholder="Votre nom"
                  />
                </div>
                <div>
                  <label
                    class="block text-xs font-mono uppercase tracking-wider mb-2"
                    style="color: var(--fg-muted);"><span data-fr="Email" data-en="Email">Email</span></label
                  >
                  <input
                    type="email"
                    name="email"
                    required
                    class="contact-input"
                    placeholder="votre@email.com"
                  />
                </div>
              </div>
              <div>
                <label
                  class="block text-xs font-mono uppercase tracking-wider mb-2"
                  style="color: var(--fg-muted);"><span data-fr="Type de projet" data-en="Project type">Type de projet</span></label
                >
                <select name="project-type" class="contact-input">
                  <option value=""><span data-fr="Sélectionnez..." data-en="Select...">Sélectionnez...</span></option>
                  <option value="branding">Branding / Identité visuelle</option>
                  <option value="uiux">UI/UX Design</option>
                  <option value="frontend">Développement Frontend</option>
                  <option value="logo">Logo Design</option>
                  <option value="other">Autre</option>
                </select>
              </div>
              <div>
                <label
                  class="block text-xs font-mono uppercase tracking-wider mb-2"
                  style="color: var(--fg-muted);"><span data-fr="Budget estimé" data-en="Estimated budget">Budget estimé</span></label
                >
                <select name="budget" class="contact-input">
                  <option value=""><span data-fr="Sélectionnez..." data-en="Select...">Sélectionnez...</span></option>
                  <option value="1k-3k">1 000 € — 3 000 €</option>
                  <option value="3k-5k">3 000 € — 5 000 €</option>
                  <option value="5k-10k">5 000 € — 10 000 €</option>
                  <option value="10k+">10 000 € +</option>
                </select>
              </div>
              <div>
                <label
                  class="block text-xs font-mono uppercase tracking-wider mb-2"
                  style="color: var(--fg-muted);"><span data-fr="Message" data-en="Message">Message</span></label
                >
                <div class="textarea-wrapper">
                  <textarea
                    name="message"
                    rows="5"
                    required
                    class="contact-input"
                    placeholder="Décrivez votre projet, vos objectifs, votre timeline..."
                  ></textarea>
                  <span class="resize-hint" data-fr="↕ Glissez pour agrandir" data-en="↕ Drag to resize">↕ Glissez pour agrandir</span>
                </div>
              </div>
              <div>
                <button
                  type="submit"
                  class="px-8 py-3 text-sm font-medium transition-all"
                  style="background: var(--fg); color: var(--bg);"
                  onmouseover="this.style.opacity='0.85'"
                  onmouseout="this.style.opacity='1'"
                >
                  <span data-fr="Envoyer le message →" data-en="Send message →">Envoyer le message →</span>
                </button>
              </div>
            </form>
            <div
              id="contact-success"
              class="hidden mt-6 p-6"
              style="border: 1px solid var(--border);"
            >
              <p class="text-sm font-medium" style="color: var(--fg);">
                <span data-fr="Message envoyé!" data-en="Message sent!">Message envoyé!</span>
              </p>
              <p class="mt-2 text-xs" style="color: var(--fg-secondary);">
                <span data-fr="Nous vous répondrons dans les plus brefs délais." data-en="We'll get back to you as soon as possible.">Nous vous répondrons dans les plus brefs délais.</span>
              </p>
            </div>
          </div>

          <!-- Right: Info -->
          <div class="min-w-0 col-span-12 lg:col-span-5">
            <div class="space-y-8">
              <div>
                <span class="label block"><span data-fr="Email direct" data-en="Direct email">Email direct</span></span>
                <a
                  href={`mailto:${profile.email}`}
                  class="mt-3 block text-sm sm:text-base font-medium no-underline transition-colors duration-200 break-all"
                  style="color: var(--fg);"
                  onmouseover="this.style.color='var(--fg-secondary)'"
                  onmouseout="this.style.color='var(--fg)'"
                >
                  {profile.email}
                </a>
              </div>
              <div>
                <span class="label"><span data-fr="Localisation" data-en="Location">Localisation</span></span>
                <p class="mt-3 text-sm" style="color: var(--fg-secondary);">
                  {profile.location}
                </p>
              </div>
              <div>
                <span class="label"><span data-fr="Disponibilité" data-en="Availability">Disponibilité</span></span>
                <p class="mt-3 text-sm" style="color: var(--fg-secondary);">
                  {profile.availability}
                </p>
              </div>
              <div>
                <span class="label"><span data-fr="Réseaux" data-en="Socials">Réseaux</span></span>
                <div class="mt-3 flex gap-3">
                  {
                    Object.entries(socials).map(([name, url]) => (
                      <a
                        href={url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-10 h-10 flex items-center justify-center transition-colors duration-200 no-underline text-xs font-mono uppercase"
                        style="color: var(--fg-muted); border: 1px solid var(--border);"
                        onmouseover="this.style.color='var(--fg)'; this.style.borderColor='var(--border-hover)'"
                        onmouseout="this.style.color='var(--fg-muted)'; this.style.borderColor='var(--border)'"
                      >
                        {name[0].toUpperCase()}
                      </a>
                    ))
                  }
                </div>
              </div>
              <div
                class="p-6"
                style="border: 1px solid var(--border); background: var(--bg-raised);"
              >
                <p
                  class="text-xs leading-relaxed"
                  style="color: var(--fg-secondary);"
                >
                  <span data-fr="Réponse sous 24h ouvrées. Pour les projets urgents, mentionnez-le dans votre message." data-en="Response within 24 business hours. For urgent projects, mention it in your message.">Réponse sous 24h ouvrées. Pour les projets urgents, mentionnez-le dans votre message.</span>
                </p>
              </div>
            </div>
          </div>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
  <ScrollReveal />
</Layout>

<style>
  /* ── Hero grid background ── */
  .contact-hero {
    position: relative;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 60px 60px;
    background-position: center center;
    background-blend-mode: overlay;
  }
  .contact-hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120px;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  /* ── Hero layout ── */
  .contact-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    .contact-hero-inner {
      flex-direction: row;
      align-items: center;
      gap: 3rem;
    }
  }

  .contact-hero-text {
    flex: 1;
    min-width: 0;
  }

  .contact-hero-anim {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .process-svg {
    width: 100%;
    max-width: 480px;
    height: auto;
    overflow: visible;
  }
  @media (max-width: 1023px) {
    .process-svg {
      max-width: 100%;
    }
  }

  /* ── Form inputs ── */
  .contact-input {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 0.625rem 0.75rem;
    font-size: 0.875rem;
    font-family: var(--font-body);
    background: var(--bg-raised);
    color: var(--fg);
    border: 1px solid var(--border-strong);
    outline: none;
    transition: border-color 0.2s;
    -webkit-appearance: none;
    border-radius: 0;
  }
  .contact-input:focus { border-color: var(--fg); }
  .contact-input::placeholder { color: var(--fg-muted); }
  select.contact-input { cursor: pointer; }

  .textarea-wrapper { position: relative; }
  textarea.contact-input {
    resize: vertical;
    min-height: 100px;
    max-height: 400px;
    padding-bottom: 1.5rem;
  }
  .resize-hint {
    position: absolute;
    bottom: 6px;
    right: 8px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--fg-muted);
    opacity: 0.4;
    pointer-events: none;
    transition: opacity 0.2s;
  }
  textarea.contact-input:focus ~ .resize-hint { opacity: 0.6; }

  /* ── Process animation (looping 3s) ── */
  .anim-step {
    opacity: 0;
    transform-origin: center;
  }
  .anim-arrow { opacity: 0; }
  .anim-check {
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
  }
  .anim-sparkle { opacity: 0; }
  .anim-glow { opacity: 0; }
  .anim-progress {
    stroke-dasharray: 296;
    stroke-dashoffset: 296;
  }

  /* Animation cycle: 3s total, then restart */
  .anim-step { animation: step-in 0.4s ease forwards, step-out 0.3s ease 2.7s forwards; }
  .as1 { animation-delay: 0s, 2.7s; }
  .as2 { animation-delay: 0.3s, 2.7s; }
  .as3 { animation-delay: 0.6s, 2.7s; }
  .as4 { animation-delay: 0.9s, 2.7s; }

  .anim-arrow { animation: arrow-in 0.2s ease forwards, arrow-out 0.2s ease 2.8s forwards; }
  .aa1 { animation-delay: 0.2s, 2.8s; }
  .aa2 { animation-delay: 0.5s, 2.8s; }
  .aa3 { animation-delay: 0.8s, 2.8s; }

  .anim-check { animation: check-draw 0.5s ease 1.2s forwards, check-erase 0.3s ease 2.7s forwards; }

  .anim-sparkle { animation: sparkle-in 0.3s ease 1.5s forwards, sparkle-out 0.2s ease 2.8s forwards; }
  .aspk2 { animation-delay: 1.7s, 2.8s; }

  .anim-glow { animation: glow-in 0.5s ease 0.3s forwards, glow-out 0.5s ease 2.7s forwards; }

  .anim-progress { animation: progress-fill 2s ease 0.3s forwards, progress-erase 0.5s ease 2.7s forwards; }

  @keyframes step-in {
    from { opacity: 0; transform: translateY(12px) scale(0.9); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes step-out {
    from { opacity: 1; transform: translateY(0) scale(1); }
    to { opacity: 0; transform: translateY(-8px) scale(0.95); }
  }

  @keyframes arrow-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes arrow-out { from { opacity: 1; } to { opacity: 0; } }

  @keyframes check-draw { to { stroke-dashoffset: 0; } }
  @keyframes check-erase { to { stroke-dashoffset: 40; } }

  @keyframes sparkle-in { from { opacity: 0; transform: scale(0); } 60% { transform: scale(1.3); } to { opacity: 1; transform: scale(1); } }
  @keyframes sparkle-out { from { opacity: 1; } to { opacity: 0; } }

  @keyframes glow-in { from { opacity: 0; } to { opacity: 0.03; } }
  @keyframes glow-out { from { opacity: 0.03; } to { opacity: 0; } }

  @keyframes progress-fill { to { stroke-dashoffset: 0; } }
  @keyframes progress-erase { to { stroke-dashoffset: 296; } }

  @media (prefers-reduced-motion: reduce) {
    .anim-step, .anim-arrow, .anim-check, .anim-sparkle, .anim-glow, .anim-progress {
      animation: none !important;
    }
    .anim-step { opacity: 1; }
    .anim-arrow { opacity: 1; }
    .anim-check { stroke-dashoffset: 0; }
    .anim-sparkle { opacity: 1; }
    .anim-glow { opacity: 0.03; }
    .anim-progress { stroke-dashoffset: 0; }
  }
</style>

<script>
  function initContact() {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const success = document.getElementById("contact-success");
    if (!form) return;

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      form.classList.add("hidden");
      success?.classList.remove("hidden");
    });

    // Loop animation every 3s
    const svg = document.getElementById("process-svg");
    if (svg) {
      setInterval(() => {
        // Clone and replace all animated elements to restart
        svg.querySelectorAll('.anim-step, .anim-arrow, .anim-check, .anim-sparkle, .anim-glow, .anim-progress').forEach(el => {
          const clone = el.cloneNode(true);
          el.parentNode?.replaceChild(clone, el);
        });
      }, 3000);
    }
  }
  document.readyState === "loading"
    ? document.addEventListener("DOMContentLoaded", initContact)
    : initContact();
</script>
</Layout>
